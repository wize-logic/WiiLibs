+++ b/tools/recomp/test_stack_frames.py
@@ -0,0 +1,204 @@
+"""
+--stack-icall, --stack-align and --stack-alloca for --stack-locals
+(stack_locals.Frames, stack_locals.alloca_probes).
+
+Without them the walk loses esp after an indirect call that the caller does
+not clean up after, after `and esp, -2^k` and after a call to the alloca
+probe, and the function keeps every slot in memory. These checks lift small
+x86 functions (test_preserve's harness), look at the reasons and the text,
+and compile and run each case both ways (test_stack_locals' harness, with
+the indirect calls dispatched by address).
+"""
+
+import os
+import shutil
+import struct
+import sys
+import tempfile
+
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import preserve  # noqa: E402
+from tools.recomp.stack_locals import (localise_stack, ret_deltas, arg_windows, alloca_probes,  # noqa: E402
+                                       Frames)
+from tools.recomp.test_preserve import _lift, BASE  # noqa: E402
+from tools.recomp.test_stack_locals import _compile_run  # noqa: E402
+
+
+def _h(s):
+    return bytes.fromhex(s.replace(" ", ""))
+
+
+RET, RET_4 = _h("C3"), _h("C20400")
+# the alloca probe: test eax,eax; je ret; neg eax; add eax,esp; add eax,4; xchg eax,esp; mov eax,[eax]; push eax; ret
+PROBE = [_h("85C0 740B F7D8 03C4 83C004 94 8B00 50 C3")]
+# the same without its `add eax, 4`: esp would not move by eax
+NOT_PROBE = [_h("85C0 7408 F7D8 03C4 94 8B00 50 C3")]
+PUSH_EBP, MOV_EBP_ESP, POP_EBP, MOV_ESP_EBP = _h("55"), _h("8BEC"), _h("5D"), _h("8BE5")
+AND_ESP_8 = _h("83E4F8")          # and esp, -8
+MOV_EAX_20 = _h("B820000000")     # mov eax, 0x20
+ST_8_ECX = _h("894C2408")         # mov [esp+8], ecx
+LD_EAX_8 = _h("8B442408")         # mov eax, [esp+8]
+ADD_8_EDX = _h("01542408")        # add [esp+8], edx
+LD_EDX_ARG = _h("8B5508")         # mov edx, [ebp+8]: the argument, from the entry's base
+ST_EBPM4_EDX = _h("8955FC")       # mov [ebp-4], edx: between the aligned esp and the entry's frame
+SUB_ESP_8, ADD_ESP_8, ADD_ESP_C = _h("83EC08"), _h("83C408"), _h("83C40C")
+ST_4_ECX = _h("894C2404")         # mov [esp+4], ecx
+LD_EDX_4 = _h("8B542404")         # mov edx, [esp+4]
+ADD_4_EDX = _h("01542404")        # add [esp+4], edx
+PUSH_EAX, CALL_EAX = _h("50"), _h("FFD0")
+
+
+def _call(i):
+    return ("call", i)
+
+
+def _mov_eax_fn(i):
+    return ("fn", i)
+
+
+def _resolve(funcs):
+    """funcs with each ("fn", i) part made `mov eax, <function i's address>`."""
+    sizes = [sum(5 if isinstance(p, tuple) else len(p) for p in f) for f in funcs]
+    starts = [BASE + sum(sizes[:i]) for i in range(len(funcs))]
+    return [[b"\xB8" + struct.pack("<I", starts[p[1]]) if isinstance(p, tuple) and p[0] == "fn" else p
+             for p in f] for f in funcs]
+
+
+def _run_pass(funcs, frames):
+    t, pend, names = _lift(_resolve(funcs))
+    lines = {names[i]: p.lines for i, p in pend.items()}
+    s = preserve.analyse(lines)
+    kept = preserve.preserved_by_name(s)
+    deltas = ret_deltas(lines, exact=True)
+    if frames == "all":
+        frames = Frames(True, True, alloca_probes(lines))
+    windows = arg_windows(lines, s, kept, deltas, carry=True, frames=frames)
+    out = {n: localise_stack(pend[i].lines, s, kept, deltas, windows=windows, carry=True, frames=frames)
+           for i, n in enumerate(names)}
+    return pend, names, out
+
+
+def _body(lines):
+    return "\n".join(lines)
+
+
+# ------------------------------------------------------------ the alloca probe
+
+def test_the_alloca_probe_is_found_by_its_body():
+    _, pend, names = _lift([PROBE, NOT_PROBE, [RET]])
+    lines = {names[i]: p.lines for i, p in pend.items()}
+    assert alloca_probes(lines) == {names[0]}
+
+
+# an aligned frame with an alloca'd part: push ebp; mov ebp,esp; and esp,-8; mov eax,0x20; call probe;
+# a slot spilled and read below the aligned esp; the argument read through ebp
+ALIGNED = [PUSH_EBP, MOV_EBP_ESP, AND_ESP_8, MOV_EAX_20, _call(1), ST_8_ECX, LD_EAX_8, ADD_8_EDX, LD_EAX_8,
+           LD_EDX_ARG, MOV_ESP_EBP, POP_EBP, RET]
+
+
+def test_an_aligned_frame_keeps_its_slots_with_align_and_alloca():
+    _, names, out = _run_pass([ALIGNED, PROBE], Frames())
+    assert out[names[0]][1] is not None
+    _, names, out = _run_pass([ALIGNED, PROBE], "all")
+    lines, why, n_slots, _ = out[names[0]]
+    assert why is None and n_slots == 1, why
+    text = _body(lines)
+    assert "/* from memory at the aligned esp */" in text, text
+    assert "from memory at the entry" not in text, text  # no slot of the entry's is kept after the and
+    assert "MEM32(ebp + 8)" in text, text                 # the argument stays in memory
+
+
+def test_an_aligned_frame_without_the_probe_option_loses_esp_at_the_call():
+    _, names, out = _run_pass([ALIGNED, PROBE], Frames(align=True))
+    assert out[names[0]][1] is not None
+
+
+def test_an_access_between_the_aligned_esp_and_the_entrys_frame_declines():
+    f = [PUSH_EBP, MOV_EBP_ESP, AND_ESP_8, MOV_EAX_20, _call(1), ST_8_ECX, LD_EAX_8, ADD_8_EDX, LD_EAX_8,
+         ST_EBPM4_EDX, MOV_ESP_EBP, POP_EBP, RET]
+    _, names, out = _run_pass([f, PROBE], "all")
+    assert out[names[0]][1] == "an access between an aligned frame and its entry's", out[names[0]][1]
+
+
+# ------------------------------------------------------------ indirect calls
+
+# sub esp,8; mov [esp+4],ecx; push eax; mov eax,f; call eax (f: ret 4); the slot read and changed after
+ICALLER = [SUB_ESP_8, ST_4_ECX, PUSH_EAX, _mov_eax_fn(1), CALL_EAX, LD_EDX_4, ADD_4_EDX, LD_EDX_4, ADD_ESP_8, RET]
+STDCALL = [RET_4]
+# a callee cleaning its argument that reads, rewrites and reads it: mov eax,[esp+4]; mov [esp+4],edx; ret 4
+STDCALL_RW = [_h("8B442404"), _h("89542404"), _h("8B4C2404"), RET_4]
+
+
+def test_an_indirect_callee_cleaning_its_arguments_keeps_the_callers_slots():
+    _, names, out = _run_pass([ICALLER, STDCALL], Frames())
+    assert out[names[0]][1] == "an access at esp + K where esp is not known", out[names[0]][1]
+    _, names, out = _run_pass([ICALLER, STDCALL], Frames(icall=True))
+    lines, why, n_slots, _ = out[names[0]]
+    assert why is None and n_slots == 1, why
+    text = _body(lines)
+    # the callee cleans 4 bytes of arguments: it reaches its return address and them, not the slot
+    assert "to memory */" not in text and "/* and back */" not in text, text
+
+
+def test_a_return_that_does_not_bear_the_hypothesis_out_walks_again_without():
+    # the same, but the caller cleans the argument later (add esp, 0xC): at the ret esp is 4 too high
+    # on the hypothesis, so the function is walked again without it
+    f = [SUB_ESP_8, ST_4_ECX, PUSH_EAX, _mov_eax_fn(1), CALL_EAX, LD_EDX_4, ADD_4_EDX, LD_EDX_4, ADD_ESP_C, RET]
+    _, names, out = _run_pass([f, [RET]], Frames(icall=True))
+    assert out[names[0]][1] == "an access at esp + K where esp is not known", out[names[0]][1]
+
+
+def test_esp_set_from_ebp_after_the_hypothesis_walks_again_without():
+    # push ebp; mov ebp,esp; sub esp,8; ... call eax; ...; mov esp,ebp; pop ebp; ret: not checked at a ret
+    f = [PUSH_EBP, MOV_EBP_ESP, SUB_ESP_8, ST_4_ECX, PUSH_EAX, _mov_eax_fn(1), CALL_EAX, LD_EDX_4, ADD_4_EDX,
+         LD_EDX_4, MOV_ESP_EBP, POP_EBP, RET]
+    _, names, out = _run_pass([f, STDCALL], Frames(icall=True))
+    assert out[names[0]][1] is not None
+
+
+# ------------------------------------------------------------ run both ways
+
+ICALL_HARNESS = r"""
+#define RECOMP_ICALL_SAFE_AT(va, saved, site) recomp_test_icall(va)
+#define RECOMP_ICALL_SAFE(va, saved) recomp_test_icall(va)
+static void recomp_test_icall(uint32_t va);
+"""
+
+CASES = [
+    [ALIGNED, PROBE],
+    [ICALLER, STDCALL],
+    [ICALLER, STDCALL_RW],
+    # an alloca'd frame's slot across two calls, one of them indirect (mov eax,0x20; call probe; ...;
+    # add esp,0x20; ret)
+    [[MOV_EAX_20, _call(1), ST_8_ECX, PUSH_EAX, _mov_eax_fn(2), CALL_EAX, ADD_8_EDX, LD_EAX_8, ADD_8_EDX,
+      LD_EAX_8, _h("83C420"), RET], PROBE, STDCALL],
+]
+
+
+@pytest.mark.parametrize("funcs", CASES)
+def test_the_frames_compute_what_the_memory_model_computes(funcs):
+    if not (shutil.which("gcc") or shutil.which("clang")):
+        pytest.skip("C compiler unavailable")
+    pend, names, out = _run_pass(funcs, "all")
+    assert out[names[0]][1] is None, out[names[0]][1]
+    protos = ICALL_HARNESS + "".join("static void %s(void);\n" % n for n in names)
+    disp = "static void recomp_test_icall(uint32_t va) {\n%s}\n" % "".join(
+        "    if (va == 0x%sU) { %s(); return; }\n" % (n[4:], n) for n in names)
+    plain = protos + "\n".join(_body(p.lines) for p in pend.values()) + disp
+    done = protos + "\n".join(_body(out[n][0]) for n in names) + disp
+    with tempfile.TemporaryDirectory() as tmp:
+        a = _compile_run(plain, names[0], tmp, "plain")
+        b = _compile_run(done, names[0], tmp, "frames")
+    assert a == b, (a, b)
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_") and name != "test_the_frames_compute_what_the_memory_model_computes":
+            fn()
+    for c in CASES:
+        test_the_frames_compute_what_the_memory_model_computes(c)
+    print("ok")
