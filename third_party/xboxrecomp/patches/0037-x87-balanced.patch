@@ -564,6 +572,87 @@ def localise_x87(lines, macros, undefs, x87=True, regs=False, kept=None, touched
         return lines, str(e)
 
 
+_SUB = re.compile(r"\bsub_[0-9A-Fa-f]{8}\w*\b")
+
+
+def x87_balanced(lines, call_ok):
+    """Whether one function as translate_function emits it leaves the x87
+    stack as deep as it found it on every return, and never reads or writes a
+    slot that was on the stack when it was entered: its own pushes are the
+    only slots it names, and it pops no more than it pushed. call_ok(name)
+    says whether a call to a generated function keeps those two promises too
+    (it leaves the x87 stack alone, or is balanced in turn).
+
+    The depth is followed statically through the body's C text, as the pass
+    above follows it: a statement this pass cannot rewrite at a static depth,
+    a push or pop that may not happen, paths that join at different depths,
+    or a call to anything call_ok does not accept make the answer False."""
+    bounds = _function_bounds(lines)
+    if bounds is None:
+        return False
+    lo, hi = bounds
+    if re.search(r"setjmp|longjmp", "\n".join(lines[lo:hi])):
+        return False  # a jump back into the body, at whatever depth the stack has then
+    try:
+        nodes = _nodes(lines, lo, hi)
+    except _NotLocal:
+        return False
+    labels = {n.label: x for x, n in enumerate(nodes) if n.kind == "label"}
+    if any(g not in labels for n in nodes for g in n.gotos):
+        return False
+
+    def step(code, k):
+        """The depth after one line of code at depth k, or None."""
+        if not _LEFTOVER.search(code):
+            return k
+        r = _rewrite(code, k, x87=True, regs=False)
+        if r is None:
+            return None
+        _, k_out, wr, rd = r[:4]
+        if k_out < 0 or any(p >= 0 for p in wr | rd):
+            return None  # a slot of the caller's
+        return k_out
+
+    depth = [None] * len(nodes)
+    if nodes:
+        depth[0] = 0
+    work = [0] if nodes else []
+    while work:
+        x = work.pop()
+        n, k = nodes[x], depth[x]
+        if n.kind in ("label", "pp"):
+            out = k
+        else:
+            names = set(_SUB.findall(n.code))
+            if names and (not all(call_ok(c) for c in names) or _LEFTOVER.search(n.code)):
+                return False  # a call to code that may move the stack, or one beside x87 code
+            if n.kind == "region":
+                out = k
+                for li in range(n.first, n.last + 1):
+                    if step(_protect(lines[li])[0], k) != k:
+                        return False  # a push or pop inside a conditional block
+            else:
+                out = step(n.code, k)
+                if out is None:
+                    return False
+            if re.search(r"\breturn\b", n.code) and out != 0:
+                return False
+        succ = [labels[g] for g in n.gotos] if n.kind != "label" else []
+        if not n.terminal:
+            succ.append(x + 1)
+        for y in succ:
+            if y >= len(nodes):
+                if out != 0:
+                    return False  # the fall-through out of the body
+                continue
+            if depth[y] is None:
+                depth[y] = out
+                work.append(y)
+            elif depth[y] != out:
+                return False
+    return True
+
+
