+def arg_windows(functions, summaries=None, kept=None, deltas=None, carry=False):
+    """{name: how many bytes above its entry esp the function may read or
+    write} -- its return address and the stack arguments its own accesses
+    name -- for each function the walk follows to the end, that is given no
+    address in its arguments' part of the frame to pass on, reads no frame
+    through an inherited ebp and leaves by no tail jump. A caller whose call
+    gives it no frame address then knows the callee cannot reach the slots
+    above that: they stay in their locals across the call."""
+    out = {}
+    for name, lines in functions.items():
+        if any(_TAIL.search(line) for line in lines):
