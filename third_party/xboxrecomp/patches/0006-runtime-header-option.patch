diff --git a/tools/recomp/test_runtime_header_option.py b/tools/recomp/test_runtime_header_option.py
new file mode 100644
index 0000000..9742196
--- /dev/null
+++ b/tools/recomp/test_runtime_header_option.py
@@ -0,0 +1,64 @@
+"""--split's recomp_types.h can be the template, another file, or none.
+
+The chunks include recomp_funcs.h, which includes "recomp_types.h", and a
+quoted include searches the including file's own directory before any -I. So
+a runtime with its own register model (a big-endian host whose MEM* macros
+byte-swap, for one) could not put its header "earlier on the include path":
+the copy in gen/ always won, and the only way round it was editing generated
+output after every run.
+"""
+
+import os
+import pathlib
+import tempfile
+
+from tools.recomp.lifter import Lifter
+from tools.recomp.translator import BatchTranslator
+
+_TEMPLATE = (pathlib.Path(__file__).resolve().parents[2] / "templates" /
+             "runtime" / "recomp_types.h")
+
+
+class _FakeTranslator:
+    def __init__(self):
+        self.owned_function_starts = set()
+        self.lifter = Lifter()
+
+    def translate_function(self, addr, func_info):
+        return f"void {func_info['name']}(void) {{}}"
+
+
+def _split(output_dir, **kw):
+    batch = BatchTranslator.__new__(BatchTranslator)
+    batch.translator = _FakeTranslator()
+    batch.translate_batch_split([(0x00011000, {"name": "sub_00011000"})],
+                                output_dir, **kw)
+    return os.path.join(output_dir, "recomp_types.h")
+
+
+def test_default_copies_the_template():
+    with tempfile.TemporaryDirectory() as out:
+        path = _split(out)
+        with open(path, encoding="utf-8") as f:
+            assert f.read() == _TEMPLATE.read_text(encoding="utf-8")
+
+
+def test_a_path_is_copied_instead():
+    with tempfile.TemporaryDirectory() as out:
+        mine = os.path.join(out, "mine.h")
+        with open(mine, "w", encoding="utf-8") as f:
+            f.write("/* my runtime */\n")
+        path = _split(os.path.join(out, "gen"), runtime_header=mine)
+        with open(path, encoding="utf-8") as f:
+            assert f.read() == "/* my runtime */\n"
+
+
+def test_none_writes_nothing_and_removes_a_stale_copy():
+    with tempfile.TemporaryDirectory() as out:
+        path = _split(out)
+        assert os.path.exists(path)
+        _split(out, runtime_header="none")
+        assert not os.path.exists(path)
+        # the rest of the output is still there
+        assert os.path.exists(os.path.join(out, "recomp_funcs.h"))
+        assert os.path.exists(os.path.join(out, "recomp_dispatch.c"))
diff --git a/tools/recomp/translator.py b/tools/recomp/translator.py
index 6a7f44c..94e8f5b 100644
--- a/tools/recomp/translator.py
+++ b/tools/recomp/translator.py
@@ -3268,7 +3268,8 @@ class BatchTranslator:
 
     def translate_batch_split(self, func_list, output_dir, chunk_size=1000,
                               header_name="recomp_funcs.h",
-                              prefix="recomp", verbose=False, manual=None):
+                              prefix="recomp", verbose=False, manual=None,
+                              runtime_header="template"):
         """
         Translate functions into multiple .c files + a shared header.
 
@@ -3285,6 +3286,12 @@ class BatchTranslator:
         is how a game replaces a recompiled XDK routine (a D3D8 entry point,
         say) with one that drives the host runtime instead of the hardware.
 
+        runtime_header: what goes into output_dir/recomp_types.h. "template"
+        (the default) copies templates/runtime/recomp_types.h; a path copies
+        that file instead; "none" writes nothing and removes a copy an
+        earlier run left, so the generated code finds the project's own
+        header on the include path.
+
         Returns dict with stats and list of generated files.
         """
         import sys
@@ -3430,26 +3437,43 @@ class BatchTranslator:
         # So it tracks the template, like the .c files do. A project that
         # genuinely needs its own can put one earlier on the include path --
         # gen/ is only found because recomp_funcs.h sits beside it.
+        #
+        # A runtime with its own register model -- a big-endian host, say,
+        # whose MEM* macros byte-swap -- cannot use "put one earlier on the
+        # include path": the chunks include recomp_funcs.h, which includes
+        # "recomp_types.h", and a quoted include looks in the including
+        # file's own directory before any -I. So runtime_header can name a
+        # different file to copy, or "none" to leave gen/ without one (and
+        # remove a stale copy) so the include path decides.
         types_dst = os.path.join(output_dir, "recomp_types.h")
         types_src = os.path.join(os.path.dirname(__file__), "..", "..",
                                  "templates", "runtime", "recomp_types.h")
-        try:
-            with open(types_src, "r", encoding="utf-8") as src:
-                want = src.read()
-            have = None
+        if runtime_header == "none":
+            types_src = None
             if os.path.exists(types_dst):
-                with open(types_dst, "r", encoding="utf-8") as dst:
-                    have = dst.read()
-            if have != want:
-                with open(types_dst, "w", encoding="utf-8") as dst:
-                    dst.write(want)
-                print("  %s recomp_types.h (runtime register model)"
-                      % ("refreshed" if have is not None else "wrote"),
+                os.remove(types_dst)
+                print("  removed recomp_types.h (the build supplies its own)",
                       file=sys.stderr)
-        except OSError as e:
-            print(f"  WARNING: could not write recomp_types.h ({e}); copy "
-                  f"it from templates/runtime/ by hand or the build will "
-                  f"not find it", file=sys.stderr)
+        elif runtime_header and runtime_header != "template":
+            types_src = runtime_header
+        if types_src is not None:
+            try:
+                with open(types_src, "r", encoding="utf-8") as src:
+                    want = src.read()
+                have = None
+                if os.path.exists(types_dst):
+                    with open(types_dst, "r", encoding="utf-8") as dst:
+                        have = dst.read()
+                if have != want:
+                    with open(types_dst, "w", encoding="utf-8") as dst:
+                        dst.write(want)
+                    print("  %s recomp_types.h (runtime register model)"
+                          % ("refreshed" if have is not None else "wrote"),
+                          file=sys.stderr)
+            except OSError as e:
+                print(f"  WARNING: could not write recomp_types.h ({e}); copy "
+                      f"it from templates/runtime/ by hand or the build will "
+                      f"not find it", file=sys.stderr)
 
         # Split translations into chunks and write .c files
         generated_files = [header_path]
