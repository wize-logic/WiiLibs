diff --git a/tools/recomp/mem_disp.py b/tools/recomp/mem_disp.py
new file mode 100644
index 0000000..2d89a00
--- /dev/null
+++ b/tools/recomp/mem_disp.py
@@ -0,0 +1,79 @@
+"""--mem-disp: a guest access's small constant displacement as its own operand.
+
+The lifter writes a memory operand as one address expression, the
+displacement last (`MEM32(esp + 0x10)`, `MEMF(esi + eax * 4 - 0x8)`). A
+runtime whose guest-to-host address map is not a plain addition (a
+PowerPC host that folds the Xbox's 0x80000000 window next to user space,
+say) has to map every such address on its own, so `[esi + 4]` and
+`[esi + 8]` cost the whole map twice and the compiler cannot share it.
+
+This pass rewrites `MEMxx(base + disp)` into `MEMxx_D(base, disp)` when
+disp is a constant in [-0x8000, 0x8000): the runtime header maps base once
+and adds disp on the host side (recomp_types.h defines MEMxx_D as
+MEMxx(base + disp), the same access, for a runtime that does not care). A
+small displacement from a base the guest dereferences stays in the base's
+region for every valid address, so the two are the same access wherever
+the guest's own access would be valid. A larger displacement (a global
+table indexed by a register, `[eax * 4 + 0x80123456]`) keeps the old form.
+"""
+
+import re
+
+_NAMES = ("MEM8", "MEM16", "MEM32", "SMEM8", "SMEM16", "SMEM32", "SMEM64", "MEMF", "MEMD")
+_CALL = re.compile(r"\b(" + "|".join(_NAMES) + r")\(")
+_TAIL = re.compile(r"^(?P<base>.*\S)\s*(?P<op>[+-])\s*(?P<disp>0x[0-9A-Fa-f]+|\d+)u?$", re.S)
+LIMIT = 0x8000
+
+
+def _split(arg):
+    """(base, signed disp) for `base + disp` / `base - disp` at the top level, or None."""
+    m = _TAIL.match(arg)
+    if not m:
+        return None
+    base = m.group("base")
+    if base.endswith("+") and m.group("op") == "-":  # _fmt_mem's `ebp + - 0x4`
+        base = base[:-1].rstrip()
+    if base.endswith(("+", "-", "~", "!")):
+        return None
+    depth = 0
+    for c in base:  # the base must be a sum of terms: balanced, and at its top level no operator
+        depth += (c == "(") - (c == ")")  # that binds less tightly than + (a << 2 + 4 is a << 6)
+        if depth < 0 or (depth == 0 and c in ",?:<>&|^=!"):
+            return None
+    if depth != 0 or base.rstrip().endswith(("*", "/", "<<", ">>", "&", "|", "^", "(")):
+        return None
+    disp = int(m.group("disp"), 0)
+    disp = -disp if m.group("op") == "-" else disp
+    if not -LIMIT <= disp < LIMIT or disp == 0:
+        return None
+    return base, disp
+
+
+def rewrite(text):
+    """The function's text with every eligible access split; (text, accesses split)."""
+    out, i, hits = [], 0, 0
+    while True:
+        m = _CALL.search(text, i)
+        if not m:
+            out.append(text[i:])
+            break
+        out.append(text[i:m.start()])
+        j, depth = m.end(), 1
+        while depth and j < len(text):
+            depth += (text[j] == "(") - (text[j] == ")")
+            j += 1
+        if depth:
+            out.append(text[m.start():])
+            break
+        inner, n = rewrite(text[m.end():j - 1])  # accesses inside the address
+        hits += n
+        parts = _split(inner)
+        if parts:
+            base, disp = parts
+            sign = "-" if disp < 0 else ""
+            out.append(f"{m.group(1)}_D({base}, {sign}0x{abs(disp):X})")
+            hits += 1
+        else:
+            out.append(f"{m.group(1)}({inner})")
+        i = j
+    return "".join(out), hits
diff --git a/tools/recomp/test_mem_disp.py b/tools/recomp/test_mem_disp.py
new file mode 100644
index 0000000..2b329a6
--- /dev/null
+++ b/tools/recomp/test_mem_disp.py
@@ -0,0 +1,49 @@
+"""
+--mem-disp: MEMxx(base + disp) written as MEMxx_D(base, disp).
+
+A runtime whose guest-to-host address map is not a plain addition maps
+base once for all the accesses through it; disp must be a small constant
+and base a whole sum of terms, or the access keeps its old form.
+"""
+
+from tools.recomp.mem_disp import rewrite
+
+
+def check(src, want, hits):
+    got, n = rewrite(src)
+    assert got == want, (src, got)
+    assert n == hits, (src, n)
+
+
+def test_register_bases():
+    check("MEM32(_r_esp + 0x108) = MEM32(_r_esi + _r_eax * 4 + 0x14);",
+          "MEM32_D(_r_esp, 0x108) = MEM32_D(_r_esi + _r_eax * 4, 0x14);", 2)
+    check("MEMF(ebp - 0x10)", "MEMF_D(ebp, -0x10)", 1)
+    check("SMEM32(ebp + - 0x4)", "SMEM32_D(ebp, -0x4)", 1)  # _fmt_mem's negative displacement
+    check("MEM32(a - - 4)", "MEM32(a - - 4)", 0)
+    check("x = SMEM16(ecx + 2);", "x = SMEM16_D(ecx, 0x2);", 1)
+
+
+def test_nested_and_parenthesised():
+    check("MEM16(MEM32(a + 8) + 2)", "MEM16_D(MEM32_D(a, 0x8), 0x2)", 2)
+    check("MEMD((a + 0x10) + 4)", "MEMD_D((a + 0x10), 0x4)", 1)
+
+
+def test_left_alone():
+    for src in ("MEM32(0x1234)",                 # a constant address folds anyway
+                "MEM32(eax * 4 + 0x80123456)",   # a table: the displacement is the pointer
+                "MEM32(eax + 0x8000)",           # past the small range
+                "MEM8(a + 0)",
+                "MEM32(x << 2 + 4)",             # + binds tighter than <<
+                "MEM32(a ? b : c + 4)",
+                "MEM32(eax)",
+                "XMEM32(a + 4)"):
+        check(src, src, 0)
+    check("MEM32(eax - 0x8000)", "MEM32_D(eax, -0x8000)", 1)
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_"):
+            fn()
+    print("ok")
