From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Wed, 14 Oct 2026 22:00:00 -0400
Subject: [PATCH] recomp: the transcendentals keep a static stack depth

Upstream (999a8c6) lifts fsin, fcos, fsincos and fptan with the hardware's range
test: for |st0| >= 2^63 they leave st0 alone, push nothing and set C2.
That makes the push of fptan and fsincos conditional, and the x87 locals
pass (--x87-locals) gives up on a function whose stack depth is not
static: three of Halo's functions went back to the memory model and
grew by half (19 KB between them), slower too. The range test also
writes g_fp_cc inside recomp_fp_trig_in_range, out of the pass's sight;
here the lifted code clears C2 itself.

libm reduces any argument exactly, so the range test buys nothing: every
argument is computed, the stack moves as for one in range, and C2 is
cleared. A caller that tests C2 (the CRT's reduce-and-retry) goes on with
the right value at once. fptan's push of 1.0 (a NaN for a NaN or an
infinity) is written 1.0 + (t - t): the pass also reads a ?: on a line
that pushes as a push that may not happen. Beyond 2^63 that differs from the hardware,
which leaves the reduction to the caller; the conformance case
fpu_trig_out_of_range records it.

Tests: test_x87_trig_depth.py checks the four forms clear C2, branch on
nothing and are taken by the x87 locals pass; the fpu_*_c2 cases keep their in-range, NaN and infinite inputs.
---
 tools/conformance/cases.py              | 18 ++++++++----
 tools/recomp/lifter.py                  | 32 ++++++++++++++-------
 tools/recomp/test_lifter_fpu_reverse.py |  9 +++---
 tools/recomp/test_x87_trig_depth.py     | 37 +++++++++++++++++++++++++
 4 files changed, 76 insertions(+), 20 deletions(-)
 create mode 100644 tools/recomp/test_x87_trig_depth.py

diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
index 00673ef..983e365 100644
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -669,8 +669,10 @@ _FPREM = [(100.0, 7.0), (-100.0, 7.0), (100.0, -7.0), (7.0, 100.0),
           (-3.25, 0.5), (2.5, 2.0), (-2.5, 2.0), (5.5, 2.0), (1e10, 3.0),
           (17.0, 3.0), (-17.0, -3.0), (0.0, 1.0), (-0.0, 1.0), (6.5, 1.0),
           (7.5, 1.0), (-7.5, 1.0), (1e15, 0.1), (3.0, 3.0), (29.0, 4.0)]
-_TRIG = [(0.5, 0.0), (-2.0, 0.0), (3.0, 0.0), (1e19, 0.0), (-1e300, 0.0),
-         (float("inf"), 0.0), (float("nan"), 0.0)]
+# In range (|x| < 2^63), and NaN and the infinities. Beyond 2^63 the hardware
+# leaves st0 and sets C2; the lift computes the exact result with libm and
+# clears C2 (fpu_trig_out_of_range, listed as an expected difference).
+_TRIG = [(0.5, 0.0), (-2.0, 0.0), (3.0, 0.0), (float("inf"), 0.0), (float("nan"), 0.0)]
 CASES += [
     Case("fpu_fprem1_status", "fprem1 clears C2 and reports the quotient's low bits",
          _UNORDERED_FIRST + ["fld qword ptr [eax+16]", "fld qword ptr [eax]", "fprem1",
@@ -680,16 +682,20 @@ CASES += [
          _UNORDERED_FIRST + ["fld qword ptr [eax+16]", "fld qword ptr [eax]", "fprem",
                              "fnstsw ax", "sahf", "setp cl", "fstp st(1)",
                              "and eax, 04700h", "or al, cl"], _FPREM, "fpu"),
-    Case("fpu_fsin_c2", "fsin clears C2 in range; out of range st0 stays and C2 is set",
+    Case("fpu_trig_out_of_range", "fsin beyond 2^63: the x87 leaves st0 and sets C2, the lift computes it",
+         _UNORDERED_FIRST + ["fld qword ptr [eax]", "fsin", "fnstsw ax", "sahf",
+                             "setp cl", "and eax, 0400h", "or al, cl"],
+         [(1e19, 0.0), (-1e300, 0.0)], "fpu", tol=1e-15),
+    Case("fpu_fsin_c2", "fsin clears C2",
          _UNORDERED_FIRST + ["fld qword ptr [eax]", "fsin", "fnstsw ax", "sahf",
                              "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
-    Case("fpu_fcos_c2", "fcos reports its range in C2 the same way",
+    Case("fpu_fcos_c2", "fcos clears C2",
          _UNORDERED_FIRST + ["fld qword ptr [eax]", "fcos", "fnstsw ax", "sahf",
                              "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
-    Case("fpu_fptan_c2", "fptan pushes 1.0 only in range, and says which in C2",
+    Case("fpu_fptan_c2", "fptan pushes 1.0 (a NaN for a NaN or an infinity) and clears C2",
          _UNORDERED_FIRST + ["fld qword ptr [eax]", "fptan", "fnstsw ax", "sahf",
                              "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
-    Case("fpu_fsincos_c2", "fsincos pushes the cosine only in range",
+    Case("fpu_fsincos_c2", "fsincos pushes the cosine and clears C2",
          _UNORDERED_FIRST + ["fld qword ptr [eax]", "fsincos", "fnstsw ax", "sahf",
                              "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
     Case("fpu_fxam_sahf", "fxam's class bits reach CF, PF and ZF through sahf",
diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index ce01407..9503b5a 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -3913,21 +3913,33 @@ class Lifter:
         # These are exact-enough mappings onto libm. The 80-bit intermediates of
         # real x87 are not reproduced -- fp_stack is double -- which is the same
         # approximation every other op here already makes.
-        if m == "fsin":
-            return ["if (recomp_fp_trig_in_range(fp_top())) fp_top() = sin(fp_top()); /* fsin */"]
-        if m == "fcos":
-            return ["if (recomp_fp_trig_in_range(fp_top())) fp_top() = cos(fp_top()); /* fcos */"]
+        #
+        # The hardware takes |st0| < 2^63 only: then it clears C2; beyond, it
+        # leaves st0 alone (and pushes nothing), sets C2, and the caller reduces
+        # the argument (fprem against 2pi) and tries again. libm reduces any
+        # argument exactly, so every argument is computed here, the stack moves
+        # as for one in range and C2 is cleared: a caller that tests C2 goes on
+        # with the right value. Branching on the range made the push of fptan
+        # and fsincos conditional, and a function whose stack depth is not
+        # static loses the x87 locals (--x87-locals): three of Halo's grew by
+        # half. A NaN or infinite argument gives a NaN, as the hardware's masked
+        # invalid does.
+        if m in ("fsin", "fcos"):
+            return [f"fp_top() = {m[1:]}(fp_top()); g_fp_cc &= (uint16_t)~0x0400u; /* {m} */"]
         if m == "fsincos":
             # Replaces st0 with sin, then pushes cos. Order matters: the push
             # must see the sine already stored.
-            return [f"if (recomp_fp_trig_in_range(fp_top())) {{ double _a = fp_top(); fp_top() = sin(_a);"
-                    f" fp_push(cos(_a)); }} /* fsincos */"]
+            return [f"{{ double _a = fp_top(); fp_top() = sin(_a); fp_push(cos(_a));"
+                    f" g_fp_cc &= (uint16_t)~0x0400u; }} /* fsincos */"]
         if m == "fptan":
             # st0 = tan(st0), then push 1.0. The constant push is not decoration:
-            # callers use it as the denominator of a subsequent fdiv.
-            # An infinite or NaN operand pushes a NaN, not 1.0.
-            return ["if (recomp_fp_trig_in_range(fp_top())) { double _a = fp_top();"
-                    " fp_top() = tan(_a); fp_push(isfinite(_a) ? 1.0 : _a - _a); } /* fptan */"]
+            # callers use it as the denominator of a subsequent fdiv. A NaN or
+            # infinite argument pushes a NaN instead, as the hardware does:
+            # 1.0 + (t - t) is 1.0 for every finite t and NaN otherwise. (Not a
+            # ?: -- the x87 locals pass takes a conditional on a line that
+            # pushes for a push that may not happen, and gives the function up.)
+            return [f"{{ double _t = tan(fp_top()); fp_top() = _t; fp_push(1.0 + (_t - _t));"
+                    f" g_fp_cc &= (uint16_t)~0x0400u; }} /* fptan */"]
         if m == "fpatan":
             # st1 = atan2(st1, st0), pop. Argument order is st1 over st0.
             return [f"{{ fp_st1() = atan2(fp_st1(), fp_top()); fp_pop(); }}"
diff --git a/tools/recomp/test_lifter_fpu_reverse.py b/tools/recomp/test_lifter_fpu_reverse.py
index 709034a..a6e5ba1 100644
--- a/tools/recomp/test_lifter_fpu_reverse.py
