From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Mon, 19 Oct 2026 11:14:01 -0400
Subject: [PATCH] conformance: fld m80 and fstp m80 against the CPU

Upstream's b40805c lifts the x87 tbyte loads and stores (recomp_f80_load,
recomp_f80_store). These cases run them on the real CPU: a store's three
parts (low and high significand dwords, sign and exponent) read back
through eax, a round trip, and loads of hand-built significands just below,
on and just above a rounding tie, a denormal and the largest exponent.
---
 tools/conformance/cases.py | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
index 72002be..7312b53 100644
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -583,6 +583,41 @@ CASES += [
          ["cvttsd2si eax, qword ptr [eax]"], _CVT_SD, "fpu"),
 ]
 
+# 80-bit extended memory operands. A store writes the full 10 bytes (the
+# low dword, the high dword with the explicit integer bit, and sign plus
+# exponent are each read back through eax); a load rounds a 64-bit
+# significand to the model's 53 bits, so the hand-built operands sit just
+# below, on and just above a rounding tie.
+_FP_M80 = [(v, 0.0) for v in (1.0, -2.5, 3.141592653589793, 1e300, -1e-300,
+                              5e-324, 2.225073858507201e-308, 0.0, -0.0,
+                              float("inf"), -float("inf"), float("nan"))]
+CASES += [
+    Case("fpu_m80_roundtrip", "fstp m80 then fld m80 gives the double back",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "fld tbyte ptr [eax+32]"], _FP_M80, "fpu"),
+    Case("fpu_m80_store_lo", "fstp m80 writes the low significand dword",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "mov eax, dword ptr [eax+32]"], _FP_M80, "fpu"),
+    Case("fpu_m80_store_hi", "fstp m80 writes the high dword, integer bit set",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "mov eax, dword ptr [eax+36]"], _FP_M80, "fpu"),
+    Case("fpu_m80_store_exp", "fstp m80 writes sign and the 15-bit exponent",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "movzx eax, word ptr [eax+40]"], _FP_M80, "fpu"),
+]
+for _name, _lo, _hi, _se in (
+        ("below_tie", "0FFFFFBFFh", "0FFFFFFFFh", "03FFFh"),
+        ("tie_even", "000000400h", "080000000h", "0BFFFh"),
+        ("tie_odd", "000000C00h", "080000000h", "04005h"),
+        ("all_ones", "0FFFFFFFFh", "0FFFFFFFFh", "03FFFh"),
+        ("denormal", "000000001h", "000000000h", "00000h"),
+        ("huge", "000000000h", "080000000h", "07FFEh")):
+    CASES.append(Case("fpu_m80_load_" + _name,
+        "fld m80 rounds a 64-bit significand to nearest even",
+        ["mov dword ptr [eax+32], " + _lo, "mov dword ptr [eax+36], " + _hi,
+         "mov word ptr [eax+40], " + _se, "fld tbyte ptr [eax+32]"],
+        [(0.0, 0.0)], "fpu"))
+
 CASES.append(Case("pushad_popad", "POPAD restores registers and skips saved ESP",
     ["pushad", "mov eax, 0", "mov ecx, 0", "popad", "add eax, ecx"], _PAIRS))
 
