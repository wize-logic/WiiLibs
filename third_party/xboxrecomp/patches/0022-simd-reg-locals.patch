+def _simd_kept_in_memory(text):
+    """The SIMD registers a body first names other than by assigning the whole
+    register (xmm0 = ...): read, written in part (a lane, XMM_LOAD_HIGH) or
+    passed on. In a local, such a register would be loaded where the body
+    starts and its lanes held until the write-back, through every guest
+    access, for a few operations on it; it stays in its global instead. A
+    register first assigned whole costs nothing to load: the load is dead."""
+    first = {}
+    for line in text.splitlines():
+        code = _protect(line)[0]
+        for m in _SIMD_TOKEN.finditer(code):
+            name = m.group(1)
+            if name not in first:
+                rhs = re.match(r"\s*=(?!=)([^;]*)", code[m.end():])
+                first[name] = (re.match(r"\s*$|.*[;{}]\s*$", code[:m.start()]) is not None
+                               and rhs is not None
+                               and not re.search(r"\b(?:g_)?%s\b" % name, rhs.group(1)))
+    return frozenset(name for name, whole in first.items() if not whole)
+
