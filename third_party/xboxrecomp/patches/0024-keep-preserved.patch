diff --git a/tools/recomp/preserve.py b/tools/recomp/preserve.py
new file mode 100644
index 0000000..4ddc9a0
--- /dev/null
+++ b/tools/recomp/preserve.py
@@ -0,0 +1,748 @@
+"""
+Which generated functions give their caller back ebx, esi and edi.
+
+With --reg-locals a function keeps the guest registers in C locals and writes
+them back to the globals (g_ebx, ...) before a call; after the call it loads
+every one of them again, because the callee is free to change any register.
+The x86 calling convention says a callee preserves ebx, esi, edi and ebp, but
+guest code does not have to follow it (hand-written helpers, the SEH and EH
+prologs that build their caller's frame, the CRT's longjmp, code that is not
+a function at all), so the reload stays unless it is proven unnecessary.
+
+This pass proves it, for each generated function F and each of ebx, esi and
+edi: every return of F gives the caller the value the register had when F was
+entered. It reads the C text translate_function produces, before x87_locals
+rewrites it, so it judges exactly what runs. Per function it follows, over the
+function's own control flow (labels and gotos, as x87_locals does):
+
+  * whether each register still holds its value from the entry (it may be
+    assigned, and gets the entry value back only from a POP32 of a stack slot
+    that a PUSH32 filled with the entry value);
+  * esp as an offset from its value at the entry, through PUSH32, POP32,
+    `esp += K`, `esp -= K`, `esp = ebp + K`, and a call to a function whose own
+    analysis gives its effect on esp (4 + n for a `ret n`); anything else
+    makes it unknown, and nothing is then proven from it;
+  * ebp as an offset from the entry esp, after `ebp = esp + K`, or as the
+    frame it inherited (`ebp = g_ebp`, or `ebp = g_seh_ebp` in a function
+    with no frame of its own), and what g_ebp and g_seh_ebp hold;
+  * which stack slots hold an entry value, and the stores that overwrite them:
+    a store at a known offset from esp or ebp kills the slots it overlaps; a
+    callee's stores kill the slots between its entry esp and the highest
+    offset it (with its own callees) stores to; a store through an ebp the
+    function inherited lands in the frame of whichever caller owns it, and is
+    carried to the callers as offsets from that frame (it may also land below
+    the owner's esp, in a frame of the chain of calls, so a function that
+    makes such a store, itself or through a callee, preserves nothing); a
+    stack store at an unknown offset may hit any frame ("wild"), and kills
+    every slot of every caller up the chain.
+
+A call to anything but a generated function by name -- an indirect call, a
+call by address (RECOMP_ITAIL), a hand-written function, a runtime service
+that is not a plain accessor, setjmp and longjmp -- may change every register,
+moves esp by an unknown amount and may store anywhere. So does any statement
+this pass does not understand. Where paths join, a register keeps its entry
+value only if it does on both, and an esp or ebp offset that differs becomes
+unknown. A function F preserves R when every return (and the end of the body)
+has R at its entry value.
+
+The summaries depend on each other, and are found over the whole program:
+first the esp effects (from "never returns" upward, so that a recursive
+function gets one), then the stores into the callers' frames (from none
+upward), then the preserved registers (from all of them downward: a recursive
+call is assumed to keep its promise). Last, every function is analysed once
+more against all the summaries together, and one whose summary claims more
+than that shows claims nothing (and its callers are checked again). What is
+left is one fixpoint of the analysis, and so sound by induction on the depth
+of the calls, for every call that returns.
+
+What the analysis assumes of guest code: a store through a pointer that is not
+esp or ebp (an address computed into another register) does not land in a
+saved-register slot of a frame. Those slots are not objects a C program can
+name; the exceptions (setjmp, the SEH helpers, _alloca) work through esp and
+ebp and are covered above. The register globals are per guest thread, and a
+thread switch or interrupt work at a safe point (RECOMP_BACKEDGE) restores
+them, as x87_locals already assumes.
+"""
+
+import functools
+import heapq
+import re
+
+from .x87_locals import (_items, _match_paren, _protect, _reg_written, _function_bounds,
+                         _NotLocal, _LABEL, _TRANSPARENT, _KEYWORDS, _FP_MACROS)
+
+__all__ = ["CALLEE_SAVED", "Summary", "analyse", "preserved_by_name"]
+
+CALLEE_SAVED = ("ebx", "esi", "edi")
+_ALL = frozenset(CALLEE_SAVED)
+INF = float("inf")
+
+
+NEVER = "never"  # a delta: the function does not return
+
+
+class Summary:
+    """What one generated function does for its caller."""
+    __slots__ = ("preserved", "delta", "hi", "iw", "isw", "wild", "why")
+
+    def __init__(self, preserved=frozenset(), delta=None, hi=INF, iw=None, isw=None, wild=True, why=""):
+        self.preserved = preserved  # registers every return gives back
+        self.delta = delta          # esp after the return minus esp at the entry (None: unknown; NEVER)
+        self.hi = hi                # stores above the entry esp end below entry + hi
+        self.iw = iw                # offsets from the frame in g_ebp at the entry it stores at (None: any)
+        self.isw = isw              # the same from the frame in g_seh_ebp at the entry
+        self.wild = wild            # it may store anywhere in the stack
+        self.why = why
+
+    def key(self):
+        return (self.preserved, self.delta, self.hi, self.iw, self.isw, self.wild)
+
+    def entails(self, actual):
+        """This summary claims no more than actual (a fresh analysis) shows."""
+        def within(claim, got):
+            return claim is None or (got is not None and got <= claim)
+        return (self.preserved <= actual.preserved
+                and (actual.delta is NEVER or self.delta == actual.delta)
+                and actual.hi <= self.hi and within(self.iw, actual.iw)
+                and within(self.isw, actual.isw) and (self.wild or not actual.wild))
+
+
+UNKNOWN = Summary(why="not a generated function")
+
+# Names that neither change the registers nor esp nor store to the stack
+# (beyond what their arguments say, which is read here separately).
+_PURE = (_TRANSPARENT | frozenset("""
+    RECOMP_FP_PC_CW TEST_S XMM_MEM MMX_MEM MMX_FROM32 XMM_SCALAR XMM_SHUFFLE XMM_LOAD_HIGH XMM_LOAD_LOW
+    RECOMP_TRACE_ESP RECOMP_TRACE_ENTER RECOMP_TRACE_EXIT
+""".split())) - frozenset("PUSH32 POP32 memcpy memset memmove recomp_st80".split())
+
+# Writers of guest memory: the argument that is the address, and the bytes written.
+_STORES = {"MEMF_SET": 4, "MEMD_SET": 8, "recomp_st80": 10, "XMM_STORE": 16, "XMM_STORE_LOW": 8,
+           "XMM_STORE_HIGH": 8, "MMX_STORE": 8, "RECOMP_ATOMIC_CAS32": 4, "RECOMP_ATOMIC_ADD32": 4}
+_MEM_SIZE = {"8": 1, "16": 2, "32": 4, "64": 8, "F": 4, "D": 8}
+_MEM = re.compile(r"\bS?MEM(8|16|32|64|F|D)\s*\(")
+_NUM = r"(0x[0-9A-Fa-f]+|\d+)[uU]?"
+_ASSIGN = re.compile(r"\s*(=(?!=)|\+=|-=|\*=|/=|%=|&=|\|=|\^=|<<=|>>=|\+\+|--)")
+# esp, ebx, esi and edi are the globals (the bare names are macros for them); ebp is a C local
+_FRAME_TOKEN = re.compile(r"\b(?:g_(?=esp|ebx|esi|edi))?(esp|ebp|ebx|esi|edi)\b")
+_CALL = re.compile(r"RECOMP_ABI_CALL\(\s*0x[0-9A-Fa-f]+u?\s*,\s*(\w+)\s*\)")
+_CALLISH = re.compile(r"(?<![\w.])([A-Za-z_]\w*)\s*\(")
+
+
+def _num(text):
+    return int(text, 16) if text.lower().startswith("0x") else int(text)
+
+
+def _base_offset(addr):
+    """('esp'|'ebp', K) for an address `esp`, `esp + K`, `ebp - K` (with grouping
+    parentheses); None when it names neither; 'unknown' when it involves one
+    of them some other way."""
+    a = addr.strip()
+    while a.startswith("(") and _match_paren(a, 0) == len(a):
+        a = a[1:-1].strip()
+    m = re.fullmatch(r"(?:g_)?(esp|ebp)(?:\s*([+-])\s*(-?)\s*" + _NUM + r")?", a)
+    if m:
+        k = _num(m.group(4)) if m.group(4) else 0
+        return m.group(1), (-k if (m.group(2) == "-") != (m.group(3) == "-") else k)
+    if re.search(r"\b(?:g_)?(esp|ebp)\b", a):
+        return "unknown"
+    return None
+
+
+def _args(code, open_paren):
+    """The top-level arguments of the call whose '(' is at open_paren, and the
+    index just past its ')'."""
+    end = _match_paren(code, open_paren)
+    inner, out, depth, start = code[open_paren + 1:end - 1], [], 0, 0
+    for i, c in enumerate(inner):
+        if c in "([{":
+            depth += 1
+        elif c in ")]}":
+            depth -= 1
+        elif c == "," and depth == 0:
+            out.append(inner[start:i])
+            start = i + 1
+    out.append(inner[start:])
+    return out, end
+
+
+def _address_taken(code):
+    """A unary & of esp, ebp, ebx, esi or edi (not a binary `x & ebx`)."""
+    for m in re.finditer(r"(?<!&)&(?!&)\s*\(?\s*(?:g_)?(esp|ebp|ebx|esi|edi)\b", code):
+        prev = code[:m.start()].rstrip()
+        if not prev or not (prev[-1].isalnum() or prev[-1] in "_)]"):
+            return True
+    return False
+
+
+# ---------------------------------------------------------------- states
+#
+# A state is None (unreachable) or a tuple
+#   (off, ebp, gebp, gseh, orig, slots)
+# off:   esp - entry esp, or None
+# ebp:   a frame: ("f", k) entry esp + k; ("i",) what g_ebp held at the entry;
+#        ("s",) what g_seh_ebp held at the entry; None unknown
+# gebp:  what g_ebp holds, as a frame (("i",) at the entry)
+# gseh:  what g_seh_ebp holds, as a frame (("s",) at the entry); a function
+#        with no frame of its own starts with `ebp = g_seh_ebp`
+# orig:  the registers holding their entry values
+# slots: frozenset of (offset, register): a slot holding the register's entry value
+
+_INHERITED = {("i",): "iw", ("s",): "isw"}
+
+
+def _kill(slots, lo, hi):
+    return frozenset(x for x in slots if not (lo < x[0] + 4 and x[0] < hi))
+
+
+def _join(a, b):
+    if a is None:
+        return b
+    if b is None or a == b:
+        return a
+    off = a[0] if a[0] == b[0] else None
+    slots = a[5] & b[5] if off is not None else frozenset()
+    return (off, a[1] if a[1] == b[1] else None, a[2] if a[2] == b[2] else None,
+            a[3] if a[3] == b[3] else None, a[4] & b[4], slots)
+
+
+_UNKNOWN_CALL = "an unknown call"
+_ADDRESS_TAKEN = "a register's address is taken"
+
+
+@functools.lru_cache(maxsize=None)
+def _effects(code):
+    """What a statement does that this pass follows (it is the same in every
+    state): _UNKNOWN_CALL, _ADDRESS_TAKEN, or (the frame and callee-saved
+    registers it may assign, its stack stores as (base, bytes), whether it
+    assigns g_ebp, whether it assigns g_seh_ebp)."""
+    for m in _CALLISH.finditer(code):
+        name = m.group(1)
+        if name in _KEYWORDS or name in _FP_MACROS or name in _PURE or name in ("RECOMP_ABI_CALL",):
+            continue
+        if _MEM.match(code, m.start()) or name in _STORES:
+            continue
+        if name.startswith(("XMM_", "MMX_")) and name not in _STORES:
+            continue
+        if name in ("PUSH32", "POP32"):
+            continue
+        return _UNKNOWN_CALL
+    if _address_taken(code):
+        return _ADDRESS_TAKEN
+    written = frozenset(m.group(1) for m in _FRAME_TOKEN.finditer(code)
+                        if _reg_written(code, m.start(), m.end()))
+
+    def base_of(addr):
+        # a base this statement (a loop's body) also moves is not known
+        b = _base_offset(addr)
+        return "unknown" if (b not in (None, "unknown") and b[0] in written) else b
+    stores = []
+    for m in _MEM.finditer(code):
+        args, end = _args(code, m.end() - 1)
+        if _ASSIGN.match(code, end) or re.search(r"(\+\+|--)\s*$", code[:m.start()]):
+            b = base_of(args[0])
+            if b is not None:
+                stores.append((b, _MEM_SIZE[m.group(1)]))
+    for name, size in _STORES.items():
+        for m in re.finditer(r"\b%s\s*\(" % name, code):
+            args, _ = _args(code, m.end() - 1)
+            b = base_of(args[0])
+            if b is not None:
+                stores.append((b, size))
+    for m in re.finditer(r"\b(memcpy|memset|memmove)\s*\(", code):
+        args, _ = _args(code, m.end() - 1)
+        if re.search(r"\b(?:g_)?(esp|ebp)\b", args[0]):
+            stores.append(("unknown", 0))
+    return (written & frozenset(("esp", "ebp")) | (written & _ALL), tuple(stores),
+            bool(re.search(r"\bg_ebp\s*=(?!=)", code)), bool(re.search(r"\bg_seh_ebp\s*=(?!=)", code)))
+
+
+@functools.lru_cache(maxsize=None)
+def _items_of(code):
+    return tuple(_items(code))
+
+
+@functools.lru_cache(maxsize=None)
+def _classify(raw):
+    """A statement's form, for _Fn.stmt (the same in every state)."""
+    t = re.sub(r"\x01\d+\x02", "", raw).strip()
+    if not t or t == "(void)0":
+        return ("skip",)
+    if t == "return":
+        return ("return",)
+    m = re.fullmatch(r"goto\s+(\w+)", t)
+    if m:
+        return ("goto", m.group(1))
+    if re.match(r"if\s*\(", t):
+        i = t.index("(")
+        j = _match_paren(t, i)
+        return ("if", t[i:j], _items_of(t[j:] + ";"))
+    m = re.fullmatch(r"PUSH32\(\s*esp\s*,\s*(.*)\)", t)
+    if m:
+        return ("push", m.group(1).strip())
+    m = re.fullmatch(r"POP32\(\s*esp\s*,\s*(\w+)\s*\)", t)
+    if m and (m.group(1) in _ALL or m.group(1) in ("ebp", "esp", "eax", "ecx", "edx")):
+        return ("pop", m.group(1))
+    m = re.fullmatch(r"esp\s*([+-])=\s*" + _NUM, t)
+    if m:
+        return ("esp+=", _num(m.group(2)) * (1 if m.group(1) == "+" else -1))
+    m = re.fullmatch(r"(esp|ebp)\s*=\s*(esp|ebp)(?:\s*([+-])\s*" + _NUM + r")?", t)
+    if m:
+        k = _num(m.group(4)) * (-1 if m.group(3) == "-" else 1) if m.group(4) else 0
+        return ("frame=", m.group(1), m.group(2), k)
+    for form in ("ebp=g_ebp", "ebp=g_seh_ebp", "g_ebp=ebp", "g_seh_ebp=ebp"):
+        dst, src = form.split("=")
+        if re.fullmatch(r"%s\s*=\s*%s" % (dst, src), t):
+            return (form,)
+    m = _CALL.fullmatch(t)
+    if m:
+        return ("call", m.group(1))
+    m = re.fullmatch(r"(\w+)\(\s*\)", t)
+    if m:
+        return ("name()", m.group(1), t)
+    return ("generic", t)
+
+
+class _Fn:
+    """One function's analysis against the current summaries."""
+
+    def __init__(self, summaries):
+        self.summaries = summaries
+        self.rets = []
+        self.hi = 0
+        self.iw = frozenset()
+        self.isw = frozenset()
+        self.wild = False
+
+    # -- effects
+    def inherited(self, frame, offs):
+        """Stores at offs (None: any) from a frame this function inherited."""
+        attr = _INHERITED[frame]
+        cur = getattr(self, attr)
+        setattr(self, attr, None if (cur is None or offs is None) else cur | offs)
+
+    def store(self, s, base, size):
+        """A store of size bytes at base: ('esp'|'ebp', k), or 'unknown'."""
+        if base == "unknown":
+            self.wild = True
+            return s[:5] + (frozenset(),)
+        reg, k = base
+        if reg == "esp":
+            at = None if s[0] is None else s[0] + k
+        elif s[1] is not None and s[1][0] == "f":
+            at = s[1][1] + k
+        elif s[1] in _INHERITED:
+            self.inherited(s[1], frozenset((k,)))
+            return s
+        else:
+            at = None
+        if at is None:
+            self.wild = True
+            return s[:5] + (frozenset(),)
+        self.hi = max(self.hi, at + size)
+        return s[:5] + (_kill(s[5], at, at + size),)
+
+    def unknown_call(self, s):
+        self.wild = True
+        return (None, s[1], None, None, frozenset(), frozenset())
+
+    def call(self, s, name):
+        c = self.summaries.get(name, UNKNOWN)
+        if c is UNKNOWN:
+            return self.unknown_call(s)
+        off, ebp, gebp, gseh, orig, slots = s
+        # its stores above its entry esp (the arguments and the caller's frame)
+        if c.wild or off is None:
+            if c.wild or c.hi > 0:
+                self.wild = True
+                slots = frozenset()
+        elif c.hi > 0:
+            self.hi = max(self.hi, off + c.hi)
+            slots = _kill(slots, off, off + c.hi)
+        # its stores through the frames it inherits (g_ebp's and g_seh_ebp's)
+        for offs, frame in ((c.iw, gebp), (c.isw, gseh)):
+            if offs is not None and not offs:
+                continue
+            if frame in _INHERITED:
+                self.inherited(frame, offs)  # an older caller's frame: theirs to judge
+            elif frame is not None and frame[0] == "f" and offs is not None:
+                for k in offs:  # a store of up to 16 bytes at the frame + k
+                    at = frame[1] + k
+                    slots = _kill(slots, at, at + 16)
+                    self.hi = max(self.hi, at + 16)
+            else:
+                self.wild = True
+                slots = frozenset()
+        if c.delta is NEVER:
+            return None
+        off = None if (off is None or c.delta is None) else off + c.delta
+        slots = frozenset(x for x in slots if x[0] >= off) if off is not None else frozenset()
+        # the callee may leave its own frame in g_ebp and g_seh_ebp
+        return (off, ebp, None, None, orig & c.preserved, slots)
+
+    # -- statements
+    def generic(self, s, code):
+        """A statement this pass has no special case for: every register it
+        may assign loses its value, every stack store kills, every call that
+        is not a plain accessor is an unknown call."""
+        fx = _effects(code)
+        if fx is _UNKNOWN_CALL:
+            return self.unknown_call(s)
+        if fx is _ADDRESS_TAKEN:
+            raise _NotLocal("a register's address is taken")
+        written, stores, gebp_w, gseh_w = fx
+        for b, size in stores:
+            s = self.store(s, b, size)
+        off, ebp, gebp, gseh, orig, slots = s
+        if "esp" in written:
+            off, slots = None, frozenset()
+        if "ebp" in written:
+            ebp = None
+        return (off, ebp, None if gebp_w else gebp, None if gseh_w else gseh, orig - written, slots)
+
+    def stmt(self, s, t, edges):
+        if s is None or not t:
+            return s
+        op = _classify(t)
+        kind = op[0]
+        if kind == "skip":
+            return s
+        if kind == "return":
+            self.rets.append(s)
+            return None
+        if kind == "goto":
+            edges.append((op[1], s))
+            return None
+        if kind == "if":
+            s = self.generic(s, op[1])
+            return _join(s, self.seq(s, op[2], edges))
+        if kind == "push":
+            s = self.generic(s, op[1])
+            if s[0] is None:
+                return self.store(s, "unknown", 4)  # below an esp it does not know
+            off, ebp, gebp, gseh, orig, slots = s
+            off -= 4
+            slots = frozenset(x for x in slots if x[0] != off)
+            if op[1] in orig:
+                slots |= {(off, op[1])}
+            return (off, ebp, gebp, gseh, orig, slots)
+        off, ebp, gebp, gseh, orig, slots = s
+        if kind == "pop":
+            r = op[1]
+            if r in _ALL:
+                orig = (orig | {r}) if (off is not None and (off, r) in slots) else (orig - {r})
+            elif r == "ebp":
+                ebp = None
+            elif r == "esp":
+                return (None, ebp, gebp, gseh, orig, frozenset())
+            if off is None:
+                return (None, ebp, gebp, gseh, orig, slots)
+            off += 4
+            return (off, ebp, gebp, gseh, orig, frozenset(x for x in slots if x[0] >= off))
+        if kind == "esp+=":
+            if off is None:
+                return s
+            off += op[1]
+            return (off, ebp, gebp, gseh, orig, frozenset(x for x in slots if x[0] >= off))
+        if kind == "frame=":  # esp or ebp = esp or ebp + k
+            src = off if op[2] == "esp" else (ebp[1] if ebp is not None and ebp[0] == "f" else None)
+            if op[1] == "ebp":
+                return (off, None if src is None else ("f", src + op[3]), gebp, gseh, orig, slots)
+            if src is None:
+                return (None, ebp, gebp, gseh, orig, frozenset())
+            off = src + op[3]
+            return (off, ebp, gebp, gseh, orig, frozenset(x for x in slots if x[0] >= off))
+        if kind == "ebp=g_ebp":
+            return (off, gebp, gebp, gseh, orig, slots)
+        if kind == "ebp=g_seh_ebp":
+            return (off, gseh, gebp, gseh, orig, slots)
+        if kind == "g_ebp=ebp":
+            return (off, ebp, ebp, gseh, orig, slots)
+        if kind == "g_seh_ebp=ebp":
+            return (off, ebp, gebp, ebp, orig, slots)
+        if kind == "call":
+            return self.call(s, op[1])
+        if kind == "name()" and op[1] in self.summaries:
+            return self.call(s, op[1])  # a tail call
+        return self.generic(s, op[-1])
+
+    def seq(self, s, items, edges):
+        last_if = None  # the states before and after the last if, for its else
+        for item in items:
+            op = _seq_item(item)
+            kind = op[0]
+            if kind == "if":
+                if s is None:
+                    last_if = None
+                    continue
+                before = self.generic(s, op[1])
+                then = self.seq(before, op[2], edges)
+                s, last_if = _join(before, then), (before, then)
+            elif kind == "else":
+                if last_if is None:
+                    if s is not None:
+                        raise _NotLocal("an else of another form")
+                    continue
+                before, then = last_if
+                s, last_if = _join(then, self.seq(before, op[1], edges)), None
+            elif kind == "stmt":
+                s = self.stmt(s, op[1], edges)
+                last_if = None
+            elif kind == "{}":
+                if s is not None:
+                    s = self.seq(s, op[1], edges)
+                last_if = None
+            elif kind == "loop":
+                if s is not None:
+                    s = self.generic(s, op[1])
+                last_if = None
+            else:
+                raise _NotLocal(op[1])
+        return s
+
+
+@functools.lru_cache(maxsize=None)
+def _seq_item(item):
+    """An item of a body (x87_locals._items) as _Fn.seq takes it: ("if",
+    condition, then-items), ("else", items), ("stmt", text), ("{}", items),
+    ("loop", text) or ("fail", why)."""
+    if item[0] == "stmt":
+        t = re.sub(r"\x01\d+\x02", "", item[1]).strip()
+        if re.match(r"if\s*\(", t):
+            i = t.index("(")
+            j = _match_paren(t, i)
+            if re.match(r"\s*(if|else)\b", t[j:]):
+                return ("fail", "an if inside an if without braces")
+            return ("if", t[i:j], _items_of(t[j:] + ";"))
+        if re.match(r"else\b", t):
+            return ("else", _items_of(t[4:] + ";"))
+        return ("stmt", item[1])
+    if item[0] == "block":
+        head = re.sub(r"\x01\d+\x02", "", item[1]).strip()
+        if head == "":
+            return ("{}", _items_of(item[2]))
+        if re.match(r"if\s*\(", head) and _match_paren(head, head.index("(")) == len(head):
+            return ("if", head, _items_of(item[2]))
+        if head == "else":
+            return ("else", _items_of(item[2]))
+        if re.match(r"(while|for)\s*\(", head) or head == "do":
+            if re.search(r"\b(goto|return|PUSH32|POP32|RECOMP_ABI_CALL)\b", item[2]):
+                return ("fail", "a loop that leaves or moves esp")
+            return ("loop", head + " " + item[2])
+        return ("fail", "a block of another form: %s" % head[:40])
+    return ("fail", "an unbalanced block")
+
+
+def _parse(lines):
+    """A function's body as segments: (label or None, items)."""
+    bounds = _function_bounds(lines)
+    if bounds is None:
+        raise _NotLocal("no body")
+    lo, hi = bounds
+    segs, cur, label, i = [], [], None, lo
+    while i < hi:
+        line = lines[i]
+        if line.lstrip().startswith("#"):
+            while lines[i].rstrip().endswith("\\") and i + 1 < hi:
+                i += 1
+            i += 1
+            continue
+        lm = _LABEL.match(line)
+        if lm:
+            segs.append((label, " ".join(cur)))
+            cur, label = [], lm.group(1)
+        else:
+            cur.append(_protect(line)[0])
+        i += 1
+    segs.append((label, " ".join(cur)))
+    text = " ".join(c for _, c in segs)
+    if re.search(r"setjmp|longjmp", text):
+        raise _NotLocal("setjmp")
+    if re.search(r"\b(switch|case|default)\b", text):
+        raise _NotLocal("a switch")
+    return [(lab, _items(code)) for lab, code in segs]
+
+
+_ENTRY = (0, None, ("i",), ("s",), _ALL, frozenset())
+
+
+def _run(segs, summaries):
+    fn = _Fn(summaries)
+    index = {lab: x for x, (lab, _) in enumerate(segs) if lab is not None}
+    state_in = [None] * len(segs)
+    state_in[0] = _ENTRY
+    work, seen = [0], 0
+    while work:
+        seen += 1
+        if seen > 200 * len(segs) + 1000:
+            raise _NotLocal("no fixpoint")
+        x = work.pop()
+        edges = []
+        out = fn.seq(state_in[x], segs[x][1], edges)
+        if x + 1 < len(segs):
+            edges.append((segs[x + 1][0], out))
+        elif out is not None:
+            fn.rets.append(out)  # the end of the body returns
+        for lab, st in edges:
+            if st is None:
+                continue
+            if lab not in index:
+                raise _NotLocal("a goto out of the body")
+            y = index[lab]
+            new = _join(state_in[y], st)
+            if new != state_in[y]:
+                state_in[y] = new
+                work.append(y)
+    return fn
+
+
+def _summarise(fn):
+    deltas = {r[0] for r in fn.rets}
+    preserved = _ALL
+    for r in fn.rets:
+        preserved &= r[4]
+    if fn.iw != frozenset() or fn.isw != frozenset():
+        # a store through a frame it inherits may land below the caller's esp,
+        # in this function's own frame or a callee's: none of the slots can
+        # be trusted, and the caller cannot tell
+        preserved = frozenset()
+    return Summary(preserved=preserved,
+                   delta=NEVER if not deltas else deltas.pop() if len(deltas) == 1 else None,
+                   hi=fn.hi, iw=fn.iw, isw=fn.isw, wild=fn.wild, why="")
+
+
+def _callee_order(names, callers):
+    """names ordered callees first (a postorder of the calls; the functions of
+    a cycle in any order among themselves)."""
+    callees = {n: [] for n in names}
+    for callee, cs in callers.items():
+        for c in cs:
+            if c in callees and callee in callees:
+                callees[c].append(callee)
+    order, seen = [], set()
+    for root in names:
+        if root in seen:
+            continue
+        seen.add(root)
+        stack = [(root, iter(sorted(callees[root])))]
+        while stack:
+            n, it = stack[-1]
+            for m in it:
+                if m not in seen:
+                    seen.add(m)
+                    stack.append((m, iter(sorted(callees[m]))))
+                    break
+            else:
+                stack.pop()
+                order.append(n)
+    return order
+
+
+def _fixpoint(order, callers, init, update, limit):
+    """Summaries from init, each recomputed (update(name, current)) when a
+    callee's changes, until none changes; None when that takes too long.
+    The callees go first (order), so most functions are done once."""
+    rank = {n: i for i, n in enumerate(order)}
+    cur = dict(init)
+    work = list(range(len(order)))  # a heap of ranks (already one: sorted)
+    queued = set(work)
+    steps = 0
+    while work:
+        steps += 1
+        if steps > limit:
+            return None
+        x = heapq.heappop(work)
+        queued.discard(x)
+        n = order[x]
+        new = update(n, cur)
+        if new.key() != cur[n].key():
+            cur[n] = new
+            for c in callers.get(n, ()):
+                y = rank.get(c)
+                if y is not None and y not in queued:
+                    queued.add(y)
+                    heapq.heappush(work, y)
+    return cur
+
+
+def analyse(functions):
+    """functions: {C name: lines of the function as translate_function makes
+    them, before x87_locals}. Returns {C name: Summary}."""
+    parsed, failed = {}, {}
+    for name, lines in functions.items():
+        try:
+            parsed[name] = _parse(lines)
+        except _NotLocal as e:
+            failed[name] = str(e)
+    callers = {}
+    for name, lines in functions.items():
+        text = "\n".join(lines)
+        for callee in set(re.findall(r"\b(\w+)\s*\(", text)) | set(_CALL.findall(text)):
+            if callee in parsed and callee != name:
+                callers.setdefault(callee, set()).add(name)
+    names = _callee_order(sorted(parsed), callers)
+
+    def run(name, cur):
+        try:
+            return _summarise(_run(parsed[name], cur))
+        except _NotLocal as e:
+            failed[name] = str(e)
+            return None
+
+    limit = 50 * len(names) + 1000
+    none = frozenset()
+    # 1. esp effects, from "never returns" upward (the other parts as if all is well)
+    def upd_delta(n, cur):
+        r = run(n, cur)
+        return UNKNOWN if r is None else Summary(_ALL, r.delta, 0, none, none, False)
+    deltas = _fixpoint(names, callers, {n: Summary(_ALL, NEVER, 0, none, none, False) for n in names},
+                       upd_delta, limit) or {n: UNKNOWN for n in names}
+
+    # 2. stores into the callers' frames, from none upward, with the deltas fixed
+    def upd_stores(n, cur):
+        if deltas[n] is UNKNOWN:
+            return UNKNOWN
+        r = run(n, cur)
+        return UNKNOWN if r is None else Summary(_ALL, deltas[n].delta, r.hi, r.iw, r.isw, r.wild)
+    stores = _fixpoint(names, callers, {n: deltas[n] if deltas[n] is UNKNOWN
+                                        else Summary(_ALL, deltas[n].delta, 0, none, none, False)
+                                        for n in names}, upd_stores, limit) or {n: UNKNOWN for n in names}
+
+    # 3. the preserved registers, from all downward, with the rest fixed
+    def upd_pres(n, cur):
+        if stores[n] is UNKNOWN:
+            return UNKNOWN
+        r = run(n, cur)
+        s = stores[n]
+        return UNKNOWN if r is None else Summary(r.preserved & cur[n].preserved, s.delta, s.hi, s.iw, s.isw, s.wild)
+    result = _fixpoint(names, callers, stores, upd_pres, limit) or {n: UNKNOWN for n in names}
+
+    # 4. the whole of each summary checked against the others together, so
+    # that they are one fixpoint (and so sound, by induction on the depth of
+    # the calls); a function that fails it claims nothing, and its callers
+    # are checked again
+    work = [n for n in reversed(names) if result[n] is not UNKNOWN]
+    queued = set(work)
+    while work:
+        n = work.pop()
+        queued.discard(n)
+        if result[n] is UNKNOWN:
+            continue
+        r = run(n, result)
+        if r is None or not result[n].entails(r):
+            result[n] = UNKNOWN
+            failed.setdefault(n, "no fixpoint of the summaries")
+            for c in callers.get(n, ()):
+                if c not in queued and result.get(c, UNKNOWN) is not UNKNOWN:
+                    queued.add(c)
+                    work.append(c)
+    for n, why in failed.items():
+        result[n] = Summary(why=why)
+    return result
+
+
+def preserved_by_name(summaries):
+    """{C name: frozenset of the globals (g_ebx, ...) a call to it gives back}
+    for the functions that preserve any."""
+    return {n: frozenset("g_" + r for r in s.preserved)
+            for n, s in summaries.items() if s.preserved}
