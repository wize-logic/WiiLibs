+        li = next((i for i in range(nodes[x].first, nodes[x].last + 1)
+                   if re.search(r"\b" + _G + r"esp\s*=\s*" + _G + r"esp\s*&", _protect(lines[i])[0])), None)
+        if li is None:
+            raise _Decline("an aligned frame of another form")
+        after.setdefault(li, []).append("    %s /* from memory at the aligned esp */" % " ".join(
+            load(o, off) for o in slots if o < lo))
     for x, n in enumerate(nodes):
         if not syncs[x] or state_in[x] is None:
             continue
