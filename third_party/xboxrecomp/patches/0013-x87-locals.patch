diff --git a/tools/recomp/test_x87_locals.py b/tools/recomp/test_x87_locals.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_x87_locals.py
@@ -0,0 +1,262 @@
+"""
+--x87-locals: a function's x87 stack, control word and compare result in C locals.
+
+The memory model (g_fp_stack/g_fp_top through fp_push, fp_pop, fp_top, fp_st)
+stays the truth wherever control leaves a function. Inside one, x87_locals.py
+maps each stack position, relative to the depth on entry, to a double local
+and writes memory back before every call, tail call and return, and re-reads
+it after a call. These checks cover what it emits and when it declines.
+"""
+
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import config  # noqa: E402
+from tools.recomp.translator import (FunctionTranslator, FP_STACK_MACROS,  # noqa: E402
+                                     FP_STACK_UNDEFS)
+from tools.recomp.x87_locals import localise_x87  # noqa: E402
+
+BASE = 0x00010000
+
+
+def _translate(image, funcs=((0, None),), locals_=True):
+    config._install(
+        [config.Section(".text", BASE, len(image), 0x0000, len(image), True)],
+        entry_point=BASE, kernel_thunk_addr=BASE, origin="x87-locals-test")
+    db = {}
+    bounds = [off for off, _ in funcs] + [len(image)]
+    for (off, _), end in zip(funcs, bounds[1:]):
+        db[BASE + off] = {"start": f"0x{BASE + off:08X}", "end": BASE + end,
+                          "_addr": BASE + off, "size": end - off}
+    t = FunctionTranslator(image, db)
+    t.x87_locals = locals_
+    return t.translate_function(BASE, db[BASE]), t
+
+
+def _body(code):
+    """The function's statements, without the memory model's macro lines."""
+    return "\n".join(line for line in code.splitlines()
+                     if line not in FP_STACK_MACROS and line not in FP_STACK_UNDEFS)
+
+
+FLD_A = b"\xD9\x05\x00\x20\x00\x00"     # fld dword ptr [0x2000]
+FMUL_B = b"\xD8\x0D\x04\x20\x00\x00"    # fmul dword ptr [0x2004]
+FSTP_C = b"\xD9\x1D\x08\x20\x00\x00"    # fstp dword ptr [0x2008]
+FLD1, FLDZ, FADDP, FXCH = b"\xD9\xE8", b"\xD9\xEE", b"\xDE\xC1", b"\xD9\xC9"
+RET = b"\xC3"
+
+
+def test_straight_line_code_uses_locals_and_writes_back_at_the_return():
+    code, t = _translate(FLD_A + FMUL_B + FSTP_C + RET)
+    body = _body(code)
+    assert "_x87sm1 = (MEMF(0x2000));" in body, body
+    assert "RECOMP_FP_PC_CW(_x87cw, _x87sm1 * MEMF(0x2004))" in body, body
+    assert not re.search(r"\bfp_(push|pop|top|st1?)\(", body), body
+    # the value was popped (stored and gone) and g_fp_top is back where it was:
+    # the slot is empty, so nothing has to go back to memory
+    assert "x87 state to memory" not in body, body
+    assert "g_fp_top =" not in body and "g_fp_stack[" not in body.split("#define _X87_LOAD")[1].split("\n", 1)[1], body
+    assert t.x87_stats == {"in locals": 1}
+
+
+def test_off_by_default():
+    code, t = _translate(FLD_A + FMUL_B + FSTP_C + RET, locals_=False)
+    assert "_x87" not in code and "fp_push(MEMF(0x2000))" in code, code
+    assert t.x87_stats == {}
+
+
+def test_a_call_writes_back_before_and_the_next_x87_statement_reads_again():
+    # +0 fld [a]; +6 call +16 (fld1; ret); +11 faddp; +13 fstp [c]; +19 ret; +20 fld1; ret
+    image = FLD_A + b"\xE8\x09\x00\x00\x00" + FADDP + FSTP_C + RET + FLD1 + RET
+    code, _ = _translate(image, funcs=((0, None), (20, None)))
+    body = _body(code)
+    call = body.index("sub_00010014")
+    before, after = body[:call], body[call:]
+    line_before = before.splitlines()[-1]
+    assert "g_fp_stack[(_x87t + 7u) & 7u] = _x87sm1;" in before.splitlines()[-2], before
+    assert "g_fp_top = (int)((_x87t + 7u) & 7u);" in before.splitlines()[-2], before
+    assert "PUSH32" in line_before, before
+    # memory is the truth after the call; the next x87 statement loads the locals
+    assert after.splitlines()[3].strip() == "_X87_LOAD();", after
+    # after the call st(0) is the callee's result and st(1) the value pushed
+    # before it: positions 0 and 1 from the depth the call left
+    assert "_x87s1 = RECOMP_FP_PC_CW(_x87cw, _x87s1 + _x87s0);" in after, after
+
+
+def test_paths_that_join_at_different_depths_join_through_memory():
+    # +0 test eax, eax; +2 je +6; +4 fld1; +6 fldz; +8 fstp [c]; +14 ret
+    image = b"\x85\xC0" b"\x74\x02" + FLD1 + FLDZ + FSTP_C + RET
+    code, t = _translate(image)
+    body = _body(code)
+    assert "/* x87: paths join here at different depths; memory is current */" in body, body
+    join = body.index("loc_00010006:")
+    assert body.index("_X87_LOAD();", join) < body.index("fldz"), body
+    # every edge into it leaves memory current: the fall-through writes the
+    # fld1 back; the branch has nothing to write (nothing changed before it)
+    assert body.rindex("x87 state to memory", 0, join) > body.index("fld1"), body
+    assert body.index("x87 state to memory") > body.index("je:"), body
+    assert t.x87_stats == {"in locals": 1}
+
+
+def test_fxch_swaps_locals():
+    code, _ = _translate(FLD_A + FLD1 + FXCH + FSTP_C + FSTP_C + RET)
+    body = _body(code)
+    assert "{ double _t = _x87sm2; _x87sm2 = _x87sm1; _x87sm1 = _t; }" in body, body
+
+
+def test_the_status_word_top_field_follows_the_static_depth():
+    # fld [a]; fcomp [a]... fnstsw ax with one value pushed: TOP = base - 1
+    image = FLD_A + b"\xD8\x15\x00\x20\x00\x00" + b"\xDF\xE0" + FSTP_C + RET
+    code, _ = _translate(image)
+    body = _body(code)
+    assert "((_x87t + 7u) & 7u) << 11) | _x87cc)" in body, body
+    assert "_x87cmp = RECOMP_FCMP(_x87sm1, MEMF(0x2000));" in body, body
+    # the compare results go back to memory at the return
+    assert "g_fp_cmp = _x87cmp; g_fp_cc = _x87cc;" in body, body
+
+
+def _wrap(body_lines):
+    return (["void f(void)", "{"] + FP_STACK_MACROS + body_lines + FP_STACK_UNDEFS
+            + ["}", ""])
+
+
+def test_declines_setjmp():
+    lines = _wrap(["    fp_push(1.0);",
+                   "    { int _sjv = setjmp(*recomp_setjmp_slot(MEM32(esp))); (void)_sjv; }",
+                   "    fp_pop();", "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert out == lines and why == "setjmp"
+
+
+def test_declines_more_than_eight_positions():
+    lines = _wrap(["    fp_push(1.0);"] * 9 + ["    fp_pop();"] * 9 + ["    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert out == lines and why == "more than eight stack positions"
+
+
+def test_declines_a_goto_in_a_statement_that_calls():
+    lines = _wrap(["loc_00000001: ;", "    fp_push(1.0);",
+                   "    if (eax) { sub_00001000(); goto loc_00000001; }",
+                   "    fp_pop();", "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert out == lines and "goto" in why
+
+
+def test_an_unknown_name_is_a_call_and_an_unknown_x87_form_runs_on_memory():
+    lines = _wrap(["    fp_push(MEMF(0x2000));",
+                   "    some_runtime_service(eax);",
+                   "    g_fp_top = 3; /* an x87 form the pass does not know */",
+                   "    fp_top() = RECOMP_FP_PC(fp_top() * 2.0);",
+                   "    MEMF_SET(0x2008, (float)fp_top()); fp_pop();",
+                   "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert why is None, why
+    text = "\n".join(out)
+    svc = text.index("some_runtime_service")
+    assert "g_fp_top = (int)((_x87t + 7u) & 7u);" in text[:svc], text
+    unknown = text.index("g_fp_top = 3;")
+    # memory is the truth from the call on: the unknown form runs on it, the next
+    # x87 statement loads the locals again
+    assert "x87 state to memory" not in text[svc:unknown], text
+    assert text.index("_X87_LOAD();", svc) > unknown, text
+    assert "_x87s0 = RECOMP_FP_PC_CW(_x87cw, _x87s0 * 2.0);" in text, text
+
+
+def test_a_conditional_block_over_several_lines_is_one_statement():
+    lines = _wrap(["    fp_push(MEMF(0x2000));",
+                   "    if (eax) {",
+                   "      fp_top() = 2.0;",
+                   "    }",
+                   "    else {",
+                   "      fp_top() = 3.0; }",
+                   "    MEMF_SET(0x2008, (float)fp_top()); fp_pop();",
+                   "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert why is None, why
+    text = "\n".join(out)
+    # memory is the truth across the block: written back before, read after
+    block = text.index("    if (eax) {")
+    assert "g_fp_stack[(_x87t + 7u) & 7u] = _x87sm1;" in text[:block], text
+    assert text.index("_X87_LOAD();", block) > text.index("fp_top() = 3.0; }"), text
+    assert "    else {" in text
+
+
+def test_a_join_of_memory_and_locals_loads_on_the_memory_edges():
+    lines = _wrap(["    if (eax) goto loc_00000001;",
+                   "    fp_push(1.0); MEMF_SET(0x10, (float)fp_top()); fp_pop();",
+                   "    goto loc_00000002;",
+                   "loc_00000001: ;",
+                   "    eax = 1;",
+                   "loc_00000002: ;",
+                   "    fp_push(2.0);",
+                   "    MEMF_SET(0x14, (float)fp_top()); fp_pop();",
+                   "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert why is None, why
+    body = [l.strip() for l in out[out.index(FP_STACK_MACROS[-1]) + 3:]]
+    # loc_00000002 is reached with the locals (from the fp_push path) and with
+    # memory (through loc_00000001, where nothing touched the x87): the memory
+    # edge loads them, after eax = 1, so the join keeps them
+    assert body[:7] == ["if (eax) goto loc_00000001;", "_X87_LOAD();",
+                        "_x87sm1 = (1.0); MEMF_SET(0x10, (float)_x87sm1); (void)0;",
+                        "goto loc_00000002;", "loc_00000001: ;", "eax = 1;", "_X87_LOAD();"], body
+    assert body[7:9] == ["loc_00000002: ;", "_x87sm1 = (2.0);"], body
+    assert body.count("_X87_LOAD();") == 2, body
+
+
+def test_a_goto_from_memory_to_a_join_with_locals_loads_on_its_edge():
+    lines = _wrap(["    if (eax) goto loc_00000002;",
+                   "    fp_push(1.0); MEMF_SET(0x10, (float)fp_top()); fp_pop();",
+                   "loc_00000002: ;",
+                   "    fp_push(2.0);",
+                   "    MEMF_SET(0x14, (float)fp_top()); fp_pop();",
+                   "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert why is None, why
+    body = [l.strip() for l in out[out.index(FP_STACK_MACROS[-1]) + 3:]]
+    # only the taken branch loads; the fall-through loads for its own fp_push
+    assert body[:4] == ["if (eax) { _X87_LOAD(); goto loc_00000002; }", "_X87_LOAD();",
+                        "_x87sm1 = (1.0); MEMF_SET(0x10, (float)_x87sm1); (void)0;",
+                        "loc_00000002: ;"], body
+
+
+def test_a_goto_into_a_join_through_memory_writes_back_on_its_edge():
+    lines = _wrap(["    fp_push(MEMF(0x2000));",
+                   "    if (eax) goto loc_00000001;",
+                   "    fp_pop();",
+                   "loc_00000001: ;",
+                   "    fp_push(2.0);",
+                   "    MEMF_SET(0x14, (float)fp_top()); fp_pop();",
+                   "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert why is None, why
+    body = [l.strip() for l in out[out.index(FP_STACK_MACROS[-1]) + 3:]]
+    assert body[2] == ("if (eax) { g_fp_stack[(_x87t + 7u) & 7u] = _x87sm1;"
+                       " g_fp_top = (int)((_x87t + 7u) & 7u); goto loc_00000001; }"), body
+    # the fall-through popped: g_fp_top is where it was and the slot is empty,
+    # so it has nothing to write back
+    assert body[3:5] == ["(void)0;", "loc_00000001: ;"], body
+    assert body[4:7] == ["loc_00000001: ;",
+                         "/* x87: paths join here at different depths; memory is current */",
+                         "_X87_LOAD();"], body
+
+
+def test_a_push_that_may_not_happen_runs_on_memory():
+    lines = _wrap(["    fp_push(MEMF(0x2000));",
+                   "    if (eax) fp_push(1.0);",
+                   "    return;"])
+    out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS)
+    assert why is None, why
+    text = "\n".join(out)
+    cond = text.index("if (eax) fp_push(1.0);")
+    assert "x87 state to memory" in text[:cond].splitlines()[-2], text
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_"):
+            fn()
+    print("ok")
