diff --git a/tools/recomp/test_x87_status.py b/tools/recomp/test_x87_status.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_x87_status.py
@@ -0,0 +1,61 @@
+"""sahf reads AH; fprem and the transcendentals write C2.
+
+The CRT's argument reduction is `fprem1; fnstsw ax; sahf; jp again`. With the
+conditions after sahf answered from the last compare, and fprem leaving the
+condition codes alone, an unordered compare earlier in the thread made the
+loop spin forever.
+"""
+
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _block(*insns):
+    out = []
+    addr = 0x00011000
+    for m, op_str, ops in insns:
+        i = Instruction(addr, 2, m, op_str, "0000")
+        i.operands = ops
+        out.append(i)
+        addr += 2
+    lines, _ = lift_basic_block(Lifter(), BasicBlock(start=0x00011000, instructions=out))
+    return "\n".join(lines)
+
+
+def _reg(r):
+    return Operand(type="reg", reg=r)
+
+
+class SahfTest(unittest.TestCase):
+    def test_sahf_snapshots_ah_and_jp_reads_its_parity_bit(self):
+        c = _block(("fnstsw", "ax", [_reg("ax")]), ("sahf", "", []),
+                   ("setp", "cl", [_reg("cl")]))
+        self.assertIn("_sahf = (eax >> 8) & 0xFFu;", c)
+        self.assertIn("(_sahf & 0x04u)", c)
+        self.assertNotIn("g_fp_cmp", c)
+
+    def test_the_unsigned_conditions_read_cf_and_zf(self):
+        c = _block(("sahf", "", []), ("seta", "cl", [_reg("cl")]),
+                   ("setb", "dl", [_reg("dl")]), ("sete", "al", [_reg("al")]))
+        self.assertIn("!(_sahf & 0x41u)", c)
+        self.assertIn("(_sahf & 0x01u)", c)
+        self.assertIn("(_sahf & 0x40u)", c)
+
+
+class StatusWritersTest(unittest.TestCase):
+    def test_fprem_writes_the_condition_codes(self):
+        for m, near in (("fprem", "0"), ("fprem1", "1")):
+            lifted = " ".join(Lifter().lift_instruction(Instruction(0x00011000, 2, m, "", "d9f8")))
+            self.assertIn(f"g_fp_cc = recomp_fprem_cc(fp_top(), fp_st1(), {near});", lifted)
+
+    def test_the_transcendentals_report_their_range_in_c2(self):
+        for m in ("fsin", "fcos", "fsincos", "fptan"):
+            lifted = " ".join(Lifter().lift_instruction(Instruction(0x00011000, 2, m, "", "d9fe")))
+            self.assertIn("g_fp_cc &= (uint16_t)~0x0400u;", lifted, m)
+            self.assertIn("g_fp_cc |= 0x0400u;", lifted, m)
+
+
+if __name__ == "__main__":
+    unittest.main()
