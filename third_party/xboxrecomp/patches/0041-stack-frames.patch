+class Frames:
+    """The frames the walk follows beyond its own (each off by default):
+    icall (--stack-icall): an indirect call that the caller does not clean
+    up after (RECOMP_ICALL_SAFE, not _CC) leaves esp where its arguments
+    started (_icall_esp), as its callee cleaning them would; the function
+    is taken only if every return then finds esp at its return address
+    (`esp += K; return` with esp K above the entry) and nothing sets esp
+    from elsewhere before, else it is walked again without; align
+    (--stack-align): `and esp, -2^k` starts a second base (the slots below
+    the aligned esp), ALIGN_GAP below the entry's names, and no access may
+    land between the two; probes (--stack-alloca): the alloca probes
+    (alloca_probes) a call to which with a constant eax moves esp by -eax."""
+
+    def __init__(self, icall=False, align=False, probes=()):
+        self.icall, self.align, self.probes = icall, align, frozenset(probes)
+
+    def without_icall(self):
+        return Frames(False, self.align, self.probes)
+
+
+_Frames = Frames
+# How far below the entry's slot names the slots of an aligned frame are named.
+ALIGN_GAP = 0x1000000
+
+# The alloca probe as MSVC's CRT has it for the Xbox (_alloca_probe, 16
+# bytes): test eax, eax; je ret; neg eax; add eax, esp; add eax, 4; xchg
+# eax, esp; mov eax, [eax]; push eax; ret -- esp drops by eax over the call.
+_PROBE = [r"if \(CMP_EQ\(_fa, _fb\)\) goto (\w+)", r"eax = \(uint32_t\)\((?:-\(int32_t\)eax|0u - \(uint32_t\)\(eax\))\)",
+          r"eax = eax \+ esp", r"eax = eax \+ 4", r"\{ uint32_t _tmp = esp", r"esp = eax",
+          r"eax = _tmp; \}", r"eax = MEM32\(eax\)", r"PUSH32\(esp, eax\)", r"esp \+= 4; return"]
+_SKIP = ("_fa ", "_fb ", "_fas ", "_fbs ", "_cf ", "int _flags", "uint32_t _fa", "int32_t _fas", "(void)_fa", "*",
+         "/*", "void ")
+
+
+def alloca_probes(functions):
+    """The names of the functions whose body is the alloca probe above
+    (`test eax, eax` first: only its flag temporaries), the je to its ret."""
+    out = set()
+    for name, lines in functions.items():
+        body, label, ret_label = [], None, None
+        for line in lines:
+            t = re.sub(r"/\*.*?\*/", "", line).strip()
+            if t in ("{", "}") or not t or t.startswith(_SKIP):
+                continue
+            m = re.fullmatch(r"(\w+):\s*;", t)
+            if m:
+                label = m.group(1)
+                continue
+            t = t.rstrip(";").strip()
+            if t == "esp += 4; return":
+                ret_label = label
+            body.append(t)
+            if len(body) > len(_PROBE):
+                break
+        if len(body) != len(_PROBE):
+            continue
+        ms = [re.fullmatch(r, b) for r, b in zip(_PROBE, body)]
+        if all(ms) and ms[0].group(1) == ret_label:
+            out.add(name)
+    return out
+
+
