+
+
+def test_a_store_through_an_inherited_frame_into_a_callees_frame_is_caught():
+    # f0 (frame): push ebp; mov ebp, esp; mov ebx, 7; call f1; mov [0x2000], ebx; leave; ret
+    # f1 (frameless): push ebx; mov ebx, 7; call f2; pop ebx; ret
+    # f2 (frameless): mov [ebp-8], eax -- f0's ebp-8 is f1's saved ebx
+    (s0, s1, s2), t, pend, names = _summaries([
+        [PUSH_EBP, MOV_EBP_ESP, MOV_EBX_7, _call(1), STORE_EBX, LEAVE, RET],
+        [PUSH_EBX, MOV_EBX_7, _call(2), POP_EBX, RET],
+        [b"\x89\x45\xF8", RET],
