diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -614,9 +614,39 @@
     # 16-bit result. Sign tests read _fas, the same snapshot sign-extended.
     slhs = "_fas" if lhs == "_fa" else f"(int32_t){lhs}"
 
-    # ── FPU compare-to-EFLAGS and sahf: no standard operands ──
+    # ── sahf: the flags are AH, as sahf found it ──
+    #
+    # sahf copies AH bits 7, 6, 2 and 0 into SF, ZF, PF and CF. The lift
+    # snapshots AH into _sahf, and the condition reads those bits. It used to
+    # answer from g_fp_cmp, the last x87 compare, on the assumption that AH
+    # always came from `fnstsw ax` straight after one -- but the status word
+    # also carries what fprem, fxam and the transcendentals report, and
+    # CRT's own reduction loop is `fprem1; fnstsw ax; sahf; jp again`: C2
+    # (PF) says the reduction is incomplete. Read from g_fp_cmp, that loop
+    # spun forever whenever the thread's last compare had been unordered.
+    # OF is not touched by sahf, so the signed conditions are not answered.
+    if flag_setter == "sahf":
+        sahf_map = {
+            "ja": "!(_sahf & 0x41u)", "jnbe": "!(_sahf & 0x41u)",
+            "jae": "!(_sahf & 0x01u)", "jnb": "!(_sahf & 0x01u)",
+            "jnc": "!(_sahf & 0x01u)",
+            "jb": "(_sahf & 0x01u)", "jnae": "(_sahf & 0x01u)",
+            "jc": "(_sahf & 0x01u)",
+            "jbe": "(_sahf & 0x41u)", "jna": "(_sahf & 0x41u)",
+            "je": "(_sahf & 0x40u)", "jz": "(_sahf & 0x40u)",
+            "jne": "!(_sahf & 0x40u)", "jnz": "!(_sahf & 0x40u)",
+            "jp": "(_sahf & 0x04u)", "jpe": "(_sahf & 0x04u)",
+            "jnp": "!(_sahf & 0x04u)", "jpo": "!(_sahf & 0x04u)",
+            "js": "(_sahf & 0x80u)", "jns": "!(_sahf & 0x80u)",
+        }
+        expr = sahf_map.get(jcc)
+        if expr:
+            return f"{expr} /* sahf */", desc
+        return None
+
+    # ── FPU compare-to-EFLAGS: no standard operands ──
     if flag_setter in ("fcompi", "fcomip", "fucomi", "fucompi",
-                        "fucomip", "fcomi", "sahf"):
+                        "fucomip", "fcomi"):
         # g_fp_cmp is -1 less, 0 equal, 1 greater, 2 unordered. An
         # unordered compare sets ZF, PF and CF all three, so it reads as
         # below AND equal AND parity. Comparing g_fp_cmp against 0 made 2 look
@@ -1675,7 +1705,8 @@
         if m == "lahf":
             return ["/* lahf - load AH from flags (used in FPU compare idiom) */"]
         if m == "sahf":
-            return ["/* sahf - store AH to flags */"]
+            # The flags are AH's bits; the conditions read this snapshot.
+            return ["_sahf = (eax >> 8) & 0xFFu; /* sahf */"]
         if m == "shld":
             return self._lift_shld(insn, ops)
         if m == "shrd":
@@ -3862,19 +3893,31 @@
         # These are exact-enough mappings onto libm. The 80-bit intermediates of
         # real x87 are not reproduced -- fp_stack is double -- which is the same
         # approximation every other op here already makes.
-        if m == "fsin":
-            return [f"fp_top() = sin(fp_top()); /* fsin */"]
-        if m == "fcos":
-            return [f"fp_top() = cos(fp_top()); /* fcos */"]
+        #
+        # fsin, fcos, fsincos and fptan take |st0| < 2^63 only: then they clear
+        # C2; beyond it they leave st0 alone and set C2, and the caller reduces
+        # the argument (fprem against 2pi) and tries again. C2 was never
+        # written, so a caller testing it read the last compare's. NaN and the
+        # infinities go through libm (a NaN, as the hardware's masked invalid
+        # gives) with C2 clear.
+        trig_ok = "(fabs(_a) < 0x1p63 || !(fabs(_a) <= 0x1.fffffffffffffp1023))"
+        if m in ("fsin", "fcos"):
+            return [f"{{ double _a = fp_top(); if ({trig_ok}) {{ fp_top() = {m[1:]}(_a);"
+                    f" g_fp_cc &= (uint16_t)~0x0400u; }} else g_fp_cc |= 0x0400u; }} /* {m} */"]
         if m == "fsincos":
             # Replaces st0 with sin, then pushes cos. Order matters: the push
             # must see the sine already stored.
-            return [f"{{ double _a = fp_top(); fp_top() = sin(_a);"
-                    f" fp_push(cos(_a)); }} /* fsincos */"]
+            return [f"{{ double _a = fp_top(); if ({trig_ok}) {{ fp_top() = sin(_a);"
+                    f" fp_push(cos(_a)); g_fp_cc &= (uint16_t)~0x0400u; }}"
+                    f" else g_fp_cc |= 0x0400u; }} /* fsincos */"]
         if m == "fptan":
             # st0 = tan(st0), then push 1.0. The constant push is not decoration:
-            # callers use it as the denominator of a subsequent fdiv.
-            return [f"{{ fp_top() = tan(fp_top()); fp_push(1.0); }} /* fptan */"]
+            # callers use it as the denominator of a subsequent fdiv. A NaN or
+            # infinite argument pushes the NaN instead, as the hardware does.
+            return [f"{{ double _a = fp_top(); if ({trig_ok}) {{ double _t = tan(_a);"
+                    f" fp_top() = _t; fp_push(_t == _t ? 1.0 : _t);"
+                    f" g_fp_cc &= (uint16_t)~0x0400u; }}"
+                    f" else g_fp_cc |= 0x0400u; }} /* fptan */"]
         if m == "fpatan":
             # st1 = atan2(st1, st0), pop. Argument order is st1 over st0.
             return [f"{{ fp_st1() = atan2(fp_st1(), fp_top()); fp_pop(); }}"
@@ -3889,11 +3932,19 @@
         if m == "f2xm1":
             return [f"fp_top() = exp2(fp_top()) - 1.0; /* f2xm1 */"]
         if m in ("fprem", "fprem1"):
-            # Both leave the remainder in st0 and clear C2 to say "complete".
-            # fprem truncates toward zero, fprem1 rounds to nearest (IEEE), which
-            # is the difference between fmod and remainder.
+            # Both leave the remainder in st0, clear C2 to say "complete", and
+            # put the quotient's three low bits in C0, C3 and C1. fprem
+            # truncates toward zero, fprem1 rounds to nearest (IEEE), which is
+            # the difference between fmod and remainder. The status word was
+            # left alone, so the CRT's `fprem1; fnstsw ax; sahf; jp again`
+            # read whatever C2 the last compare had left -- set, after an
+            # unordered one, which made it loop forever. One call does the
+            # whole reduction (the hardware may stop partway, with C2 set, when
+            # the exponents are more than 63 apart), so C2 is always 0 here.
             fn = "fmod" if m == "fprem" else "remainder"
-            return [f"fp_top() = {fn}(fp_top(), fp_st1()); /* {m} */"]
