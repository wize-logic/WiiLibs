diff --git a/tools/recomp/test_integer_width_flags.py b/tools/recomp/test_integer_width_flags.py
new file mode 100644
index 0000000..cb536a0
--- /dev/null
+++ b/tools/recomp/test_integer_width_flags.py
@@ -0,0 +1,107 @@
+"""Operand widths and flags of the integer multiply, divide, sub, add, neg and shifts.
+
+One-operand mul/imul/div/idiv were lifted as the dword forms at every width;
+mul's CF/OF were never published; the signed conditions after a narrow sub
+compared at 32 bits and after add/neg ignored OF; and a shift by zero
+published a new result snapshot although it leaves the flags alone.
+"""
+
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _reg(r):
+    return Operand(type="reg", reg=r)
+
+
+def _imm(v):
+    return Operand(type="imm", imm=v)
+
+
+def _insn(m, ops):
+    i = Instruction(0x00011000, 2, m, "", "0000")
+    i.operands = ops
+    return i
+
+
+def _lift(m, ops):
+    return "\n".join(Lifter().lift_instruction(_insn(m, ops)))
+
+
+def _block(*insns):
+    out = []
+    addr = 0x00011000
+    for m, ops in insns:
+        i = Instruction(addr, 2, m, "", "0000")
+        i.operands = ops
+        out.append(i)
+        addr += 2
+    lines, _ = lift_basic_block(Lifter(), BasicBlock(start=0x00011000, instructions=out))
+    return "\n".join(lines)
+
+
+class MulDivWidthTest(unittest.TestCase):
+    def test_byte_mul_writes_ax_only(self):
+        c = _lift("mul", [_reg("cl")])
+        self.assertIn("SET_LO16(eax, _r)", c)
+        self.assertNotIn("edx =", c)
+
+    def test_word_div_divides_dx_ax(self):
+        c = _lift("div", [_reg("cx")])
+        self.assertIn("<< 16", c)
+        self.assertIn("SET_LO16(edx,", c)
+
+    def test_dword_div_reads_the_divisor_once_and_has_a_32_bit_path(self):
+        c = _lift("div", [_reg("eax")])
+        self.assertIn("uint32_t _d = (uint32_t)(eax);", c)
+        self.assertIn("if (edx == 0)", c)
+
+
+class MulFlagsTest(unittest.TestCase):
+    def test_jo_after_mul_reads_the_published_overflow(self):
+        c = _block(("mul", [_reg("ecx")]), ("seto", [_reg("al")]))
+        self.assertIn("_fb = (uint32_t)(edx != 0);", c)
+        self.assertIn("(_fb != 0)", c)
+
+    def test_two_operand_imul_multiplies_unsigned(self):
+        c = _lift("imul", [_reg("eax"), _reg("ecx")])
+        self.assertIn("(uint32_t)(eax) * (uint32_t)(ecx)", c)
+        self.assertNotIn("(int32_t)eax * (int32_t)", c)
+
+
+class SignedConditionTest(unittest.TestCase):
+    def test_narrow_sub_compares_at_its_width(self):
+        c = _block(("sub", [_reg("al"), _reg("cl")]), ("setl", [_reg("dl")]))
+        self.assertIn("CMP_L((uint8_t)((uint32_t)_fa + (uint32_t)_fb), (uint8_t)_fb)", c)
+
+    def test_add_jl_takes_the_exact_sum(self):
+        c = _block(("add", [_reg("eax"), _reg("ecx")]), ("setl", [_reg("dl")]))
+        self.assertIn("(int64_t)", c)
+        self.assertIn("< 0)", c)
+
+    def test_neg_jl_compares_zero_with_the_operand(self):
+        c = _block(("neg", [_reg("eax")]), ("setl", [_reg("dl")]))
+        self.assertIn("0u - (uint32_t)_fa", c)
+
+
+class ShiftZeroTest(unittest.TestCase):
+    def test_variable_count_snapshot_is_guarded(self):
+        c = _lift("shl", [_reg("eax"), _reg("cl")])
+        self.assertIn("if (((LO8(ecx)) & 31u)) { _fa =", c)
+
+    def test_variable_count_carries_the_previous_zf_and_sf(self):
+        c = _block(("cmp", [_reg("ecx"), _imm(7)]), ("shl", [_reg("eax"), _reg("cl")]),
+                   ("sete", [_reg("dl")]))
+        self.assertIn("int _zf0 = (CMP_EQ(_fa, _fb)) != 0", c)
+        self.assertIn("else { _fa = _zf0 ? 0u : 1u;", c)
+
+    def test_constant_zero_count_keeps_the_previous_setter(self):
+        c = _block(("cmp", [_reg("ecx"), _imm(7)]), ("shl", [_reg("eax"), _imm(0)]),
+                   ("sete", [_reg("dl")]))
+        self.assertIn("_fa == _fb", c.replace("CMP_EQ(_fa, _fb)", "_fa == _fb"))
+
+
+if __name__ == "__main__":
+    unittest.main()
