From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Wed, 21 Oct 2026 13:58:25 -0400
Subject: [PATCH] lifter: movsx r32, bp/sp sign-extends

Upstream's facb626 ("lifter: movsx r32, bp/sp sign-extends", in v0.15.0),
taken as it is, with a conformance case added.

The register list for a 16-bit movsx source named ax/bx/cx/dx/si/di but
not bp/sp, so `movsx eax, bp` lifted as a zero-extend: a negative 16-bit
value read as a large positive one. movzx already listed both. MSVC keeps a
16-bit local in bp when it runs out of registers; Halo's .text holds 213
`movsx r32, bp`.

The conformance case movsx_bp_32 runs `movsx eax, bp` on the CPU; before
the fix every input with bit 15 set differs (eax 0x00008000 for
0xFFFF8000).

This patch is upstream's commit plus that case: at the sync to v0.15.0 or
later it no longer applies, and only the case is left to keep.
---
 tools/conformance/cases.py              |  4 +++
 tools/recomp/lifter.py                  |  5 +++-
 tools/recomp/test_lifter_movsx_reg16.py | 40 +++++++++++++++++++++++++
 3 files changed, 48 insertions(+), 1 deletion(-)
 create mode 100644 tools/recomp/test_lifter_movsx_reg16.py

diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
index 30e4955..7d3bfc0 100644
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -185,6 +185,10 @@ CASES = [
          ["movsx eax, al"], _PAIRS),
     Case("movsx_16_32", "sign-extend word to dword",
          ["movsx eax, ax"], _PAIRS),
+    # bp as the source: MSVC keeps a 16-bit local in ebp when it runs out of
+    # registers. ebp is saved around it, as the native side's frame needs it.
+    Case("movsx_bp_32", "sign-extend bp to dword",
+         ["push ebp", "mov ebp, eax", "xor eax, eax", "movsx eax, bp", "pop ebp"], _PAIRS),
     Case("movzx_8_32", "zero-extend byte to dword",
          ["movzx eax, al"], _PAIRS),
     # Divisor forced odd and positive: idiv raises #DE both on a zero divisor
diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index 1e914c5..c23bc1c 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -2079,7 +2079,10 @@ class Lifter:
             r = ops[1].reg
             if r in ("al", "bl", "cl", "dl", "ah", "bh", "ch", "dh"):
                 src = f"SX8({src})"
-            elif r in ("ax", "bx", "cx", "dx", "si", "di"):
+            # bp and sp too: without them `movsx eax, bp` read LO16(ebp)
+            # zero-extended, so a negative 16-bit value read as a large
+            # positive one.
+            elif r in ("ax", "bx", "cx", "dx", "si", "di", "bp", "sp"):
                 src = f"SX16({src})"
         return [_fmt_operand_write(ops[0], src)]
 
diff --git a/tools/recomp/test_lifter_movsx_reg16.py b/tools/recomp/test_lifter_movsx_reg16.py
new file mode 100644
index 0000000..b3750f8
--- /dev/null
+++ b/tools/recomp/test_lifter_movsx_reg16.py
@@ -0,0 +1,40 @@
+"""movsx r32, r16 sign-extends every 16-bit register source.
+
+`bp` and `sp` were missing from the register list, so `movsx eax, bp` was
+lifted as a plain zero-extending read of LO16(ebp). A title that normalises
+a signed 16-bit value (an analog stick axis, say) through that instruction
+then reads a negative value as a large positive one.
+"""
+
+import pytest
+
+from tools.recomp.disasm import Instruction, Operand
+from tools.recomp.lifter import Lifter
+
+
+def _insn(mnemonic, reg):
+    ops = [Operand(type="reg", reg="eax"), Operand(type="reg", reg=reg)]
+    return Instruction(0x1000, 3, mnemonic, f"eax, {reg}", "", operands=ops)
+
+
+@pytest.mark.parametrize("reg, full", [
+    ("bp", "ebp"),
+    ("sp", "esp"),
+    ("si", "esi"),
+    ("di", "edi"),
+    ("ax", "eax"),
+])
+def test_movsx_r32_r16_sign_extends(reg, full):
+    insn = _insn("movsx", reg)
+
+    assert Lifter().lift_instruction(insn) == [f"eax = SX16(LO16({full}));"]
+
+
+@pytest.mark.parametrize("reg, full", [
+    ("bp", "ebp"),
+    ("sp", "esp"),
+])
+def test_movzx_r32_r16_still_zero_extends(reg, full):
+    insn = _insn("movzx", reg)
+
+    assert Lifter().lift_instruction(insn) == [f"eax = ZX16(LO16({full}));"]
