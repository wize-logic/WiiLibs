+"""
+--keep-preserved: the registers a callee gives back stay in the caller's locals.
+
+preserve.py proves, over the whole program, which generated functions return
+ebx, esi and edi as they found them; x87_locals.py then skips loading those
+locals again after a plain call to one. These checks lift small x86
+functions and look at both: the summaries (what is proven and what is not),
+and the code a caller gets.
+"""
+
+import os
+import re
+import struct
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import config, preserve  # noqa: E402
+from tools.recomp.translator import FunctionTranslator, Pending  # noqa: E402
+
+BASE = 0x00010000
+
+
+def _call(i):
+    return ("call", i)
+
+
+def _lift(funcs):
+    """funcs: one list of parts per function, each part bytes or _call(index).
+    Returns (translator, {index: Pending}, names)."""
+    sizes = [sum(5 if isinstance(p, tuple) else len(p) for p in f) for f in funcs]
+    starts = [sum(sizes[:i]) for i in range(len(funcs))]
+    image = b""
+    for f in funcs:
+        for p in f:
+            if isinstance(p, tuple):
+                image += b"\xE8" + struct.pack("<i", starts[p[1]] - (len(image) + 5))
+            else:
+                image += p
+    config._install(
+        [config.Section(".text", BASE, len(image), 0x0000, len(image), True)],
+        entry_point=BASE, kernel_thunk_addr=BASE, origin="preserve-test")
+    db = {}
+    for start, size in zip(starts, sizes):
+        db[BASE + start] = {"start": f"0x{BASE + start:08X}", "end": BASE + start + size,
+                            "_addr": BASE + start, "size": size}
+    t = FunctionTranslator(image, db)
+    t.x87_locals = t.reg_locals = t.keep_preserved = True
+    pend = {i: t.translate_function(BASE + s, db[BASE + s]) for i, s in enumerate(starts)}
+    assert all(isinstance(p, Pending) for p in pend.values())
+    return t, pend, ["sub_%08X" % (BASE + s) for s in starts]
+
+
+def _summaries(funcs):
+    t, pend, names = _lift(funcs)
+    s = preserve.analyse({names[i]: p.lines for i, p in pend.items()})
+    return [s[n] for n in names], t, pend, names
+
+
+def _finish(t, pend, names, summaries, i):
+    t.kept = preserve.preserved_by_name(dict(zip(names, summaries)))
+    return t.finish_function(pend[i].lines, pend[i].has_fpu)
+
+
+RET = b"\xC3"
+PUSH_ESI, POP_ESI = b"\x56", b"\x5E"
+PUSH_EBX, POP_EBX = b"\x53", b"\x5B"
+PUSH_EBP, POP_EBP = b"\x55", b"\x5D"
+MOV_EBP_ESP, LEAVE = b"\x8B\xEC", b"\xC9"
+MOV_ESI_5 = b"\xBE\x05\x00\x00\x00"
+MOV_EBX_7 = b"\xBB\x07\x00\x00\x00"
+STORE_EBX = b"\x89\x1D\x00\x20\x00\x00"     # mov [0x2000], ebx
+STORE_ESI = b"\x89\x35\x04\x20\x00\x00"     # mov [0x2004], esi
+LOAD_EAX = b"\xA1\x08\x20\x00\x00"          # mov eax, [0x2008]
+
+
+def test_a_saved_and_restored_register_is_preserved():
+    # push esi; mov esi, 5; mov [0x2004], esi; pop esi; ret
+    (s,), *_ = _summaries([[PUSH_ESI, MOV_ESI_5, STORE_ESI, POP_ESI, RET]])
+    assert s.preserved == {"ebx", "esi", "edi"}
+    assert s.delta == 4
+
+
+def test_a_callee_that_clobbers_a_callee_saved_register_does_not_preserve_it():
+    # mov ebx, 7; ret: ebx comes back changed
+    (s,), *_ = _summaries([[MOV_EBX_7, RET]])
+    assert s.preserved == {"esi", "edi"}
+
+
+def test_a_pop_into_another_register_does_not_restore():
+    # push esi; mov esi, 5; pop ebx; ret: esi changed, ebx gets esi's old value
+    (s,), *_ = _summaries([[PUSH_ESI, MOV_ESI_5, POP_EBX, RET]])
+    assert s.preserved == {"edi"}
+
+
+def test_a_store_over_the_saved_slot_loses_it():
+    # push esi; mov esi, 5; mov [esp], eax; pop esi; ret
+    (s,), *_ = _summaries([[PUSH_ESI, MOV_ESI_5, b"\x89\x04\x24", POP_ESI, RET]])
+    assert "esi" not in s.preserved
+    # a store next to it does not: mov [esp+4], eax hits the return address
+    (s,), *_ = _summaries([[PUSH_ESI, MOV_ESI_5, b"\x89\x44\x24\x04", POP_ESI, RET]])
+    assert "esi" in s.preserved
+
+
+def test_an_indirect_call_preserves_nothing():
+    # push esi; call [eax]; pop esi; ret: the target is unknown
+    (s,), *_ = _summaries([[PUSH_ESI, b"\xFF\x10", POP_ESI, RET]])
+    assert s.preserved == frozenset()
+    assert s.delta is None
+
+
+def test_preservation_follows_the_callees():
+    # f0: push esi; call f1; pop esi; ret (f1 clobbers ebx) -> f0 gives back esi, edi
+    # f2: call f3; ret (f3 preserves everything) -> f2 does too
+    (s0, s1, s2, s3), *_ = _summaries([
+        [PUSH_ESI, _call(1), POP_ESI, RET],
+        [MOV_EBX_7, RET],
+        [_call(3), RET],
+        [PUSH_EBX, MOV_EBX_7, POP_EBX, RET],
+    ])
+    assert s1.preserved == {"esi", "edi"}
+    assert s0.preserved == {"esi", "edi"}
+    assert s3.preserved == {"ebx", "esi", "edi"} and s2.preserved == {"ebx", "esi", "edi"}
+
+
+def test_stdcall_cleanup_moves_the_callers_esp():
+    # f0: push esi; push 1; push 2; call f1; pop esi; ret -- f1 is `ret 8`, so esi's slot is on top again
+    # f2: the same with f3 a `ret` (cdecl): the pop reads an argument, not the saved esi
+    (s0, s1, s2, s3), *_ = _summaries([
+        [PUSH_ESI, MOV_ESI_5, b"\x6A\x01\x6A\x02", _call(1), POP_ESI, RET],
+        [b"\xC2\x08\x00"],
+        [PUSH_ESI, MOV_ESI_5, b"\x6A\x01\x6A\x02", _call(3), POP_ESI, RET],
+        [RET],
+    ])
+    assert s1.delta == 12 and s3.delta == 4
+    assert "esi" in s0.preserved
+    assert "esi" not in s2.preserved
+
+
+def test_recursion_keeps_its_promise():
+    # push esi; mov esi, 5; mov eax, [0x2008]; test eax, eax; jz done; call self; done: pop esi; ret
+    (s,), *_ = _summaries([[PUSH_ESI, MOV_ESI_5, LOAD_EAX, b"\x85\xC0\x74\x05", _call(0), POP_ESI, RET]])
+    assert s.preserved == {"ebx", "esi", "edi"}
+
+
+def test_a_store_through_the_inherited_frame_reaches_the_callers_slot():
+    # f0 (frame): push ebp; mov ebp, esp; sub esp, 0xc; push ebx; mov ebx, 7; call f1; pop ebx; leave; ret
+    # ebx's slot is at ebp-0x10. f1 (frameless) stores at [ebp-0x10] of the frame it inherits;
+    # f2/f3 are the same with the store at [ebp-8], which is a local of f2's frame.
+    prologue = [PUSH_EBP, MOV_EBP_ESP, b"\x83\xEC\x0C", PUSH_EBX, MOV_EBX_7]
+    (s0, s1, s2, s3), *_ = _summaries([
+        prologue + [_call(1), POP_EBX, LEAVE, RET],
+        [b"\x89\x45\xF0", RET],
+        prologue + [_call(3), POP_EBX, LEAVE, RET],
+        [b"\x89\x45\xF8", RET],
+    ])
+    assert s1.isw == {-0x10} and s3.isw == {-8} and not s1.iw  # it starts from g_seh_ebp
+    assert "ebx" not in s0.preserved
+    assert "ebx" in s2.preserved and s2.delta == 4
+
+
+def test_the_caller_keeps_the_registers_a_callee_gives_back():
+    # f0: mov ebx, 7; mov esi, 5; call f1; mov [0x2000], ebx; mov [0x2004], esi; ret
+    # f1: mov esi, 5; ret -- gives back ebx and edi, not esi
+    sums, t, pend, names = _summaries([
+        [MOV_EBX_7, MOV_ESI_5, _call(1), STORE_EBX, STORE_ESI, RET],
+        [MOV_ESI_5, RET],
+    ])
+    text = _finish(t, pend, names, sums, 0)
+    after = text[text.index("RECOMP_ABI_CALL"):]
+    assert "ebx kept across the call" in after, text
+    assert "_r_ebx = g_ebx" not in after, text
+    assert "_r_esi = g_esi" in after, text
+    # without the summaries every register is loaded again
+    t.kept = {}
