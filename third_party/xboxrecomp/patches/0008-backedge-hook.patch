From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Mon, 12 Oct 2026 20:08:56 -0400
Subject: [PATCH] recomp: call RECOMP_BACKEDGE() before every backward jump

A loop that only polls memory that another thread or an interrupt writes
(a flip counter, a GPU fence word, a spin lock) makes no call a runtime can
break in at. Where the runtime runs guest threads under one lock, or can
deliver an interrupt only between guest operations it controls, such a loop
never ends: the thread that would change the word never gets to run.

Halo 2276's statically linked Direct3D has two of them, right after the first
AvSetDisplayMode: the flip throttle compares two device fields that the vblank
interrupt's DPC advances, and a wait reads a value the interrupt writes.
Neither reads a register or calls the kernel inside the loop.

The translator now writes `{ RECOMP_BACKEDGE(); goto loc_X; }` for every jump
whose target is at or before the block it is in (counted from the labels it
emits, after the dead-goto pass). The template defines RECOMP_BACKEDGE() as
nothing, so the generated code is unchanged for a runtime that does not need
it; a runtime defines it before including the header (for example as a check
of a flag it sets when another thread is waiting).
---
 templates/runtime/recomp_types.h          |  7 +++
 tools/recomp/test_lifter_backedge_hook.py | 64 +++++++++++++++++++++++
 tools/recomp/translator.py                | 22 ++++++++
 3 files changed, 93 insertions(+)
 create mode 100644 tools/recomp/test_lifter_backedge_hook.py

diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
index 0ea59fa..1fad7de 100644
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -422,6 +422,13 @@ void recomp_trace_esp(const char *name, const char *tag);
 #define RECOMP_TRACE_ESP(name, tag) recomp_trace_esp((name), (tag))
 
 
+/** Called before every backward jump (a loop's way back). Nothing here; a runtime whose guest
+ *  threads must give way to each other or to interrupts at loops that make no call defines it
+ *  before this header, e.g. as a check of a flag it sets when another thread is waiting. */
+#ifndef RECOMP_BACKEDGE
+#define RECOMP_BACKEDGE() ((void)0)
+#endif
+
 /* ================================================================
  * Memory access helpers
  * ================================================================ */
diff --git a/tools/recomp/test_lifter_backedge_hook.py b/tools/recomp/test_lifter_backedge_hook.py
new file mode 100644
index 0000000..e8af99d
--- /dev/null
+++ b/tools/recomp/test_lifter_backedge_hook.py
@@ -0,0 +1,64 @@
+"""
+Backward jumps call RECOMP_BACKEDGE() first.
+
+A loop that only polls memory written by another thread or by an interrupt (a
+flip counter, a fence, a spin lock) makes no call a runtime could break in at.
+When the runtime's guest threads take turns on one lock, or an interrupt can
+only be delivered between guest instructions the runtime controls, such a loop
+never ends. The hook before each back edge is that break-in point; the
+template defines it as nothing.
+"""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import config  # noqa: E402
+from tools.recomp.translator import FunctionTranslator  # noqa: E402
+
+BASE = 0x00010000
+
+
+def _translate(image):
+    config._install(
+        [config.Section(".text", BASE, len(image), 0x0000, len(image), True)],
+        entry_point=BASE, kernel_thunk_addr=BASE, origin="backedge-test")
+    db = {BASE: {"start": f"0x{BASE:08X}", "end": BASE + len(image),
+                 "_addr": BASE, "size": len(image)}}
+    return FunctionTranslator(image, db).translate_function(BASE, db[BASE])
+
+
+# +0  mov eax, [0x2000]      ; poll a word
+# +5  test eax, eax
+# +7  je +0 -> back to +0     (jz rel8 -9)
+# +9  jmp +2 -> +13 (forward)
+# +11 nop; nop
+# +13 ret
+def _poll_loop():
+    return (b"\xA1\x00\x20\x00\x00" b"\x85\xC0" b"\x74\xF7"
+            b"\xEB\x02" b"\x90\x90" b"\xC3")
+
+
+def test_a_backward_conditional_jump_calls_the_hook():
+    code = _translate(_poll_loop())
+    assert "{ RECOMP_BACKEDGE(); goto loc_00010000; }" in code, code
+
+
+def test_a_forward_jump_does_not():
+    code = _translate(_poll_loop())
+    assert "goto loc_0001000D;" in code, code
+    assert "RECOMP_BACKEDGE(); goto loc_0001000D;" not in code, code
+
+
+def test_a_jump_to_its_own_block_is_backward():
+    # +0 jmp +0 (an idle loop, EB FE), then ret
+    code = _translate(b"\xEB\xFE\xC3")
+    assert "{ RECOMP_BACKEDGE(); goto loc_00010000; }" in code, code
+
+
+if __name__ == "__main__":
+    test_a_backward_conditional_jump_calls_the_hook()
+    test_a_forward_jump_does_not()
+    test_a_jump_to_its_own_block_is_backward()
+    print("ok")
diff --git a/tools/recomp/translator.py b/tools/recomp/translator.py
index a41fff4..c98dca7 100644
--- a/tools/recomp/translator.py
+++ b/tools/recomp/translator.py
@@ -2593,6 +2593,28 @@ class FunctionTranslator:
                     f"goto {target};",
                     f"(void)0; /* goto {target} - dead code, label not in function */")
 
+        # Backward jumps call RECOMP_BACKEDGE() first. A loop that only polls memory another
+        # thread or an interrupt writes (a flip counter, a fence, a lock word) has no call in it
+        # for a runtime to break in at; the hook gives it one. The runtime header decides what it
+        # does (nothing in this template; a check of a "someone is waiting" flag in a runtime
+        # whose guest threads share one host thread or one lock). A jump is backward when its
+        # target is at or before the block it is in.
+        _cur_block = None
+        for _i, _line in enumerate(lines):
+            _m = re.match(r'^loc_([0-9A-Fa-f]{8}): ;', _line)
+            if _m:
+                _cur_block = int(_m.group(1), 16)
+                continue
+            if _cur_block is None or "goto loc_" not in _line:
+                continue
+
+            def _hook(_gm, _block=_cur_block):
+                if int(_gm.group(1), 16) <= _block:
+                    return "{ RECOMP_BACKEDGE(); goto loc_" + _gm.group(1) + "; }"
+                return _gm.group(0)
+
+            lines[_i] = re.sub(r'goto loc_([0-9A-Fa-f]{8});', _hook, _line)
+
         # Ensure labels at end of function have a statement after them.
         # In C, a label must be followed by a statement; a comment alone is not
         # enough.  Walk backwards from the end and if the last real content is a
