+def test_recursion_gets_its_esp_effect():
+    # push esi; mov eax, [0x2008]; test eax, eax; jz done; push eax; call self; done: pop esi; ret 4
+    (s,), *_ = _summaries([[PUSH_ESI, LOAD_EAX, b"\x85\xC0\x74\x06\x50", _call(0), POP_ESI,
