     def test_transcendentals_emit_statements_rather_than_comments(self):
         for mnemonic, expected in (
             ("fpatan", "atan2(fp_st1(), fp_top())"),
-            ("fsin", "sin(fp_top())"),
-            ("fcos", "cos(fp_top())"),
+            ("fsin", "fp_top() = sin(fp_top())"),
+            ("fcos", "fp_top() = cos(fp_top())"),
             ("frndint", "recomp_frndint(fp_top(), g_fp_control_word)"),
             ("fyl2x", "log2(fp_top())"),
         ):
@@ -76,8 +76,9 @@ class FpuReverseFormTest(unittest.TestCase):
                 self.assertNotIn("/* FPU:", lifted[0])
 
     def test_fptan_pushes_the_implicit_one(self):
-        """FPTAN leaves tan(x) and then 1.0 (NaN for a non-finite x)."""
-        self.assertIn("fp_push(isfinite(_a) ? 1.0 : _a - _a);", _lift("fptan", "", [])[0])
+        """FPTAN leaves tan(x) and then 1.0 on the stack (the NaN, for a NaN or
+        an infinity)."""
+        self.assertIn("fp_push(1.0 + (_t - _t));", _lift("fptan", "", [])[0])
 
 
 if __name__ == "__main__":
diff --git a/tools/recomp/test_x87_trig_depth.py b/tools/recomp/test_x87_trig_depth.py
new file mode 100644
index 0000000..bf30d7e
--- /dev/null
+++ b/tools/recomp/test_x87_trig_depth.py
@@ -0,0 +1,37 @@
+"""fsin, fcos, fsincos and fptan keep a static x87 stack depth.
+
+The hardware takes |st0| < 2^63 only and otherwise leaves st0 alone, pushes
+nothing and sets C2. Lifted that way, the push of fptan and fsincos is
+conditional, and the x87 locals pass (--x87-locals) gives up on a function
+whose stack depth is not static. libm reduces any argument exactly, so every
+argument is computed and C2 is cleared.
+"""
+
+import unittest
+
+from .lifter import Lifter
+from .disasm import Instruction
+
+
+class TranscendentalTest(unittest.TestCase):
+    def test_the_transcendentals_clear_c2_and_keep_a_static_depth(self):
+        for m in ("fsin", "fcos", "fsincos", "fptan"):
+            lifted = " ".join(Lifter().lift_instruction(Instruction(0x00011000, 2, m, "", "d9fe")))
+            self.assertIn("g_fp_cc &= (uint16_t)~0x0400u;", lifted, m)
+            self.assertNotIn("if (", lifted, m)  # no push or pop that may not happen
+
+    def test_the_x87_locals_pass_takes_them(self):
+        from .translator import FP_STACK_MACROS, FP_STACK_UNDEFS
+        from .x87_locals import localise_x87
+        for m in ("fsin", "fcos", "fsincos", "fptan"):
+            lifted = Lifter().lift_instruction(Instruction(0x00011000, 2, m, "", "d9fe"))
+            lines = (["void sub_00011000(void)", "{"] + FP_STACK_MACROS
+                     + ["    fp_push(MEMD(eax + 8));"] + ["    " + l for l in lifted]
+                     + ["    MEMD_SET(eax, fp_top()); fp_pop();", "    esp += 4; return;"]
+                     + FP_STACK_UNDEFS + ["}"])
+            _, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS, x87=True)
+            self.assertIsNone(why, m)
+
+
+if __name__ == "__main__":
+    unittest.main()
