     assert text.index("_LOCALS_LOAD();", call) < text.index("_r_ecx = _r_eax;"), text
 
 
+def test_sse_registers_live_in_locals():
+    # movaps xmm0, [esi]; addps xmm0, xmm1; movaps [edi], xmm0; ret
+    image = b"\x0F\x28\x06" b"\x0F\x58\xC1" b"\x0F\x29\x07" b"\xC3"
+    code, _ = _translate(image)
+    # xmm0 is assigned whole first: a local; xmm1 is read first: its global
+    assert "RecompXmm _r_xmm0 = { 0 };" in code and "_r_xmm1" not in code, code
+    body = code.split("#define _LOCALS_LOAD()")[1].split("\n", 1)[1]
+    assert "_r_xmm0 = XMM_ADD(_r_xmm0, xmm1);" in body, code
+    back = [l for l in body.splitlines() if "state to memory" in l][0]
+    # xmm0 was written; xmm1, esi and edi were only read (an XMM_* helper's operands are values)
+    assert "g_xmm0 = _r_xmm0;" in back, code
+    for r in ("xmm1", "esi", "edi"):
+        assert f"g_{r} = " not in back, code
+
+
+def test_simd_writes_through_a_lane_a_half_or_a_helper_count():
+    out, why = _localise(["    xmm1 = XMM_MEM(esi);", "    xmm2 = XMM_MEM(esi + 16);", "    xmm3 = xmm2;",
+                          "    mm0 = MMX_MEM(edi);", "    mm1 = mm0;", "    xmm4 = xmm1;",
+                          "    xmm1.f[0] = xmm1.f[0] + xmm2.f[0];", "    XMM_LOAD_HIGH(xmm3, esi + 8);",
+                          "    mm0 = MMX_PADDW(mm0, MMX_MEM(edi));", "    XMM_STORE_HIGH(edi + 8, xmm4);",
+                          "    MMX_STORE(edi, mm1);", "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    assert "_r_xmm1.f[0] = _r_xmm1.f[0] + _r_xmm2.f[0];" in text, text
+    assert "XMM_LOAD_HIGH(_r_xmm3, _r_esi + 8);" in text, text
+    assert "RecompMmx _r_mm0 = { 0 };" in text, text
+    back = [l for l in out if "state to memory" in l][0]
+    for r in ("xmm1", "xmm2", "xmm3", "xmm4", "mm0", "mm1"):
+        assert f"g_{r} = _r_{r};" in back, text
+    for r in ("esi", "edi"):
+        assert f"g_{r} = " not in back, text
+
+
+def test_simd_registers_a_body_first_reads_or_writes_in_part_stay_in_memory():
+    out, why = _localise(["    xmm2.f[0] = xmm0.f[0];", "    xmm1 = XMM_ADD(xmm1, xmm0);", "    xmm3 = xmm1;",
+                          "    eax = eax + 1;", "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    # xmm2 written in part, xmm0 and xmm1 read first: their globals; xmm3 assigned whole: a local
+    assert "    xmm2.f[0] = xmm0.f[0];" in text, text
+    assert "    xmm1 = XMM_ADD(xmm1, xmm0);" in text, text
+    assert "    _r_xmm3 = xmm1;" in text, text
+    assert "_r_xmm0" not in text and "_r_xmm1" not in text and "_r_xmm2" not in text, text
+    back = [l for l in out if "state to memory" in l][0]
+    assert "g_xmm3 = _r_xmm3;" in back and "g_eax = _r_eax;" in back, text
+
+
+def test_a_simd_register_whose_address_is_taken_runs_on_memory():
+    out, why = _localise(["    xmm0 = XMM_ZERO();", "    xmm1 = xmm0;", "    { RecompXmm *p = &xmm1; p->f[0] = 2.0f; }",
+                          "    xmm1 = XMM_ADD(xmm1, xmm0);", "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    i = text.index("{ RecompXmm *p = &xmm1; p->f[0] = 2.0f; }")
+    assert "g_xmm0 = _r_xmm0; g_xmm1 = _r_xmm1;" in text[:i].rstrip().splitlines()[-1], text
+    assert text.index("_LOCALS_LOAD();", i) < text.index("_r_xmm1 = XMM_ADD(_r_xmm1, _r_xmm0);"), text
+
+
 if __name__ == "__main__":
     for name, fn in sorted(globals().items()):
         if name.startswith("test_"):
