new file mode 100644
index 0000000..bb54f2f
--- /dev/null
+++ b/tools/recomp/test_stack_locals.py
@@ -0,0 +1,271 @@
+"""
+--stack-locals: a function's own stack slots in C locals (stack_locals.py).
+
+These checks lift small x86 functions (test_preserve's harness) and look at
+what the pass keeps in locals, what it must not (a slot reached through a
+pointer the pass cannot follow), and that the code computes what the memory
+model computes: guest memory, registers and esp after each function, compiled
+and run both ways.
+"""
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import preserve  # noqa: E402
+from tools.recomp.stack_locals import localise_stack  # noqa: E402
+from tools.recomp.test_preserve import _lift  # noqa: E402
+
+
+def _h(s):
+    return bytes.fromhex(s.replace(" ", ""))
+
+
+RET = _h("C3")
+SUB_ESP_10 = _h("83EC10")      # sub esp, 0x10
+ADD_ESP_10 = _h("83C410")      # add esp, 0x10
+ST_4_EAX = _h("89442404")      # mov [esp+4], eax
+LD_EDX_4 = _h("8B542404")      # mov edx, [esp+4]
+ST_EBX_ECX = _h("890B")        # mov [ebx], ecx
+ADD_4_EAX = _h("01442404")     # add [esp+4], eax
+ST_8_ECX = _h("894C2408")      # mov [esp+8], ecx
+LD_EAX_8 = _h("8B442408")      # mov eax, [esp+8]
+LEA_ECX_8 = _h("8D4C2408")     # lea ecx, [esp+8]
+ST_PECX_EDX = _h("8911")       # mov [ecx], edx
+ST_PECX_IDX = _h("891481")     # mov [ecx+eax*4], edx
+ST_G_ECX = _h("890D00200000")  # mov [0x2000], ecx
+LD_EAX_ARG = _h("8B442414")    # mov eax, [esp+0x14] (the first argument, after sub esp, 0x10)
+ST_ARG_EDX = _h("89542414")    # mov [esp+0x14], edx
+FLD_4 = _h("D9442404")         # fld dword [esp+4]
+FSTP_C = _h("D95C240C")        # fstp dword [esp+0xc]
+FLD_C = _h("D944240C")         # fld dword [esp+0xc]
+FSTP_G = _h("D91D04200000")    # fstp dword [0x2004]
+PUSH_EAX, PUSH_ECX = _h("50"), _h("51")
+ADD_ESP_4 = _h("83C404")
+DEC_ECX, JNZ_BACK = _h("49"), None
+
+
+def _call(i):
+    return ("call", i)
+
+
+def _run_pass(funcs):
+    t, pend, names = _lift(funcs)
+    s = preserve.analyse({names[i]: p.lines for i, p in pend.items()})
+    kept = preserve.preserved_by_name(s)
+    out = {}
+    for i, n in enumerate(names):
+        out[n] = localise_stack(pend[i].lines, s, kept)
+    return t, pend, names, out
+
+
+def _body(lines):
+    return "\n".join(lines)
+
+
+def test_a_spill_in_a_leaf_stays_in_a_local():
+    # sub esp,0x10; mov [esp+4],eax; mov [ebx],ecx; mov edx,[esp+4]; add [esp+4],eax;
+    # mov eax,[esp+4]... : the slot at entry - 0xc, never read by anyone else
+    f = [SUB_ESP_10, ST_4_EAX, ST_EBX_ECX, LD_EDX_4, ADD_4_EAX, LD_EDX_4, ADD_ESP_10, RET]
+    _, _, names, out = _run_pass([f])
+    lines, why, n_slots, n_acc = out[names[0]]
+    assert why is None, why
+    assert n_slots == 1 and n_acc >= 4
+    text = _body(lines)
+    assert "MEM32(ebx) = ecx;" in text            # the store through a pointer stays
+    assert "_sl_mc = eax;" in text and "edx = _sl_mc;" in text
+    assert "_sl_mc = _sl_mc + eax;" in text
+    # a slot below the entry esp is not written back at the return
+    assert not re.search(r"MEM32\(esp[^)]*\)\s*=\s*_sl_mc", text), text
+
+
+def test_a_slot_written_before_a_call_goes_to_memory_and_back():
+    # caller: sub esp,0x10; mov [esp+8],ecx; push eax; call f1; add esp,4; mov eax,[esp+8]; add esp,0x10; ret
+    caller = [SUB_ESP_10, ST_8_ECX, ST_4_EAX, PUSH_EAX, _call(1), ADD_ESP_4, LD_EAX_8, LD_EDX_4, LD_EAX_8,
+              LD_EDX_4, ADD_ESP_10, RET]
+    leaf = [_h("8B442404"), RET]  # mov eax, [esp+4]
+    _, _, names, out = _run_pass([caller, leaf])
+    lines, why, n_slots, _ = out[names[0]]
+    assert why is None, why
+    text = _body(lines)
+    i_call = text.index("RECOMP_ABI_CALL")
+    flush = text.rfind("/* the slots written since, to memory */", 0, i_call)
+    assert flush > 0 and "_sl_m8" in text[text.rfind("\n", 0, flush):flush], text
+    assert "/* and back */" in text[i_call:]
+    # the argument push stays a push
+    assert "PUSH32(esp, eax);" in text
+
+
+def test_an_argument_written_goes_back_at_the_return():
+    # sub esp,0x10; mov eax,[esp+0x14]; mov [esp+0x14],edx; mov eax,[esp+0x14]; add esp,0x10; ret
+    f = [SUB_ESP_10, LD_EAX_ARG, ST_ARG_EDX, LD_EAX_ARG, ADD_ESP_10, RET]
+    _, _, names, out = _run_pass([f])
+    lines, why, _, _ = out[names[0]]
+    assert why is None, why
+    text = _body(lines)
+    assert re.search(r"MEM32\(esp \+ 0x4\) = _sl_4; /\* the slots written since, to memory \*/", text), text
+
+
+def test_a_slot_reached_through_its_address_is_followed():
+    # lea ecx,[esp+8]; mov [ecx],edx; mov eax,[esp+8]: the store through ecx is the slot's
+    f = [SUB_ESP_10, LEA_ECX_8, ST_PECX_EDX, LD_EAX_8, LD_EAX_8, ADD_ESP_10, RET]
+    _, _, names, out = _run_pass([f])
+    lines, why, n_slots, n_acc = out[names[0]]
+    assert why is None, why
+    text = _body(lines)
+    assert "_sl_m8 = edx;" in text and "eax = _sl_m8;" in text, text
+
+
+def test_an_indexed_access_through_a_frame_address_keeps_memory():
+    # lea ecx,[esp+8]; mov [ecx+eax*4],edx: a local array; nothing is kept
+    f = [SUB_ESP_10, LEA_ECX_8, ST_PECX_IDX, LD_EAX_8, LD_EAX_8, ADD_ESP_10, RET]
+    _, pend, names, out = _run_pass([f])
+    lines, why, _, _ = out[names[0]]
+    assert why is not None and "offset is not known" in why, why
+    assert lines == pend[0].lines
+
+
+def test_a_frame_address_stored_outside_the_frame_keeps_memory():
+    # lea ecx,[esp+8]; mov [0x2000],ecx: anyone may write the slot through the global
+    f = [SUB_ESP_10, LEA_ECX_8, ST_G_ECX, ST_8_ECX, LD_EAX_8, LD_EAX_8, ADD_ESP_10, RET]
+    _, _, names, out = _run_pass([f])
+    _, why, _, _ = out[names[0]]
+    assert why is not None and "stored outside the frame" in why, why
+
+
+def test_a_pointer_returned_by_a_callee_given_a_frame_address_is_not_followed():
+    # lea ecx,[esp+8]; push ecx; call f1; add esp,4; mov [eax],edx; mov eax,[esp+8]...:
+    # f1 may return the address it was given; the store through eax may be the slot's
+    caller = [SUB_ESP_10, ST_8_ECX, LEA_ECX_8, PUSH_ECX, _call(1), ADD_ESP_4, _h("8910"), LD_EAX_8, LD_EAX_8,
+              ADD_ESP_10, RET]
+    leaf = [_h("8B442404"), RET]  # mov eax, [esp+4]: returns its argument
+    _, _, names, out = _run_pass([caller, leaf])
+    _, why, _, _ = out[names[0]]
+    assert why is not None and "offset is not known" in why, why
+
+
+def test_a_signed_store_writes_the_local():
+    # fild dword [esp+8]; fistp dword [esp+8]; mov eax,[esp+8] (twice): the store is an lvalue
+    f = [SUB_ESP_10, ST_8_ECX, _h("DB442408"), _h("DB5C2408"), LD_EAX_8, LD_EAX_8, ADD_ESP_10, RET]
+    _, _, names, out = _run_pass([f])
+    lines, why, _, _ = out[names[0]]
+    assert why is None, why
+    assert not re.search(r"\(\(int32_t\)_sl_m8\)\s*=", _body(lines)), _body(lines)
+
+
+# ------------------------------------------------------------ run both ways
+
+HARNESS = r"""
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+static uint32_t g_eax, g_ecx, g_edx, g_ebx, g_esp, g_esi, g_edi, g_ebp, g_seh_ebp;
+static double g_fp_stack[8];
+static uint32_t g_fp_top;
+static uint16_t g_fp_control_word;
+static int g_fp_cmp;
+static uint16_t g_fp_cc;
+#define eax g_eax
+#define ecx g_ecx
+#define edx g_edx
+#define ebx g_ebx
+#define esp g_esp
+#define esi g_esi
+#define edi g_edi
+static unsigned char mem[0x10000];
+#define M(T, a) (*(T *)(mem + ((uint32_t)(a) & 0xFFFFu)))
+#define MEM8(a) M(uint8_t, a)
+#define MEM16(a) M(uint16_t, a)
+#define MEM32(a) M(uint32_t, a)
+#define SMEM8(a) M(int8_t, a)
+#define SMEM16(a) M(int16_t, a)
+#define SMEM32(a) M(int32_t, a)
+#define MEMF(a) M(float, a)
+#define MEMD(a) M(double, a)
+#define MEMF_SET(a, v) (M(float, a) = (float)(v))
+#define MEMD_SET(a, v) (M(double, a) = (double)(v))
+#define PUSH32(sp, v) do { uint32_t _pv = (v); (sp) -= 4u; MEM32(sp) = _pv; } while (0)
+#define POP32(sp, d) do { (d) = MEM32(sp); (sp) += 4u; } while (0)
+#define RECOMP_ABI_CALL(va, fn) fn()
+#define RECOMP_BACKEDGE() ((void)0)
+#define RECOMP_FP_PC(v) (v)
+#define CMP_EQ(a, b) ((a) == (b))
+#define CMP_NE(a, b) ((a) != (b))
+"""
+
+MAIN = r"""
+int main(void) {
+    for (int i = 0; i < 0x10000; i++) mem[i] = (unsigned char)(i * 7 + 3);
+    for (int run = 0; run < 3; run++) {
+        g_esp = 0x8000 + 0x1000 * run; g_eax = 0x11 + run; g_ecx = 0x2222; g_edx = 0x333; g_ebx = 0x2100;
+        g_esi = 0x55; g_edi = 0x66;
+        PUSH32(g_esp, 0x1234u); PUSH32(g_esp, 0x99u);  /* an argument and the return address */
+        ENTRY();
+        printf("%x %x %x %x %x %x %x\n", g_eax, g_ecx, g_edx, g_ebx, g_esp, g_esi, g_edi);
+    }
+    /* below each entry esp is the dead frame: what is left there is no one's */
+    unsigned h = 0;
+    for (int i = 0; i < 0x10000; i++)
+        if (!((i >= 0x8000 - 8 - 0x200 && i < 0x8000 - 8) || (i >= 0x9000 - 8 - 0x200 && i < 0x9000 - 8)
+              || (i >= 0xA000 - 8 - 0x200 && i < 0xA000 - 8)))
+            h = h * 31 + mem[i];
+    printf("%x\n", h);
+    return 0;
+}
+"""
+
+
+def _compile_run(text, entry, tmp, tag):
+    cc = shutil.which("gcc") or shutil.which("clang")
+    src, exe = os.path.join(tmp, tag + ".c"), os.path.join(tmp, tag)
+    with open(src, "w") as f:
+        f.write(HARNESS + text + MAIN.replace("ENTRY", entry))
+    subprocess.run([cc, "-std=gnu11", "-O2", "-w", "-o", exe, src], check=True)
+    return subprocess.run([exe], check=True, capture_output=True, text=True).stdout
+
+
+CASES = [
+    # spills, a store through a pointer between them, a float through a slot, an argument rewritten
+    [[SUB_ESP_10, ST_4_EAX, ST_EBX_ECX, LD_EDX_4, ADD_4_EAX, LD_EDX_4, FLD_4, FSTP_C, FLD_C, FSTP_G,
+      LD_EAX_ARG, ST_ARG_EDX, LD_EAX_ARG, ADD_ESP_10, RET]],
+    # a call between: an argument pushed, a slot read after, the callee writes its argument
+    [[SUB_ESP_10, ST_8_ECX, ST_4_EAX, PUSH_EAX, _call(1), ADD_ESP_4, LD_EAX_8, ADD_4_EAX, LD_EDX_4,
+      ADD_ESP_10, RET],
+     [_h("8B442404"), _h("89542404"), _h("8B4C2404"), RET]],
+    # a slot written through its address, then read
+    [[SUB_ESP_10, LEA_ECX_8, ST_PECX_EDX, LD_EAX_8, ADD_4_EAX, LD_EAX_8, ADD_ESP_10, RET]],
+    # the callee is given the slot's address and writes it
+    [[SUB_ESP_10, ST_8_ECX, LEA_ECX_8, PUSH_ECX, _call(1), ADD_ESP_4, LD_EAX_8, LD_EAX_8, ADD_ESP_10, RET],
+     [_h("8B442404"), _h("C700AA000000"), RET]],  # mov eax,[esp+4]; mov dword [eax], 0xAA
+]
+
+
+@pytest.mark.parametrize("funcs", CASES)
+def test_the_locals_compute_what_the_memory_model_computes(funcs):
+    if not (shutil.which("gcc") or shutil.which("clang")):
+        pytest.skip("C compiler unavailable")
+    _, pend, names, out = _run_pass(funcs)
+    assert out[names[0]][1] is None, out[names[0]][1]
+    protos = "".join("static void %s(void);\n" % n for n in names)
+    plain = protos + "\n".join(_body(p.lines) for p in pend.values())
+    done = protos + "\n".join(_body(out[n][0]) for n in names)
+    with tempfile.TemporaryDirectory() as tmp:
+        a = _compile_run(plain, names[0], tmp, "plain")
+        b = _compile_run(done, names[0], tmp, "locals")
+    assert a == b, (a, b)
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_") and name != "test_the_locals_compute_what_the_memory_model_computes":
+            fn()
+    for c in CASES:
+        test_the_locals_compute_what_the_memory_model_computes(c)
+    print("ok")
