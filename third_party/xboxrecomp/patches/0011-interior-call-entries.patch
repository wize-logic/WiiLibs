From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Tue, 13 Oct 2026 11:33:36 -0400
Subject: [PATCH] recomp: give a called address inside lifted code a function
 of its own

A call needs a symbol to call. A direct call to an address inside a body
that no function starts at (an alternate entry: hand-written code entered
at two points, a helper the disassembler kept inside its caller) had only
the unresolved stub, which popped the return address and returned without
running anything.

discover_interior_entries, run last by BatchTranslator, works out what
each function reaches (and caches it for translation), collects the
direct calls of reachable code, and gives each called address that is
code but no function start an entry of its own (detection_method
"interior_entry", called_by its callers): its straight-line code from
there plus whatever that code reaches -- exactly what the x86 runs when
called there. Iterated, since a new entry can call further in. A weak
start a CFG owner took over becomes a function again when something calls
it. The entries are in the dispatch table, so an indirect call there
resolves too.

New entries do not stop another function's lifting: a jump to one is
still lifted into the jumping function's body.

tests: test_interior_targets.py (a call to an alternate entry).
---
 tools/recomp/test_interior_targets.py | 22 ++++++--
 tools/recomp/translator.py            | 81 ++++++++++++++++++++++++++-
 2 files changed, 98 insertions(+), 5 deletions(-)

diff --git a/tools/recomp/test_interior_targets.py b/tools/recomp/test_interior_targets.py
index 260b911..0fc897b 100644
--- a/tools/recomp/test_interior_targets.py
+++ b/tools/recomp/test_interior_targets.py
@@ -10,8 +10,8 @@ a false start at 0xE66A0 (an immediate the disassembler took for an address);
 its `je 0xE66B6` returned through such a stub, skipping its epilogue, and a
 level script later crashed with esi pointing into the script stack.
 
-The code a jump reaches is now lifted into the jumping function's own body;
-nothing is split or shortened.
+The code a jump reaches is now lifted into the jumping function's own body, and
+a called address inside a body gets a function of its own.
 
 The x86 here (assembled with GNU as, at BASE):
 
@@ -98,8 +98,10 @@ def database():
             for start, end, method in FUNCTIONS}
 
 
-def lift(start):
+def lift(start, prepass=False):
     subject = FunctionTranslator(image(), database())
+    if prepass:
+        subject.discover_interior_entries()
     code = subject.translate_function(start, subject.func_db[start])
     return subject, code
 
@@ -122,6 +124,18 @@ def test_tail_jump_into_another_body_is_lifted_in_place():
     assert code.count("esp += 4; return; /* ret */") == 1
 
 
+def test_called_address_inside_a_body_gets_a_function():
+    subject, code = lift(D, prepass=True)
+    assert subject.interior_entry_starts == {B_CORE}
+    entry = subject.func_db[B_CORE]
+    assert entry["detection_method"] == "interior_entry"
+    assert entry["called_by"] == [f"0x{D:08X}"]
+    assert f"RECOMP_ABI_CALL(0x{B_CORE:08X}u, sub_{B_CORE:08X});" in code, code
+    core = subject.translate_function(B_CORE, entry)
+    assert "eax = MEM32(esp + 4);" in core, core
+    assert "ebx = (uint32_t)((int32_t)ebx * (int32_t)7);" in core
+
+
 def test_false_start_keeps_its_owner_whole():
     subject, code = lift(F)
     # The switch's arms past the false start are this body's labels; the one at
@@ -161,6 +175,6 @@ def test_runs_off_its_range_into_code_no_function_covers():
 
 
 def test_bytes_nothing_reaches_are_not_followed():
-    subject, code = lift(X)
+    subject, code = lift(X, prepass=True)
     assert f"loc_{B_BODY:08X}: ;" not in code, code
