From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Wed, 14 Oct 2026 22:00:00 -0400
Subject: [PATCH] recomp: integer widths and flags of mul, div, sub, add, neg
 and shifts

- One-operand mul, imul, div and idiv were lifted as the dword forms at
  every width. `mul cl` multiplied all of EAX and wrote EDX; `div cl`
  divided EDX:EAX. A byte operand now works in AX (AL, AH for the
  quotient and remainder), a word in DX:AX. The divisor is read once,
  before any write (`div eax` took the remainder by the new quotient).
  The dword divides take a 32-bit path when EDX is only EAX's extension
  (`xor edx, edx; div`, `cdq; idiv`): a 64-bit division is a library call
  on a 32-bit host.
- mul sets CF and OF (the high half is nonzero) but sat with the
  instructions whose flags are undefined, so `mul; jo` read 0. mul and
  every imul now publish CF = OF in _fb, and jo/jno/jc/jnc after them read
  it. seto and setno are fused like the other SETcc forms.
- Two- and three-operand imul multiplied as int32_t, which overflows --
  undefined in C -- for exactly the products whose OF the hardware sets.
  The low half is the same bits signed or unsigned: multiply in uint32_t.
- A narrow sub followed by jl/jge/jle/jg compared the reconstructed
  operands at 32 bits; they are cast to the operand's width, as the cmp
  snapshot is.
- add and neg followed by jl/jge/jle/jg tested SF alone. The signed
  conditions are SF != OF: the sign of the exact sum (add) or of 0 - a
  (neg), now computed in 64 bits.
- A shift by zero leaves the flags alone but published its result
  snapshot. A constant zero count is no longer tracked as a flag setter.
  With a variable count the snapshot is written only for a nonzero one;
  for zero, when the previous setter is known, its ZF and SF (taken
  before the write) are stored as a result that reads the same, since
  the snapshot slots need not hold a result (a cmp keeps its operands
  there).
- cwd was not lifted; it sets DX to AX's sign.

Tests: test_integer_width_flags.py. Conformance cases mul8, imul8, mul16,
imul16, div8, idiv8, idiv8_neg, div16, idiv16, div32_fast, div32_wide,
idiv32_cdq, idiv32_cdq_neg, idiv32_wide, div_by_eax, mul32_cf_of,
mul8_of, imul32_one_of, imul16_one_of, imul_two_of, imul_two_16_of,
imul_three_of, imul_three_16_of, sub8_signed, sub16_signed,
add32_signed, add8_signed, neg32_signed, neg8_signed, the three
<shift>_zero_count_flags and shl_imm_zero_flags.
---
 tools/conformance/cases.py               |  78 ++++++++
 tools/recomp/lifter.py                   | 227 +++++++++++++++++------
 tools/recomp/test_integer_width_flags.py | 107 +++++++++++
 tools/recomp/test_interior_targets.py    |   4 +-
 tools/recomp/translator.py               |   3 +-
 5 files changed, 360 insertions(+), 59 deletions(-)
 create mode 100644 tools/recomp/test_integer_width_flags.py

diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
index 983e365..887d764 100644
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -708,3 +708,81 @@ CASES += [
           "seta cl", "setb ch", "setz dl", "setp dh", "shl ch, 1", "shl dl, 2", "shl dh, 3",
           "or cl, ch", "or cl, dl", "or cl, dh", "movzx eax, cl"], _FP_NAN, "fpu"),
 ]
+
+# One-operand mul/imul/div/idiv at each width: a byte operand works in AX, a
+# word in DX:AX. EDX starts as a marker and is folded into eax, so a form that
+# clobbers it (every narrow one did) shows. Divisors and dividends are shaped
+# so no quotient overflows (the hardware would fault).
+_W = "mov edx, 05A5A5A5Ah"
+CASES += [
+    Case("mul8", "mul r/m8: ax = al * cl, edx untouched", [_W, "mul cl", "xor eax, edx"], _PAIRS),
+    Case("imul8", "imul r/m8: ax = al * cl signed", [_W, "imul cl", "xor eax, edx"], _PAIRS),
+    Case("mul16", "mul r/m16: dx:ax = ax * cx", [_W, "mul cx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("imul16", "imul r/m16: dx:ax = ax * cx signed", [_W, "imul cx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("div8", "div r/m8: al = ax / cl, ah = ax % cl",
+         ["and eax, 0FFFF00FFh", "or cl, 1", _W, "div cl", "xor eax, edx"], _PAIRS),
+    Case("idiv8", "idiv r/m8, positive divisor",
+         ["cbw", "and cl, 7Fh", "or cl, 2", _W, "idiv cl", "xor eax, edx"], _PAIRS),
+    Case("idiv8_neg", "idiv r/m8, negative divisor",
+         ["cbw", "and cl, 7Fh", "or cl, 2", "neg cl", _W, "idiv cl", "xor eax, edx"], _PAIRS),
+    Case("div16", "div r/m16: ax = dx:ax / cx, dx = remainder",
+         ["mov edx, 05A5A0000h", "or cx, 1", "div cx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("idiv16", "idiv r/m16 after cwd",
+         ["mov edx, 05A5A0000h", "cwd", "and cx, 7FFFh", "or cx, 2", "idiv cx",
+          "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("div32_fast", "div r/m32 with edx = 0", ["xor edx, edx", "or ecx, 1", "div ecx", "xor eax, edx"], _PAIRS),
+    Case("div32_wide", "div r/m32 with a nonzero high half",
+         ["mov edx, ecx", "shr edx, 1", "or ecx, 1", "div ecx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("idiv32_cdq", "cdq; idiv: the sign-extended dividend",
+         ["cdq", "and ecx, 7FFFFFFFh", "or ecx, 2", "idiv ecx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("idiv32_cdq_neg", "cdq; idiv by a negative divisor",
+         ["cdq", "and ecx, 7FFFFFFFh", "or ecx, 2", "neg ecx", "idiv ecx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("idiv32_wide", "idiv with edx not eax's sign (the 64-bit path)",
+         ["xor edx, edx", "and ecx, 7FFFFFFFh", "or ecx, 2", "idiv ecx", "rol edx, 8", "xor eax, edx"], _PAIRS),
+    Case("div_by_eax", "div eax: the divisor is read before the quotient replaces it",
+         ["or eax, 1", "xor edx, edx", "div eax", "rol edx, 8", "xor eax, edx"], _PAIRS),
+
+    # CF and OF after mul/imul: the product does not fit the low half.
+    Case("mul32_cf_of", "mul r/m32 sets CF = OF = (edx != 0)",
+         ["mul ecx", "seto cl", "setb ch", "movzx ecx, cx", "xor eax, edx", "xor eax, ecx"], _PAIRS),
+    Case("mul8_of", "mul r/m8 sets OF when ah != 0",
+         ["mul cl", "seto cl", "movzx ecx, cl", "shl ecx, 16", "xor eax, ecx"], _PAIRS),
+    Case("imul32_one_of", "imul r/m32: OF when edx:eax is not eax sign-extended",
+         ["imul ecx", "seto cl", "movzx ecx, cl", "xor eax, edx", "xor eax, ecx"], _PAIRS),
+    Case("imul16_one_of", "imul r/m16: OF when dx:ax is not ax sign-extended",
+         [_W, "imul cx", "setb cl", "movzx ecx, cl", "shl ecx, 16", "xor eax, ecx", "rol edx, 8",
+          "xor eax, edx"], _PAIRS),
+    Case("imul_two_of", "imul r32, r/m32: the low half, OF on signed overflow",
+         ["imul eax, ecx", "seto cl", "movzx ecx, cl", "xor eax, ecx"], _PAIRS),
+    Case("imul_two_16_of", "imul r16, r/m16 at word width",
+         ["imul ax, cx", "seto cl", "movzx ecx, cl", "shl ecx, 16", "xor eax, ecx"], _PAIRS),
+    Case("imul_three_of", "imul r32, r/m32, imm: OF on signed overflow",
+         ["imul eax, ecx, -3", "setb cl", "movzx ecx, cl", "xor eax, ecx"], _PAIRS),
+    Case("imul_three_16_of", "imul r16, r/m16, imm at word width",
+         ["imul ax, cx, 1000h", "seto cl", "movzx ecx, cl", "shl ecx, 16", "xor eax, ecx"], _PAIRS),
+
+    # The signed conditions after a narrow sub, and after add and neg, are
+    # SF != OF: the sign of the exact result, not of the wrapped one.
+    Case("sub8_signed", "sub al, cl; setl/setle at byte width",
+         ["sub al, cl", "setl dl", "setle dh", "movzx edx, dx", "shl edx, 16", "xor eax, edx"], _PAIRS),
+    Case("sub16_signed", "sub ax, cx; setg/setge at word width",
+         ["sub ax, cx", "setg dl", "setge dh", "movzx edx, dx", "shl edx, 16", "xor eax, edx"], _PAIRS),
+    Case("add32_signed", "add eax, ecx; setl/setle with signed overflow",
+         ["add eax, ecx", "setl dl", "setle dh", "movzx edx, dx", "xor eax, edx"], _PAIRS),
+    Case("add8_signed", "add al, cl; setg/setge at byte width",
+         ["add al, cl", "setg dl", "setge dh", "movzx edx, dx", "shl edx, 16", "xor eax, edx"], _PAIRS),
+    Case("neg32_signed", "neg eax; setl/setle (the most negative value overflows)",
+         ["neg eax", "setl dl", "setle dh", "movzx edx, dx", "xor eax, edx"], _PAIRS),
+    Case("neg8_signed", "neg al; setg/setge at byte width",
+         ["neg al", "setg dl", "setge dh", "movzx edx, dx", "shl edx, 16", "xor eax, edx"], _PAIRS),
+]
+
+# A shift by a count of zero (or a multiple of 32) leaves every flag as it
+# was: here the cmp's, which the sete/sets after the shift must still see.
+for _sh in ("shl", "shr", "sar"):
+    CASES.append(Case(_sh + "_zero_count_flags", _sh + " by cl = 0 keeps the cmp's ZF and SF",
+                      ["cmp ecx, 7", _sh + " eax, cl", "sete dl", "sets dh", "movzx edx, dx",
+                       "xor eax, edx"], _SHIFT_COUNTS))
+CASES.append(Case("shl_imm_zero_flags", "shl by an immediate 0 keeps the cmp's flags",
+                  ["cmp ecx, 7", "shl eax, 0", "sete dl", "sets dh", "movzx edx, dx", "xor eax, edx"],
+                  _SHIFT_COUNTS))
