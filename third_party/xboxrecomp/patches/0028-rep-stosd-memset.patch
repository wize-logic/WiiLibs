From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Sun, 18 Oct 2026 12:05:03 -0400
Subject: [PATCH] recomp: rep stosd of a byte-uniform value forwards over
 memory is a memset

---
 tools/recomp/lifter.py              | 12 +++++--
 tools/recomp/test_rep_stosd_fill.py | 52 +++++++++++++++++++++++++++++
 2 files changed, 62 insertions(+), 2 deletions(-)
 create mode 100644 tools/recomp/test_rep_stosd_fill.py

diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index 01c73c9..f5338b6 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -3214,11 +3214,19 @@ class Lifter:
                     " MEM8(edi - _i) = LO8(eax); edi -= ecx; }",
                     "ecx = 0; /* rep stosb */"]
         if "stosd" in m:
+            # Forwards, over ordinary memory, with a value whose four bytes
+            # are the same (zero, -1: nearly every fill), the bytes memset
+            # writes are the ones the loop writes; the range is checked as
+            # rep movs checks it. Anything else stays the element loop.
             return [
-                "{ uint32_t _i; int32_t _st = RECOMP_DF_STEP(4);"
+                "{ uint64_t _n = (uint64_t)ecx * 4u;",
+                "if (!g_df && eax == (eax & 0xFFu) * 0x01010101u && edi < 0xFD000000u"
+                " && (uint64_t)edi + _n <= 0xFD000000u) {",
+                "  memset((void*)XBOX_PTR(edi), (int)(eax & 0xFFu), (size_t)_n); edi += ecx * 4u; }",
+                "else { uint32_t _i; int32_t _st = RECOMP_DF_STEP(4);"
                 " for (_i = 0; _i < ecx; _i++) MEM32(edi + _i*_st) = eax;"
                 " edi += ecx * _st; }",
-                "ecx = 0; /* rep stosd */"
+                "ecx = 0; } /* rep stosd */"
             ]
         if "stosw" in m:
             return [
diff --git a/tools/recomp/test_rep_stosd_fill.py b/tools/recomp/test_rep_stosd_fill.py
new file mode 100644
index 0000000..e18b999
--- /dev/null
+++ b/tools/recomp/test_rep_stosd_fill.py
@@ -0,0 +1,52 @@
+"""`rep stosd`: memset for a byte-uniform value forwards over memory, the element loop otherwise.
+
+The emitted block runs against an access-counting guest-memory fixture: every value, direction,
+count and range (memory, the hardware aperture, a range running into it) gives the bytes, edi and
+ecx the instruction gives, and the fast path is taken exactly when it may be.
+"""
+from tools.recomp.lifter import Lifter
+from tools.recomp.disasm import Instruction
+from tools.recomp.test_rep_movs_mmio import _build_and_run
+
+
+def test_rep_stosd_fill():
+    prelude = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+uint32_t eax,edi,ecx;
+int g_df;
+unsigned accesses;
+uint8_t mem[131076],refmem[131076];
+unsigned slot(uint32_t a){return (a&0xffffu)+(a>=0xFD000000u?65536u:0u);}
+void* touch(uint32_t a){accesses++;return mem+slot(a);}
+#define XBOX_PTR(a) (mem+slot(a))
+#define MEM32(a) (*(volatile uint32_t*)touch(a))
+#define RECOMP_DF_STEP(s) (g_df?-(s):(s))
+'''
+    fill = "void fill(void){" + "".join(Lifter().lift_instruction(Instruction(0, 2, "rep stosd", "", ""))) + "}"
+    main = r'''
+int main(void){
+    const uint32_t values[]={0,0xFFFFFFFFu,0x7F7F7F7Fu,0x12345678u,0x000000FFu,0xFF000000u,0x01010100u};
+    for(unsigned v=0;v<sizeof values/sizeof values[0];v++) for(unsigned mode=0;mode<6;mode++) for(unsigned n=0;n<=9;n++){
+        uint32_t d=0x400; int df=0;
+        if(mode==1){d=0x400+8*4;df=1;}           /* backwards */
+        if(mode==2)d=0xFD000400;                 /* hardware */
+        if(mode==3)d=0xFD000000-2*4;             /* runs into the aperture */
+        if(mode==4)d=0xFD000000-n*4;             /* ends at it */
+        if(mode==5)d=0x401;                      /* unaligned */
+        for(unsigned i=0;i<sizeof mem;i++)mem[i]=refmem[i]=(uint8_t)(i*37+13);
+        uint32_t rd=d;
+        for(unsigned i=0;i<n;i++){memcpy(refmem+slot(rd),&values[v],4);rd+=df?-4:4;}
+        eax=values[v];edi=d;ecx=n;g_df=df;accesses=0;fill();
+        uint32_t x=values[v];
+        int fast=!df && x==(x&0xFFu)*0x01010101u && d<0xFD000000u && (uint64_t)d+n*4<=0xFD000000u;
+        if(memcmp(mem,refmem,sizeof mem) || edi!=rd || ecx!=0 || eax!=x || accesses!=(fast?0:n)){
+            printf("value %08x mode %u count %u access %u\n",x,mode,n,accesses);return 1;
+        }
+    }
+    return 0;
+}
+'''
+    ran = _build_and_run(prelude + fill + main)
+    assert ran.returncode == 0, ran.stdout + ran.stderr
