         if jcc in ("jb", "jnae"):
             return f"((uint32_t){lhs} + (uint32_t){rhs} < (uint32_t){rhs})", desc
@@ -842,14 +860,15 @@ def _make_condition(jcc, flag_setter, flag_ops):
             return f"({lhs} < (uint32_t){rhs})", desc
         if jcc in ("jae", "jnb", "jnc"):
             return f"({lhs} >= (uint32_t){rhs})", desc
-        if jcc in ("jl", "jnge"):
-            return f"({slhs} < 0)", desc
-        if jcc in ("jge", "jnl"):
-            return f"({slhs} >= 0)", desc
-        if jcc in ("jle", "jng"):
