From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Mon, 19 Oct 2026 11:18:17 -0400
Subject: [PATCH] conformance: fcmovcc after fcomi, and stmxcsr

Upstream's 01064f3 lifts fcmovcc and c50c597 models MXCSR. These cases run
them on the CPU: fpu_fcmov<cc> for the eight conditions after fcomi with
ordered, equal and unordered inputs (fcomi leaves exactly the unsigned and
parity conditions they test), and sse_stmxcsr for the controls a thread
starts with (every exception masked, round to nearest).
---
 tools/conformance/cases.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
index 887d764..d6059c4 100644
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -786,3 +786,15 @@ for _sh in ("shl", "shr", "sar"):
 CASES.append(Case("shl_imm_zero_flags", "shl by an immediate 0 keeps the cmp's flags",
                   ["cmp ecx, 7", "shl eax, 0", "sete dl", "sets dh", "movzx edx, dx", "xor eax, edx"],
                   _SHIFT_COUNTS))
+
+# fcmovcc after fcomi: st0 = st1 when the condition holds, for each of the
+# eight conditions, ordered, equal and unordered inputs.
+for _cc in ("b", "e", "be", "u", "nb", "ne", "nbe", "nu"):
+    CASES.append(Case("fpu_fcmov" + _cc, "fcmov%s after fcomi" % _cc,
+                      ["fld qword ptr [eax+16]", "fld qword ptr [eax]", "fcomi st, st(1)",
+                       "fcmov%s st, st(1)" % _cc], _FP_NAN, "fpu"))
+# The control half only: the sticky exception flags (bits 0-5) are whatever
+# the CPU's earlier work raised, which the lift does not model.
+CASES.append(Case("sse_stmxcsr", "stmxcsr stores the default MXCSR controls",
+                  ["stmxcsr dword ptr [eax+32]", "and dword ptr [eax+32], 0FFFFFFC0h",
+                   "mov eax, dword ptr [eax+32]"], _SSE, "sse"))
