 #define MEMF(addr)   (*(volatile float    *)XBOX_PTR(addr))
 #define MEMD(addr)   (*(volatile double   *)XBOX_PTR(addr))
 
+/** The same accesses at base + disp, a small constant (recomp --mem-disp
+ * writes them for MEMxx(base + disp)). Here exactly MEMxx(base + disp); a
+ * runtime whose address map is not a plain addition can map base once and
+ * add disp on the host side. */
+#define MEM8_D(b, d)   MEM8((b) + (d))
+#define MEM16_D(b, d)  MEM16((b) + (d))
+#define MEM32_D(b, d)  MEM32((b) + (d))
+#define SMEM8_D(b, d)  SMEM8((b) + (d))
+#define SMEM16_D(b, d) SMEM16((b) + (d))
+#define SMEM32_D(b, d) SMEM32((b) + (d))
+#define SMEM64_D(b, d) SMEM64((b) + (d))
+#define MEMF_D(b, d)   MEMF((b) + (d))
+#define MEMD_D(b, d)   MEMD((b) + (d))
