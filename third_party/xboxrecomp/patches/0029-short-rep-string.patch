     def _lift_string_op(self, insn, m):
         # Unprefixed forms; direction still comes from EFLAGS.DF.
@@ -4290,6 +4352,36 @@ def _fcmov_statement(insn, cond_expr):
             f" /* {insn.mnemonic} {insn.op_str} */")
 
 
+def _rep_at(k, size):
+    """The displacement of element k of a forward rep op, as an address tail."""
+    return f" + {k * size}u" if k else ""
+
+
+def _rep_fill_loop(size, mem, value):
+    """rep stos as its element loop, either direction."""
+    return [f"{{ uint32_t _i; int32_t _st = RECOMP_DF_STEP({size});"
+            f" for (_i = 0; _i < ecx; _i++) {mem}(edi + _i*_st) = {value};"
+            " edi += ecx * _st; }"]
+
+
+def _rep_count_hint(insns, i):
+    """What the instruction before insns[i] in its block says about ecx:
+    ("exact", n) after `mov ecx, n`, ("max", n) after `and ecx, n`, else None.
+    The block has one entry, so that instruction always runs just before."""
+    if i == 0:
+        return None
+    prev = insns[i - 1]
+    ops = prev.operands
+    if (len(ops) == 2 and ops[0].type == "reg" and ops[0].reg == "ecx"
+            and ops[1].type == "imm" and ops[1].imm is not None):
+        n = ops[1].imm & 0xFFFFFFFF
+        if prev.mnemonic == "mov":
+            return ("exact", n)
+        if prev.mnemonic == "and":
+            return ("max", n)
+    return None
+
+
 def _is_rep_compare(insn):
     """REPE/REPNE CMPS or SCAS -- the prefixed forms that write `_flags`."""
     if not insn.mnemonic.startswith("rep"):
@@ -4471,8 +4563,11 @@ def lift_basic_block(lifter, bb, flag_state=None):
                 zf = _make_condition("je", last_flag_setter, last_flag_ops)
                 sf = _make_condition("js", last_flag_setter, last_flag_ops)
                 lifter.shift_flags_in = (zf[0], sf[0]) if zf and sf else None
+            lifter.rep_count = (_rep_count_hint(insns, i)
+                                if curr.mnemonic.startswith("rep") else None)
             results = lifter.lift_instruction(insns[i])
             lifter.shift_flags_in = None
+            lifter.rep_count = None
             # A REPE/REPNE compare whose count is zero leaves EFLAGS alone,
             # but `_flags` would keep whatever it last held -- 0 on entry --
             # so the je after it read "not equal" where the hardware reads
