diff --git a/tools/recomp/x87_locals.py b/tools/recomp/x87_locals.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/x87_locals.py
@@ -0,0 +1,697 @@
+"""
+The x87 stack of one generated function in C locals.
+
+The lifter models the x87 register stack in memory: `g_fp_stack[8]` (doubles)
+and the index `g_fp_top`, read and written through the fp_push / fp_pop /
+fp_top / fp_st macros, beside the control word `g_fp_control_word` and the
+last compare (`g_fp_cmp`, `g_fp_cc`). That state has to live in memory where
+control crosses a function boundary -- st(0) carries arguments and results
+between guest functions, and one guest routine can lift to several C
+functions -- but inside a body every operation then loads the index, computes
+an address, loads or stores a double and reads the control word again. On
+PowerPC that is most of the cost of x87-heavy code.
+
+Within a function the depth of the stack is almost always known statically,
+relative to a point where memory was current. This pass, run on the C text
+translate_function produces, uses that. At each statement either memory is
+the truth (on entry, and after anything that calls out) or the locals are:
+
+  * the first x87 statement after memory was the truth loads the locals: a
+    base index from g_fp_top, the control word, the compare results, and the
+    stack positions the function uses. The slot that is st(i) at static depth
+    k (values pushed since that load) is position p = i - k from the base,
+    and each position is a double local, so fp_push, fp_pop and fp_st become
+    assignments, nothing and names; RECOMP_FP_PC becomes RECOMP_FP_PC_CW with
+    the local control word;
+  * before every statement that leaves the function or calls out of it -- a
+    call, a tail call, a return, any name this pass does not know -- the
+    positions written since the load that still hold a value, g_fp_top when
+    the depth moved, and the scalars written go back to memory; memory is the
+    truth after it (a callee may push a result, pop an argument or change the
+    control word), and the next x87 statement loads again;
+  * where paths join, the locals and memory are made to agree on the edges: a
+    path from memory loads (only that edge pays), a path whose locals hold
+    nothing new joins memory for free, and a label reached at different
+    depths (after a call that left a value on one path) is entered through
+    memory, every edge with locals writing them back;
+  * the same expressions compute the same doubles, so the results are
+    identical bit for bit; only the loads and stores go away.
+
+Whenever memory is the truth it holds what the memory model holds there, in
+g_fp_top, the control word, the compare results and every slot from st(0) to
+the bottom of the stack. The slots above st(0) are empty: the memory model
+leaves the last value popped there, this pass may leave an older one. No x87
+instruction can read an empty slot (on the hardware it is a stack fault).
+
+The analysis is a dataflow over the function's own C statements: a goto is an
+edge, a statement that cannot fall through (an unconditional goto, a return)
+ends one, and nothing else enters a label -- the generated code takes no label
+addresses -- so the C text is the control flow graph and nothing is guessed
+about the x86 code. A function keeps the memory model, unchanged, when it uses
+more than eight positions (two would share one register), when a statement
+that calls out contains a goto, or when it calls setjmp. A statement this pass
+does not understand runs against memory, so an unknown x87 instruction costs
+speed, never correctness; so does a conditional or loop written over several
+lines.
+
+RECOMP_BACKEDGE is treated as not touching the x87 state. A runtime whose
+backedge hook switches guest threads, or runs interrupt work on the current
+thread, has to save and restore the x87 registers around it (a guest thread
+has registers of its own; an interrupt routine that uses the FPU saves it on
+hardware too). The memory copy is not current at a backedge, but a saved and
+restored copy comes back the same, and the locals hold the truth.
+"""
+
+import re
+
+__all__ = ["localise_x87", "X87_LOCALS_PREFIX"]
+
+X87_LOCALS_PREFIX = "_x87"
+
+# Function-like names that never read or write the x87 state and never leave
+# the function: guest memory and register accessors, flag and compare helpers,
+# libm, the SIMD macros. Anything else followed by '(' -- a guest function,
+# RECOMP_ABI_CALL, an indirect call, a tail call, a runtime service -- is a
+# call, and the state is written back before it and re-read after it.
+_TRANSPARENT = frozenset("""
+    MEM8 MEM16 MEM32 MEM64 SMEM8 SMEM16 SMEM32 SMEM64 MEMF MEMD MEMF_SET MEMD_SET
+    PUSH32 POP32 XBOX_PTR
+    LO8 HI8 LO16 SET_LO8 SET_HI8 SET_LO16 SX8 SX16 ZX8 ZX16
+    CMP_EQ CMP_NE CMP_L CMP_LE CMP_G CMP_GE CMP_B CMP_BE CMP_A CMP_AE TEST_Z TEST_NZ
+    RECOMP_PARITY8 RECOMP_DF_STEP RECOMP_FCMP RECOMP_FCMP_CC RECOMP_FP_PC RECOMP_FP_PC_CW
+    RECOMP_BACKEDGE RECOMP_ATOMIC_CAS32 RECOMP_ATOMIC_ADD32
+    ROL8 ROL16 ROL32 ROR8 ROR16 ROR32 RC_ROT
+    recomp_fist recomp_frndint recomp_ld80 recomp_st80 recomp_fxam recomp_cvt_si32
+    memcpy memset memmove
+    fabs sqrt sin cos tan atan atan2 log log2 log10 exp exp2 ldexp frexp fmod remainder
+    floor ceil trunc rint nearbyint copysign
+""".split())
+
+_KEYWORDS = frozenset("""
+    if else for while do switch case default return goto break continue sizeof
+""".split())
+
+# The memory model's accessors (translator.FP_STACK_MACROS) and the globals.
+_FP_MACROS = ("fp_push", "fp_pop", "fp_top", "fp_st1", "fp_st")
+_SCALARS = {  # global -> (local suffix, C type)
+    "g_fp_control_word": ("cw", "uint16_t"),
+    "g_fp_cmp": ("cmp", "int"),
+    "g_fp_cc": ("cc", "uint16_t"),
+}
+
+_LABEL = re.compile(r"^\s*(loc_[0-9A-Fa-f]+):\s*;\s*$")
+_GOTO = re.compile(r"\bgoto\s+([A-Za-z_]\w*)\s*;")
+_CALLISH = re.compile(r"(?<![\w.])([A-Za-z_]\w*)\s*\(")
+_LEFTOVER = re.compile(r"\b(fp_push|fp_pop|fp_top|fp_st1|fp_st|g_fp_top|g_fp_stack)\b")
+_TOKEN = re.compile(
+    r"\bfp_push\s*\("
+    r"|\bfp_pop\s*\(\s*\)"
+    r"|\bfp_top\s*\(\s*\)"
+    r"|\bfp_st1\s*\(\s*\)"
+    r"|\bfp_st\s*\(\s*(?P<st>\d+)u?\s*\)"
+    r"|\bg_fp_stack\s*\[\s*\(\s*g_fp_top\s*\+\s*(?P<gs>\d+)u?\s*\)\s*&\s*7u?\s*\]"
+    r"|\(\s*g_fp_top\s*&\s*7u?\s*\)"
+    r"|\bRECOMP_FP_PC\s*\("
+    r"|\b(?P<sc>g_fp_control_word|g_fp_cmp|g_fp_cc)\b")
+_WRITE_AFTER = re.compile(r"\s*(=(?!=)|\+=|-=|\*=|/=|%=|&=|\|=|\^=|<<=|>>=|\+\+|--)")
+_WRITE_BEFORE = re.compile(r"(\+\+|--)\s*$")
+_CONTROL = re.compile(r"\b(if|else|for|while|do|switch|case|default|goto|return|break|continue)\b"
+                      r"|\?|&&|\|\|")
+
+
+class _NotLocal(Exception):
+    """The function keeps the memory model; the message says why."""
+
+
+# ---------------------------------------------------------------- C text
+
+def _protect(line):
+    """(code, restore): comments and literals replaced by inert placeholders."""
+    out, saved, i, n = [], [], 0, len(line)
+    while i < n:
+        c = line[i]
+        if line.startswith("/*", i):
+            j = line.find("*/", i + 2)
+            j = n if j < 0 else j + 2
+        elif line.startswith("//", i):
+            j = n
+        elif c in "\"'":
+            j = i + 1
+            while j < n and line[j] != c:
+                j += 2 if line[j] == "\\" else 1
+            j = min(j + 1, n)
+        else:
+            out.append(c)
+            i += 1
+            continue
+        saved.append(line[i:j])
+        out.append("\x01%d\x02" % (len(saved) - 1))
+        i = j
+    code = "".join(out)
+
+    def restore(text):
+        return re.sub(r"\x01(\d+)\x02", lambda m: saved[int(m.group(1))], text)
+    return code, restore
+
+
+def _match_paren(code, i):
+    """Index just past the bracket matching the one at code[i]."""
+    pairs = {"(": ")", "[": "]", "{": "}"}
+    stack = []
+    for j in range(i, len(code)):
+        c = code[j]
+        if c in pairs:
+            stack.append(pairs[c])
+        elif c in ")]}":
+            if not stack or stack.pop() != c:
+                raise _NotLocal("unbalanced brackets")
+            if not stack:
+                return j + 1
+    raise _NotLocal("unbalanced brackets")
+
+
+def _braces(code):
+    """The unmatched braces of one line: (closes, opens), where opens lists the
+    head (the text before it in its statement) of each '{' left open."""
+    closes, opens, depth_paren = 0, [], 0
+    stmt_start = 0
+    for j, c in enumerate(code):
+        if c in "([":
+            depth_paren += 1
+        elif c in ")]":
+            depth_paren -= 1
+        elif depth_paren:
+            continue
+        elif c == "{":
+            opens.append(code[stmt_start:j].strip())
+            stmt_start = j + 1
+        elif c == "}":
+            if opens:
+                opens.pop()
+            else:
+                closes += 1
+            stmt_start = j + 1
+        elif c == ";":
+            stmt_start = j + 1
+    return closes, opens
+
+
+def _items(code):
+    """The top-level items of a statement sequence: ("stmt", text) for a
+    statement ended by ';', ("block", head, inner) for a braced block whose
+    close is in the text, ("open"/"close", "") for a brace left unmatched."""
+    items, i, n, start = [], 0, len(code), 0
+    while i < n:
+        c = code[i]
+        if c in "([":
+            i = _match_paren(code, i)
+            continue
+        if c == ";":
+            items.append(("stmt", code[start:i].strip()))
+            start = i = i + 1
+            continue
+        if c == "{":
+            try:
+                j = _match_paren(code, i)
+            except _NotLocal:
+                items.append(("open", code[start:i].strip()))
+                start = i = i + 1
+                continue
+            items.append(("block", code[start:i].strip(), code[i + 1:j - 1]))
+            start = i = j
+            continue
+        if c == "}":
+            items.append(("close", code[start:i].strip()))
+            start = i = i + 1
+            continue
+        i += 1
+    if code[start:].strip():
+        items.append(("stmt", code[start:].strip()))
+    return items
+
+
+def _terminal(code):
+    """True only when control cannot run past the end of this text: it holds an
+    unconditional `goto label;` or `return;` (a bare block's counts)."""
+    for item in _items(code):
+        if item[0] == "stmt" and re.fullmatch(r"goto\s+\w+|return", item[1]):
+            return True
+        if item[0] == "block" and item[1] == "" and _terminal(item[2]):
+            return True
+    return False
+
+
+def _calls(code):
+    names = set()
+    for m in _CALLISH.finditer(code):
+        name = m.group(1)
+        if name in _KEYWORDS or name in _TRANSPARENT or name in _FP_MACROS:
+            continue
+        names.add(name)
+    return names
+
+
+# ------------------------------------------------------------ positions
+
+def _slot(p):
+    return "%ss%s%d" % (X87_LOCALS_PREFIX, "m" if p < 0 else "", abs(p))
+
+
+def _scalar(g):
+    return X87_LOCALS_PREFIX + _SCALARS[g][0]
+
+
+def _rewrite(code, k):
+    """Rewrite one statement line at static depth k.
+
+    Returns (code, k_out, written positions, read positions, scalars written,
+    scalars used) or None when the line has to run against memory."""
+    if re.search(r"&\s*(fp_|g_fp_)", code):
+        return None
+    wr, rd, swr, sused = set(), set(), set(), set()
+    moved = [False]
+
+    def write_at(text, end, start):
+        return bool(_WRITE_AFTER.match(text, end)) or bool(_WRITE_BEFORE.search(text[:start]))
+
+    def walk(text, k):
+        out, i = [], 0
+        while True:
+            m = _TOKEN.search(text, i)
+            if not m:
+                out.append(text[i:])
+                return "".join(out), k
+            out.append(text[i:m.start()])
+            tok = m.group(0)
+            if tok.startswith("fp_push"):
+                open_at = m.end() - 1
+                close = _match_paren(text, open_at)
+                inner, k_in = walk(text[open_at + 1:close - 1], k)
+                if k_in != k:
+                    raise _NotLocal("push inside a push")
+                k += 1
+                moved[0] = True
+                wr.add(-k)
+                out.append("%s = (%s)" % (_slot(-k), inner))
+                i = close
+                continue
+            if tok.startswith("fp_pop"):
+                k -= 1
+                moved[0] = True
+                out.append("(void)0")
+                i = m.end()
+                continue
+            if tok.startswith("RECOMP_FP_PC"):
+                sused.add("g_fp_control_word")
+                out.append("RECOMP_FP_PC_CW(%s, " % _scalar("g_fp_control_word"))
+                i = m.end()
+                continue
+            if m.group("sc"):
+                g = m.group("sc")
+                sused.add(g)
+                if write_at(text, m.end(), m.start()):
+                    swr.add(g)
+                out.append(_scalar(g))
+                i = m.end()
+                continue
+            if tok.startswith("(") and "g_fp_top" in tok:
+                # the TOP field of the status word: the index st(0) has now
+                out.append("((%st + %du) & 7u)" % (X87_LOCALS_PREFIX, (-k) & 7))
+                i = m.end()
+                continue
+            if tok.startswith("fp_top"):
+                idx = 0
+            elif tok.startswith("fp_st1"):
+                idx = 1
+            elif m.group("st") is not None:
+                idx = int(m.group("st"))
+            else:
+                idx = int(m.group("gs"))
+            p = idx - k
+            if write_at(text, m.end(), m.start()):
+                wr.add(p)
+            rd.add(p)
+            out.append(_slot(p))
+            i = m.end()
+
+    try:
+        new, k_out = walk(code, k)
+    except _NotLocal:
+        return None
+    if moved[0] and _CONTROL.search(code):
+        return None  # a push or pop that may not happen: the depth is not static
+    if _LEFTOVER.search(new):
+        return None
+    return new, k_out, wr, rd, swr, sused
+
+
+# ------------------------------------------------------------- the pass
+
+class _Node:
+    __slots__ = ("first", "last", "code", "kind", "gotos", "terminal", "label")
+
+    def __init__(self, first, last):
+        self.first, self.last = first, last
+        self.code, self.kind, self.gotos, self.terminal, self.label = "", None, [], False, None
+
+
+def _body_bounds(lines, macros, undefs):
+    def find(seq, start=0):
+        for i in range(start, len(lines) - len(seq) + 1):
+            if lines[i:i + len(seq)] == seq:
+                return i
+        return -1
+    m = find(macros)
+    if m < 0:
+        return None
+    u = find(undefs, m + len(macros))
+    if u < 0:
+        return None
+    return m + len(macros), u
+
+
+def _nodes(lines, lo, hi):
+    """The body as nodes: labels, statement lines, and multi-line conditional
+    or loop constructs (one node each, entered at the top, left at the bottom)."""
+    nodes, i = [], lo
+    while i < hi:
+        line = lines[i]
+        if not line.strip():
+            i += 1
+            continue
+        lm = _LABEL.match(line)
+        if lm:
+            n = _Node(i, i)
+            n.kind, n.label = "label", lm.group(1)
+            nodes.append(n)
+            i += 1
+            continue
+        if line.lstrip().startswith("#"):
+            raise _NotLocal("a preprocessor line in the body")
+        code, _ = _protect(line)
+        if re.match(r"^\s*\w+\s*:(?!:)", code) and not code.lstrip().startswith(("case", "default")):
+            raise _NotLocal("a label of another form")
+        if re.match(r"\s*else\b", code):
+            raise _NotLocal("an else this pass did not see the if of")
+        closes, opens = _braces(code)
+        j = i
+        # A conditional or loop opened here and closed further down, and an
+        # if with its else on the next line, are one node, entered at the top
+        # and left at the bottom. (Extra closes on its last line end bare
+        # blocks opened before it.)
+        depth = len(opens) if any(h for h in opens) else 0
+        while True:
+            while depth > 0:
+                j += 1
+                if j >= hi:
+                    raise _NotLocal("an unclosed block")
+                if _LABEL.match(lines[j]):
+                    raise _NotLocal("a label inside a conditional block")
+                cl, op = _braces(_protect(lines[j])[0])
+                depth += len(op) - cl
+            nxt = j + 1
+            while nxt < hi and not lines[nxt].strip():
+                nxt += 1
+            if depth < 0 or nxt >= hi or not re.match(r"\s*else\b", _protect(lines[nxt])[0]):
+                break
+            j = nxt
+            cl, op = _braces(_protect(lines[j])[0])
+            depth = len(op) - cl
+        if j > i:
+            code = " ".join(_protect(lines[x])[0] for x in range(i, j + 1))
+        n = _Node(i, j)
+        n.kind = "region" if j > i else "stmt"
+        n.code = code
+        n.gotos = _GOTO.findall(code)
+        for g in n.gotos:
+            if not g.startswith("loc_"):
+                raise _NotLocal("a goto to a label of another form")
+        if re.search(r"\bgoto\b", code) and len(re.findall(r"\bgoto\b", code)) != len(n.gotos):
+            raise _NotLocal("a goto of another form")
+        n.terminal = _terminal(code) if n.kind == "stmt" else False
+        nodes.append(n)
+        i = j + 1
+    return nodes
+
+
+def localise_x87(lines, macros, undefs):
+    """lines: one function as translate_function emits it. Returns (lines,
+    None) with the x87 state in locals, or (lines unchanged, reason)."""
+    try:
+        return _localise(lines, macros, undefs), None
+    except _NotLocal as e:
+        return lines, str(e)
+
+
+def _localise(lines, macros, undefs):
+    bounds = _body_bounds(lines, macros, undefs)
+    if bounds is None:
+        raise _NotLocal("no x87 macros")
+    lo, hi = bounds
+    text = "\n".join(lines[lo:hi])
+    if re.search(r"setjmp|longjmp", text):
+        raise _NotLocal("setjmp")
+    if X87_LOCALS_PREFIX in text:
+        raise _NotLocal("the names are taken")
+    nodes = _nodes(lines, lo, hi)
+    labels = {n.label: x for x, n in enumerate(nodes) if n.kind == "label"}
+
+    # classify
+    for n in nodes:
+        if n.kind == "label":
+            continue
+        fp = bool(_LEFTOVER.search(n.code) or re.search(r"\b(RECOMP_FP_PC|g_fp_control_word|g_fp_cmp|g_fp_cc)\b", n.code))
+        calls = _calls(n.code)
+        leaves = bool(re.search(r"\breturn\b", n.code))
+        if n.kind == "region":
+            if n.gotos:
+                raise _NotLocal("a goto inside a conditional block")
+            n.kind = "sync" if (fp or calls or leaves) else "plain"
+            continue
+        if calls or leaves:
+            if n.gotos:
+                raise _NotLocal("a goto in a statement that calls out or returns")
+            n.kind = "sync"
+        elif fp:
+            n.kind = "fp"
+        else:
+            n.kind = "plain"
+        for g in n.gotos:
+            if g not in labels:
+                raise _NotLocal("a goto to a label outside the body")
+
+    # Statements this pass cannot rewrite run against memory.
+    for n in nodes:
+        if n.kind == "fp" and _rewrite(n.code, 0) is None:
+            if n.gotos:
+                raise _NotLocal("a goto in an x87 statement this pass cannot rewrite")
+            n.kind = "sync"
+
+    # The dataflow decides where memory is the truth and where the locals are,
+    # and where it needs a load or a write-back on an edge to make paths agree;
+    # each decision only adds, so rerunning it until none is new terminates.
+    plan = _Plan()
+    while True:
+        try:
+            flow = _flow(nodes, labels, plan)
+            break
+        except _Restart:
+            continue
+    return _emit(lines, lo, hi, nodes, labels, plan, flow)
+
+
+# A state is MEM (memory is the truth: nothing is in the locals) or a tuple
+# (k, positions possibly written since memory was last current, k when it was
+# last current or None, scalars possibly written since).
+MEM = "memory"
+_LOADED = (0, frozenset(), 0, frozenset())
+
+
+def _clean(s):
+    """Memory is current too: nothing written since, and the depth where it was."""
+    return s != MEM and not s[1] and not s[3] and s[2] == s[0]
+
+
+class _Plan:
+    def __init__(self):
+        self.rebase = set()       # labels entered through memory: edges with locals write back
+        self.want_locals = set()  # labels entered with the locals: edges from memory load them
+
+
+class _Restart(Exception):
+    pass
+
+
+class _Join(Exception):
+    def __init__(self, kind):
+        super().__init__(kind)
+        self.kind = kind
+
+
+def _merge(a, b):
+    if a is None or a == b:
+        return b
+    if a == MEM or b == MEM:
+        c = b if a == MEM else a
+        if _clean(c):
+            return MEM  # memory is current on both
+        raise _Join("locals")  # the locals on one path, memory on the other
+    if a[0] != b[0]:
+        raise _Join("depth")
+    return (a[0], a[1] | b[1], a[2] if a[2] == b[2] else None, a[3] | b[3])
+
+
+def _edge_state(out, y, plan):
+    """The state an edge carries into y, after the code _emit puts on it."""
+    if y in plan.rebase:
+        return MEM  # written back on the edge (when out has locals)
+    if out == MEM and y in plan.want_locals:
+        return _LOADED  # loaded on the edge
+    return out
+
+
+def _flow(nodes, labels, plan):
+    """The state before and after each node (None where unreachable)."""
+    state_in = [None] * len(nodes)
+    state_out = [None] * len(nodes)
+    rewrites, positions, scalars = {}, set(), set()
+    end_state = [None]
+    work = []
+    if nodes:
+        state_in[0] = _edge_state(MEM, 0, plan)  # function entry: memory is the truth
+        work.append(0)
+    while work:
+        x = work.pop()
+        n, s = nodes[x], state_in[x]
+        if n.kind == "label":
+            out = MEM if x in plan.rebase else s
+        elif n.kind == "plain":
+            out = s
+        elif n.kind == "fp":
+            if s == MEM:
+                s = _LOADED  # loaded before it (see _emit)
+            r = rewrites.get(x)
+            if r is None or r[0] != s[0]:
+                r = (s[0], _rewrite(n.code, s[0]))
+                rewrites[x] = r
+            new, k2, wr, rd, swr, sused = r[1]
+            positions |= wr | rd
+            scalars |= sused
+            out = (k2, s[1] | frozenset(wr), s[2], s[3] | frozenset(swr))
+        else:  # sync: written back before it (see _emit); memory is the truth after
+            out = MEM
+        state_out[x] = out
+        succ = [labels[g] for g in n.gotos] if n.kind != "label" else []
+        if not n.terminal:
+            succ.append(x + 1)
+        for y in succ:
+            if y >= len(nodes):
+                end_state[0] = out  # the last statement's fall-through: its only edge
+                continue
+            try:
+                new = _merge(state_in[y], _edge_state(out, y, plan))
+            except _Join as j:
+                decided = plan.want_locals if j.kind == "locals" else plan.rebase
+                if y in decided:
+                    raise _NotLocal("paths that do not settle where they join")
+                decided.add(y)
+                raise _Restart()
+            if new != state_in[y]:
+                state_in[y] = new
+                work.append(y)
+    return dict(state_in=state_in, state_out=state_out, rewrites=rewrites,
+                positions=positions, scalars=scalars, end_state=end_state[0])
+
+
+def _emit(lines, lo, hi, nodes, labels, plan, flow):
+    state_in, state_out, rewrites = flow["state_in"], flow["state_out"], flow["rewrites"]
+    positions, scalars = flow["positions"], flow["scalars"]
+    if not positions and not scalars:
+        raise _NotLocal("nothing to keep in locals")
+    if positions and max(positions) - min(positions) >= 8:
+        raise _NotLocal("more than eight stack positions")
