+        _bounded = bounded_loop_headers(blocks) if self.bounded_loops else set()
         _cur_block = None
         for _i, _line in enumerate(lines):
             _m = re.match(r'^loc_([0-9A-Fa-f]{8}): ;', _line)
@@ -3415,7 +3421,8 @@ class FunctionTranslator:
                 continue
 
             def _hook(_gm, _block=_cur_block):
-                if int(_gm.group(1), 16) <= _block:
