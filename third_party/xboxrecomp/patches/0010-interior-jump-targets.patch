diff --git a/tools/recomp/test_interior_targets.py b/tools/recomp/test_interior_targets.py
new file mode 100644
index 0000000..260b911
--- /dev/null
+++ b/tools/recomp/test_interior_targets.py
@@ -0,0 +1,166 @@
+"""Jumps and calls into code no function starts at.
+
+A function is lifted from its range, and a direct jump out of the range used to
+be a tail call to whatever function started at the target. When none did -- the
+middle of another body, the rest of this function past a false function start,
+bytes no function covers -- the call went to a stub that popped a return
+address and returned: the code at the target never ran, and esp was four bytes
+off since a jump pushes nothing. Halo's hs `and` evaluator (0xE6600) is split by
+a false start at 0xE66A0 (an immediate the disassembler took for an address);
+its `je 0xE66B6` returned through such a stub, skipping its epilogue, and a
+level script later crashed with esi pointing into the script stack.
+
+The code a jump reaches is now lifted into the jumping function's own body;
+nothing is split or shortened.
+
+The x86 here (assembled with GNU as, at BASE):
+
+    A  (0x000)  mov eax,[esp+4]; test eax,eax; jl B_body; xor eax,0x77; ret
+    C  (0x020)  mov eax,[esp+4]; add eax,3; jmp B_body
+    B  (0x040)  mov eax,[esp+4]; lea eax,[eax+eax*4]; jmp B_body
+       B_core:  mov eax,[esp+4]                   ; an alternate entry
+       B_body:  push ebx; mov ebx,eax; imul ebx,ebx,7; mov eax,ebx; pop ebx; ret
+    D  (0x080)  push dword [esp+4]; call B_core; add esp,4; ret
+    F  (0x100)  push esi; xor esi,esi; mov ecx,[esp+8]
+       F_loop:  test ecx,ecx; jz F_done; mov eax,ecx; and eax,3
+                jmp [F_table + eax*4]
+       F_arm0:  add esi,1; jmp F_next
+    G  F_arm1:  add esi,2; jmp F_next             ; a false start (immediate)
+       F_arm2:  add esi,3; jmp F_next
+       F_arm3:  add esi,4
+       F_next:  dec ecx; jmp F_loop
+       F_done:  mov eax,esi; pop esi; ret
+       F_table: F_arm0, F_arm1, F_arm2, F_arm3     ; right after the code
+    O  (0x200)  push esi; mov esi,[esp+8]; xor eax,eax
+       O_top:   dec esi; jz O_out; add eax,3
+       O_alias: add eax,esi; test esi,1; jnz O_top; jmp O_top
+       O_out:   pop esi; ret
+    X  (0x280)  jmp X_ret; jne B_body             ; a jump nothing reaches
+       X_ret:   ret
+    S  (0x2A0)  mov eax,[esp+4]; add eax,eax      ; its range ends here...
+       S_rest:  xor eax,0x3c3c; ret               ; ...but its code does not
+"""
+
+import pytest
+
+from . import config
+from .translator import FunctionTranslator
+
+BASE = 0x10000
+CODE = {
+    0x000: "8b44240485c07c4583f077c3",
+    0x020: "8b44240483c003eb24",
+    0x040: "8b4424048d0480eb048b4424045389c36bdb0789d85bc3",
+    0x080: "ff742404e8c0ffffff83c404c3",
+    0x100: ("5631f68b4c240885c9742189c883e003ff24853001010083c601eb0d83c602eb08"
+            "83c603eb0383c60449ebdb89f05ec3170101001c0101002101010026010100"),
+    0x200: "568b74240831c04e740f83c00301f0f7c60100000075f0ebee5ec3",
+    0x280: "eb060f85c5fdffffc3",
+    0x2A0: "8b44240401c0353c3c0000c3",
+}
+A, C, B, D = BASE, BASE + 0x20, BASE + 0x40, BASE + 0x80
+B_CORE, B_BODY = BASE + 0x49, BASE + 0x4D
+F, F_LOOP, F_ARM0, G = BASE + 0x100, BASE + 0x107, BASE + 0x117, BASE + 0x11C
+F_ARM2, F_ARM3, F_NEXT, F_DONE, F_TABLE = (BASE + 0x121, BASE + 0x126,
+                                           BASE + 0x129, BASE + 0x12C,
+                                           BASE + 0x130)
+O, O_TOP, O_ALIAS, O_OUT = BASE + 0x200, BASE + 0x207, BASE + 0x20D, BASE + 0x219
+X, S, S_REST = BASE + 0x280, BASE + 0x2A0, BASE + 0x2A6
+# (start, end, detection method): F's range stops at the false start G.
+FUNCTIONS = [
+    (A, A + 0xC, "call_target"), (C, C + 9, "call_target"),
+    (B, B + 0x17, "call_target"), (D, D + 0xD, "call_target"),
+    (F, G, "call_target"), (G, F_TABLE, "imm_ref_target"),
+    (O, O + 0x1B, "call_target"), (O_ALIAS, O + 0x1B, "tail_jump_alias"),
+    (X, X + 9, "call_target"), (S, S_REST, "call_target"),
+]
+
+
+@pytest.fixture(autouse=True)
+def layout(monkeypatch):
+    monkeypatch.setattr(config, "_SECTIONS", [
+        config.Section(".text", BASE, 0x400, 0, 0x400, True),
+    ])
+
+
+def image():
+    raw = bytearray(b"\xcc" * 0x400)
+    for offset, code in CODE.items():
+        data = bytes.fromhex(code)
+        raw[offset:offset + len(data)] = data
+    return bytes(raw)
+
+
+def database():
+    return {start: {"_addr": start, "start": hex(start), "end": end,
+                    "size": end - start, "section": ".text",
+                    "name": f"sub_{start:08X}", "detection_method": method}
+            for start, end, method in FUNCTIONS}
+
+
+def lift(start):
+    subject = FunctionTranslator(image(), database())
+    code = subject.translate_function(start, subject.func_db[start])
+    return subject, code
+
+
+def test_conditional_jump_into_another_body_is_lifted_in_place():
+    subject, code = lift(A)
+    assert f"goto loc_{B_BODY:08X};" in code, code
+    assert f"loc_{B_BODY:08X}: ;" in code
+    assert "ebx = (uint32_t)((int32_t)ebx * (int32_t)7);" in code
+    # no call to a symbol nobody defines
+    assert f"sub_{B_BODY:08X}" not in code
+    assert B_BODY not in subject.lifter.referenced_calls
+
+
+def test_tail_jump_into_another_body_is_lifted_in_place():
+    subject, code = lift(C)
+    assert f"goto loc_{B_BODY:08X};" in code, code
+    assert f"sub_{B_BODY:08X}" not in code
+    # the shared code returns from C itself: one ret, popping only C's return address
+    assert code.count("esp += 4; return; /* ret */") == 1
+
+
+def test_false_start_keeps_its_owner_whole():
+    subject, code = lift(F)
+    # The switch's arms past the false start are this body's labels; the one at
+    # the false start is a function, reached by address.
+    for arm in (F_ARM0, F_ARM2, F_ARM3):
+        assert f"if (_jt == 0x{arm:08X}u) goto loc_{arm:08X};" in code, code
+    assert f"goto loc_{G:08X}" not in code
+    assert "RECOMP_ITAIL(_jt)" in code
+    # The loop stays a loop and the epilogue is F's own.
+    assert f"goto loc_{F_LOOP:08X};" in code
+    assert f"loc_{F_DONE:08X}: ;" in code
+    for target in (F_NEXT, F_DONE):
+        assert f"sub_{target:08X}" not in code
+    # G is untouched: still a function of its own.
+    assert subject.func_db[G]["end"] == F_TABLE
+    other = subject.translate_function(G, subject.func_db[G])
+    assert f"goto loc_{G:08X}; /* the entry" in other, other
+    assert f"if (_jt == 0x{F_ARM0:08X}u) goto loc_{F_ARM0:08X};" in other
+
+
+def test_alternate_entry_jumps_back_into_its_owner():
+    subject, code = lift(O_ALIAS)
+    # O_top lies below the entry: the body starts by going to the entry.
+    lines = code.splitlines()
+    first = next(i for i, line in enumerate(lines) if "goto loc_" in line)
+    assert f"goto loc_{O_ALIAS:08X}; /* the entry" in lines[first], code
+    assert f"loc_{O_ALIAS:08X}: ;" in code
+    assert f"loc_{O_TOP:08X}: ;" in code
+    assert f"sub_{O_TOP:08X}" not in code
+    assert "esi--;" in code
+
+
+def test_runs_off_its_range_into_code_no_function_covers():
+    subject, code = lift(S)
+    assert "eax = eax ^ 0x3C3C;" in code, code
+    assert f"sub_{S_REST:08X}" not in code
+
+
+def test_bytes_nothing_reaches_are_not_followed():
+    subject, code = lift(X)
+    assert f"loc_{B_BODY:08X}: ;" not in code, code
+    assert "imul" not in code
