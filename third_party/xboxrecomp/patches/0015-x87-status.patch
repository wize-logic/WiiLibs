From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Wed, 14 Oct 2026 22:00:00 -0400
Subject: [PATCH] recomp: sahf reads AH; fprem and the transcendentals write C2

sahf copies AH into SF, ZF, PF and CF, but the conditions after it were
answered from g_fp_cmp, the last x87 compare, as if AH could only have
come from `fnstsw ax` straight after one. The status word also carries
what fprem, fxam and the transcendentals report, and the CRT's argument
reduction is

    again: fprem1
           fnstsw ax
           sahf
           jp again        ; C2: the reduction is not finished

fprem never wrote the condition codes either, so with the thread's last
compare unordered (a NaN: C3, C2 and C0 set) the loop read "not
finished" from both sides and spun forever, inside sin, cos or fmod.

- sahf is lifted as a snapshot of AH into a function local, _sahf, and
  the conditions read its bits: CF bit 0, PF bit 2, ZF bit 6, SF bit 7.
  OF is not touched by sahf, so the signed conditions stay unanswered.
- fprem and fprem1 set C2 = 0 (one call does the whole reduction) and
  the quotient's three low bits in C0, C3 and C1, through a new header
  helper, recomp_fprem_cc (remquo's bits, one less in magnitude for
  fprem's truncated quotient when the nearest one overshot).
- fsin, fcos, fsincos and fptan clear C2 for |st0| < 2^63; beyond that
  they leave st0 alone and set C2, as the hardware does, and the caller
  reduces the argument and tries again.

fxam already wrote C3, C2 and C0; with sahf reading AH its result now
reaches the flags too.

Tests: test_x87_status.py. Conformance cases fpu_fprem1_status,
fpu_fprem_status, fpu_fsin_c2, fpu_fcos_c2, fpu_fptan_c2, fpu_fsincos_c2,
fpu_fxam_sahf and fpu_fcom_sahf run each after an unordered compare,
against the CPU.
---
diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -284,6 +284,25 @@
 #define RECOMP_FP_PC_CW(cw, x) (((cw) & 0x300u) ? (double)(x) : recomp_fp_round24(x))
 #define RECOMP_FP_PC(x) RECOMP_FP_PC_CW(g_fp_control_word, x)
 #define RECOMP_FCMP_CC(c) ((uint16_t)((c)==2 ? 0x4500u : (c)<0 ? 0x0100u : (c)>0 ? 0u : 0x4000u))
+/* fprem (nearest 0) and fprem1 (nearest 1): the condition codes they leave, C2
+ * clear (the reduction is complete) and the quotient's three low bits in C0
+ * (bit 2), C3 (bit 1) and C1 (bit 0). remquo gives those bits for the quotient
+ * rounded to nearest; fprem's is truncated, one less in magnitude when the
+ * nearest one overshot (its remainder then has the other sign from a). An
+ * invalid operand (a infinite, b zero, either NaN) reports 0. */
+static inline uint16_t recomp_fprem_cc(double a, double b, int nearest) {
+    int q = 0;
+    double r;
+    unsigned m;
+    if (a != a || b != b || b == 0.0 || !(fabs(a) <= 0x1.fffffffffffffp1023))
+        return 0;
+    r = remquo(a, b, &q);
+    m = (unsigned)(q < 0 ? -q : q);
+    if (!nearest && r != 0.0 && (signbit(r) != 0) != (signbit(a) != 0))
+        m -= 1u;
+    return (uint16_t)(((m & 4u) ? 0x0100u : 0u) | ((m & 2u) ? 0x4000u : 0u) |
+                      ((m & 1u) ? 0x0200u : 0u));
+}
 /* Values in the existing double-backed stack are all representable as normal
  * x87 extended values, including binary64 subnormals. Empty stack tags and
  * unsupported extended encodings are not represented by this stack model. */
diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -620,3 +620,52 @@
         ("rep_copy_zero", ["mov esi, eax", "lea edi, [eax+16]"], 0, "rep movsd", "mov eax, [edi]")):
     CASES.append(Case(_name, "REP copy preserves element order, direction and count",
         ["cld"] + _setup + ["mov ecx, %d" % _count, _copy, "cld", _result], _SSE, "sse"))
+
+# The x87 status word as sahf reads it. sahf's flags are AH -- whatever put it
+# there -- and C2 (PF) is how fprem says "not finished" and the
+# transcendentals say "out of range". Each case first leaves an unordered
+# compare behind (a quiet NaN against itself: C3, C2 and C0 set), which is
+# what made the CRT's `fprem1; fnstsw ax; sahf; jp again` spin forever when
+# sahf was answered from the last compare and fprem never wrote C2.
+_UNORDERED_FIRST = ["mov dword ptr [eax+32], 0", "mov dword ptr [eax+36], 07FF80000h",
+                    "fld qword ptr [eax+32]", "fld st(0)", "fucompp"]
+# Quotients with odd and even low bits, both signs, ties (6.5 and 7.5 by 1
+# round to 6 and 8 for fprem1, truncate to 6 and 7 for fprem), and exponents
+# close enough (under 64 apart) that the hardware finishes in one step.
+_FPREM = [(100.0, 7.0), (-100.0, 7.0), (100.0, -7.0), (7.0, 100.0),
+          (-3.25, 0.5), (2.5, 2.0), (-2.5, 2.0), (5.5, 2.0), (1e10, 3.0),
+          (17.0, 3.0), (-17.0, -3.0), (0.0, 1.0), (-0.0, 1.0), (6.5, 1.0),
+          (7.5, 1.0), (-7.5, 1.0), (1e15, 0.1), (3.0, 3.0), (29.0, 4.0)]
+_TRIG = [(0.5, 0.0), (-2.0, 0.0), (3.0, 0.0), (1e19, 0.0), (-1e300, 0.0),
+         (float("inf"), 0.0), (float("nan"), 0.0)]
+CASES += [
+    Case("fpu_fprem1_status", "fprem1 clears C2 and reports the quotient's low bits",
+         _UNORDERED_FIRST + ["fld qword ptr [eax+16]", "fld qword ptr [eax]", "fprem1",
+                             "fnstsw ax", "sahf", "setp cl", "fstp st(1)",
+                             "and eax, 04700h", "or al, cl"], _FPREM, "fpu"),
+    Case("fpu_fprem_status", "fprem: the truncated quotient's low bits, C2 clear",
+         _UNORDERED_FIRST + ["fld qword ptr [eax+16]", "fld qword ptr [eax]", "fprem",
+                             "fnstsw ax", "sahf", "setp cl", "fstp st(1)",
+                             "and eax, 04700h", "or al, cl"], _FPREM, "fpu"),
+    Case("fpu_fsin_c2", "fsin clears C2 in range; out of range st0 stays and C2 is set",
+         _UNORDERED_FIRST + ["fld qword ptr [eax]", "fsin", "fnstsw ax", "sahf",
+                             "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
+    Case("fpu_fcos_c2", "fcos reports its range in C2 the same way",
+         _UNORDERED_FIRST + ["fld qword ptr [eax]", "fcos", "fnstsw ax", "sahf",
+                             "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
+    Case("fpu_fptan_c2", "fptan pushes 1.0 only in range, and says which in C2",
+         _UNORDERED_FIRST + ["fld qword ptr [eax]", "fptan", "fnstsw ax", "sahf",
+                             "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
+    Case("fpu_fsincos_c2", "fsincos pushes the cosine only in range",
+         _UNORDERED_FIRST + ["fld qword ptr [eax]", "fsincos", "fnstsw ax", "sahf",
+                             "setp cl", "and eax, 0400h", "or al, cl"], _TRIG, "fpu", tol=1e-15),
+    Case("fpu_fxam_sahf", "fxam's class bits reach CF, PF and ZF through sahf",
+         _UNORDERED_FIRST + ["fld qword ptr [eax]", "fxam", "fnstsw ax", "sahf",
+                             "setc cl", "setp dl", "setz al", "fstp st(0)", "shl al, 2",
+                             "shl dl, 1", "or al, dl", "or al, cl", "movzx eax, al"],
+         _FP_NAN + [(5e-324, 0.0), (-float("inf"), 0.0)], "fpu"),
+    Case("fpu_fcom_sahf", "fcompp; fnstsw ax; sahf: CF, ZF and PF are C0, C3 and C2",
+         ["fld qword ptr [eax+16]", "fld qword ptr [eax]", "fcompp", "fnstsw ax", "sahf",
+          "seta cl", "setb ch", "setz dl", "setp dh", "shl ch, 1", "shl dl, 2", "shl dh, 3",
+          "or cl, ch", "or cl, dl", "or cl, dh", "movzx eax, cl"], _FP_NAN, "fpu"),
+]
diff --git a/tools/conformance/harness.py b/tools/conformance/harness.py
