 tools/recomp/__main__.py         |  4 ++
 tools/recomp/mem_disp.py         | 79 ++++++++++++++++++++++++++++++++
 tools/recomp/test_mem_disp.py    | 49 ++++++++++++++++++++
 tools/recomp/translator.py       |  8 ++++
 5 files changed, 154 insertions(+)
 create mode 100644 tools/recomp/mem_disp.py
