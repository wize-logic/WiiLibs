diff --git a/tools/recomp/test_reg_locals.py b/tools/recomp/test_reg_locals.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_reg_locals.py
@@ -0,0 +1,153 @@
+"""
+--reg-locals: a function's integer registers in C locals.
+
+The generated code names the guest registers eax .. edi and esp, macros for
+the globals g_eax .. g_esp. Guest memory is reached through volatile accesses
+the compiler must assume alias them, so every guest store made it reload
+each register. With --reg-locals, x87_locals.py keeps them in locals
+(_r_eax ..) inside a function, written back before anything that calls out
+or leaves and loaded again where next needed. These checks cover what it
+emits.
+"""
+
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import config  # noqa: E402
+from tools.recomp.translator import (FunctionTranslator, FP_STACK_MACROS,  # noqa: E402
+                                     FP_STACK_UNDEFS)
+from tools.recomp.x87_locals import localise_x87  # noqa: E402
+
+BASE = 0x00010000
+
+
+def _translate(image, funcs=((0, None),), x87=True, regs=True):
+    config._install(
+        [config.Section(".text", BASE, len(image), 0x0000, len(image), True)],
+        entry_point=BASE, kernel_thunk_addr=BASE, origin="reg-locals-test")
+    db = {}
+    bounds = [off for off, _ in funcs] + [len(image)]
+    for (off, _), end in zip(funcs, bounds[1:]):
+        db[BASE + off] = {"start": f"0x{BASE + off:08X}", "end": BASE + end,
+                          "_addr": BASE + off, "size": end - off}
+    t = FunctionTranslator(image, db)
+    t.x87_locals, t.reg_locals = x87, regs
+    return t.translate_function(BASE, db[BASE]), t
+
+
+def _localise(body, x87=True):
+    lines = ["void f(void)", "{"] + body + ["}", ""]
+    return localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS, x87=x87, regs=True)
+
+
+def test_integer_code_keeps_its_registers_in_locals():
+    # mov eax, [0x2000]; add eax, 1; mov [0x2004], eax; ret
+    image = b"\xA1\x00\x20\x00\x00" b"\x83\xC0\x01" b"\xA3\x04\x20\x00\x00" b"\xC3"
+    code, t = _translate(image)
+    body = code.split("#define _LOCALS_LOAD()")[1].split("\n", 1)[1]
+    assert "_r_eax = MEM32(0x2000);" in body, code
+    assert "_r_eax = _r_eax + 1;" in body, code
+    assert "MEM32(0x2004) = _r_eax;" in body, code
+    # written back before the return, with esp (which the ret moves, on the global)
+    ret = body.index("return;")
+    assert re.search(r"g_eax = _r_eax;[^\n]*\n[^\n]*return;", body[:ret + 8]), code
+    assert t.x87_stats == {"in locals": 1}
+
+
+def test_off_by_default():
+    image = b"\xA1\x00\x20\x00\x00" b"\xC3"
+    code, t = _translate(image, x87=False, regs=False)
+    assert "_r_" not in code and "eax = MEM32(0x2000);" in code, code
+
+
+def test_a_call_writes_back_what_was_written_and_the_next_statement_loads():
+    # +0 mov eax, [0x2000]; +5 mov ecx, ebx; +7 call +16; +12 add eax, ecx; +14 ret; ... +17 ret
+    image = (b"\xA1\x00\x20\x00\x00" b"\x89\xD9" b"\xE8\x05\x00\x00\x00" b"\x01\xC8" b"\xC3"
+             b"\x90\x90" b"\xC3")
+    code, _ = _translate(image, funcs=((0, None), (17, None)))
+    call = code.index("RECOMP_ABI_CALL")
+    before = code[:call].splitlines()[-2]
+    # eax and ecx were written; ebx was only read and stays as it is in memory
+    assert "g_eax = _r_eax;" in before and "g_ecx = _r_ecx;" in before, code
+    assert "g_ebx = " not in before, code
+    after = code[call:]
+    assert after.index("_LOCALS_LOAD();") < after.index("_r_eax = _r_eax + _r_ecx;"), code
+
+
+def test_registers_a_macro_may_assign_count_as_written():
+    out, why = _localise(["    SET_LO8(eax, 1);", "    PUSH32(esp, ebx);", "    POP32(esp, edi);",
+                          "    MEM32(esi + 4) = edx;", "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    back = [l for l in out if "state to memory" in l][0]
+    for r in ("eax", "esp", "edi"):
+        assert f"g_{r} = _r_{r};" in back, text
+    for r in ("ebx", "esi", "edx"):
+        assert f"g_{r} = " not in back, text
+
+
+def test_a_register_whose_address_is_taken_runs_on_memory():
+    out, why = _localise(["    eax = 1;", "    { uint32_t *p = &ebx; *p = 2; }", "    ebx = ebx + eax;",
+                          "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    i = text.index("{ uint32_t *p = &ebx; *p = 2; }")
+    assert "g_eax = _r_eax;" in text[:i].rstrip().splitlines()[-1], text
+    assert text.index("_LOCALS_LOAD();", i) < text.index("_r_ebx = _r_ebx + _r_eax;"), text
+
+
+def test_a_block_over_several_lines_is_rewritten_line_by_line():
+    out, why = _localise(["    ecx = 4;",
+                          "    while (ecx != 0) {",
+                          "        MEM8(edi) = MEM8(esi);",
+                          "        esi++; edi++; ecx--;",
+                          "    }",
+                          "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    assert "    while (_r_ecx != 0) {" in text, text
+    assert "        MEM8(_r_edi) = MEM8(_r_esi);" in text, text
+    assert "        _r_esi++; _r_edi++; _r_ecx--;" in text, text
+    back = [l for l in out if "state to memory" in l][0]
+    assert all(f"g_{r} = _r_{r};" in back for r in ("ecx", "esi", "edi")), text
+
+
+def test_without_x87_locals_the_x87_macros_stay():
+    out, why = _localise(FP_STACK_MACROS + ["    fp_push(MEMF(eax + 8));",
+                                            "    MEMF_SET(ecx, (float)fp_top()); fp_pop();",
+                                            "    return;"] + FP_STACK_UNDEFS, x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    assert "    fp_push(MEMF(_r_eax + 8));" in text, text
+    assert "    MEMF_SET(_r_ecx, (float)fp_top()); fp_pop();" in text, text
+
+
+def test_the_x87_base_is_there_when_only_the_status_word_or_a_pop_needs_it():
+    out, why = _localise(FP_STACK_MACROS + [
+        "    eax = (eax & 0xFFFF0000u) | (uint32_t)(uint16_t)(((g_fp_top & 7u) << 11) | g_fp_cc);",
+        "    fp_pop();", "    return;"] + FP_STACK_UNDEFS)
+    assert why is None, why
+    text = "\n".join(out)
+    assert "uint32_t _x87t = 0;" in text and "_x87t = (uint32_t)g_fp_top;" in text, text
+    assert "g_fp_top = (int)((_x87t + 1u) & 7u);" in text, text
+
+
+def test_a_statement_that_calls_out_runs_on_the_globals():
+    out, why = _localise(["    eax = 5;", "    PUSH32(esp, eax); RECOMP_ABI_CALL(0x1000u, sub_00001000);",
+                          "    ecx = eax;", "    return;"], x87=False)
+    assert why is None, why
+    text = "\n".join(out)
+    assert "    PUSH32(esp, eax); RECOMP_ABI_CALL(0x1000u, sub_00001000);" in text, text
+    call = text.index("    PUSH32(esp, eax); RECOMP_ABI_CALL")
+    assert "g_eax = _r_eax;" in text[:call].rstrip().splitlines()[-1], text
+    assert text.index("_LOCALS_LOAD();", call) < text.index("_r_ecx = _r_eax;"), text
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_"):
+            fn()
+    print("ok")
