@@ -1311,6 +1312,9 @@ class FunctionTranslator:
     # and direct edges. A range also holds bytes nothing reaches (a jump
     # table decoded as instructions), and their "jumps" are not followed.
     #
+    # A called address inside lifted code gets a function of its own
+    # (discover_interior_entries), since a call needs a symbol to call.
+
