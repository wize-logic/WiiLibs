diff --git a/tools/recomp/test_x87_balanced.py b/tools/recomp/test_x87_balanced.py
new file mode 100644
index 0000000..603144e
--- /dev/null
+++ b/tools/recomp/test_x87_balanced.py
@@ -0,0 +1,180 @@
+"""
+--x87-balanced: a caller's x87 stack positions stay in its locals across a
+direct call to a callee that pops what it pushes and names no slot it did not
+push (touched.balanced, x87_locals.x87_balanced).
+"""
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import touched  # noqa: E402
+from tools.recomp.translator import FP_STACK_MACROS, FP_STACK_UNDEFS  # noqa: E402
+from tools.recomp.x87_locals import localise_x87  # noqa: E402
+
+
+def _fn(name, body):
+    return ["static void %s(void)" % name, "{"] + FP_STACK_MACROS + body + FP_STACK_UNDEFS + ["}", ""]
+
+
+def _call(name, ret=0x1000):
+    return "    PUSH32(esp, 0x%08Xu); RECOMP_ABI_CALL(0x%su, %s); /* call */" % (ret, name[4:], name)
+
+
+# a leaf that pushes, works and pops all it pushed
+LEAF = ["    fp_push(MEMD(0x2000));", "    fp_push(fp_st(0) * 2.0);", "    fp_st(1) = fp_st(1) + fp_top();",
+        "    fp_pop();", "    MEMD_SET(0x2010, fp_top());", "    fp_pop();", "    return;"]
+# it calls itself with its own value live: balanced if its body is, given the calls are
+RECURSIVE = ["    fp_push(MEMD(0x2000) + (double)ecx);", "    if (ecx == 0) goto loc_00003020;", "    ecx = ecx - 1;",
+             _call("sub_00003000", 0x3010), "    ecx = ecx + 1;", "loc_00003020: ;",
+             "    MEMD_SET(0x2020 + ecx * 8, fp_top() * 3.0);", "    fp_pop();", "    return;"]
+
+
+def _analyse(funcs):
+    return touched.balanced(funcs, touched.analyse(funcs))
+
+
+def test_what_is_balanced():
+    funcs = {
+        "sub_00001000": _fn("sub_00001000", LEAF),
+        # reads st(0) of its caller
+        "sub_00002000": _fn("sub_00002000", ["    MEMD_SET(0x2010, fp_top());", "    return;"]),
+        "sub_00003000": _fn("sub_00003000", RECURSIVE),
+        # leaves a result in st(0)
+        "sub_00004000": _fn("sub_00004000", ["    fp_push(1.0);", "    return;"]),
+        # pops one of its caller's
+        "sub_00005000": _fn("sub_00005000", ["    fp_pop();", "    fp_push(1.0);", "    fp_pop();", "    return;"]),
+        # balanced itself, but calls one that is not
+        "sub_00006000": _fn("sub_00006000", ["    fp_push(1.0);", _call("sub_00004000"), "    fp_pop();",
+                                             "    fp_pop();", "    return;"]),
+        # a pop that may not happen
+        "sub_00007000": _fn("sub_00007000", ["    fp_push(1.0);", "    if (eax) fp_pop();", "    return;"]),
+        # paths that join at different depths
+        "sub_00008000": _fn("sub_00008000", ["    fp_push(1.0);", "    if (eax) goto loc_00008010;", "    fp_pop();",
+                                             "loc_00008010: ;", "    return;"]),
+        # writes the slot below its own (fstp st(1) at depth 1 is st(0) of the caller)
+        "sub_00009000": _fn("sub_00009000", ["    fp_push(1.0);", "    fp_st(1) = fp_top();", "    fp_pop();",
+                                             "    return;"]),
+        # calls the balanced leaf and an integer function, reads TOP
+        "sub_0000A000": _fn("sub_0000A000", ["    fp_push(1.0);", _call("sub_00001000"), _call("sub_0000B000"),
+                                             "    eax = (g_fp_top & 7u);", "    fp_pop();", "    return;"]),
+        "sub_0000B000": ["static void sub_0000B000(void)", "{", "    eax = 1;", "    return;", "}", ""],
+        # a jump back into the body at a depth the C text does not show
+        "sub_0000C000": _fn("sub_0000C000", ["    if (setjmp(g_jb)) goto loc_0000C010;", "    fp_push(1.0);",
+                                             "    fp_pop();", "loc_0000C010: ;", "    return;"]),
+    }
+    t = _analyse(funcs)
+    bal = {n for n, s in t.items() if touched.X87_BALANCED in s}
+    assert bal == {"sub_00001000", "sub_00003000", "sub_0000A000"}, bal
+    assert touched.X87_BALANCED not in t["sub_0000B000"] and touched.X87 not in t["sub_0000B000"]
+
+
+CALLER = ["    fp_push(MEMD(0x2100));", "    fp_push(MEMD(0x2108));", "    fp_st(1) = fp_st(1) * fp_top();",
+          _call("sub_00001000", 0x1010),
+          "    fp_st(1) = fp_st(1) - fp_top();", "    fp_pop();", "    MEMD_SET(0x2110, fp_top());", "    fp_pop();",
+          "    return;"]
+
+
+def test_the_caller_keeps_its_positions_across_a_balanced_call():
+    funcs = {"sub_00001000": _fn("sub_00001000", LEAF), "sub_00000100": _fn("sub_00000100", CALLER)}
+    out, why = localise_x87(funcs["sub_00000100"], FP_STACK_MACROS, FP_STACK_UNDEFS, x87=True, regs=True,
+                            touched=_analyse(funcs))
+    assert why is None, why
+    text = "\n".join(out)
+    i = [k for k, line in enumerate(out) if "RECOMP_ABI_CALL" in line][0]
+    # the depth goes to g_fp_top (the callee starts there), the values stay in their locals
+    assert "g_fp_top = (int)((_x87t + 6u) & 7u);" in out[i - 1], text
+    assert "g_fp_stack[" not in out[i - 1] and "_LOCALS_LOAD" not in out[i + 1], text
+    assert "_x87sm1 = _x87sm1 - _x87sm2;" in text, text
+    # without the mark, the call is a sync as before
+    out2, _ = localise_x87(funcs["sub_00000100"], FP_STACK_MACROS, FP_STACK_UNDEFS, x87=True, regs=True,
+                           touched=touched.analyse(funcs))
+    assert "_LOCALS_LOAD();" in "\n".join(out2) and "g_fp_stack[(_x87t" in "\n".join(out2)
+
+
+HARNESS = r"""
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+static double g_fp_stack[8];
+static uint32_t g_fp_top;
+static uint16_t g_fp_control_word;
+static int g_fp_cmp;
+static uint16_t g_fp_cc;
+static uint32_t g_eax, g_ecx, g_edx, g_ebx, g_esp = 0x8000, g_esi, g_edi;
+#define eax g_eax
+#define ecx g_ecx
+#define edx g_edx
+#define ebx g_ebx
+#define esp g_esp
+#define esi g_esi
+#define edi g_edi
+static unsigned char mem[0x3000];
+static double MEMD(uint32_t a) { double d; memcpy(&d, mem + a, 8); return d; }
+#define MEMD_SET(a, v) do { double _d = (v); memcpy(mem + (a), &_d, 8); } while (0)
+#define PUSH32(r, v) ((r) -= 4u)
+#define RECOMP_ABI_CALL(a, f) do { f(); esp += 4u; } while (0)
+"""
+
+
+def _run(text, tmp, name):
+    cc = shutil.which("gcc") or shutil.which("clang")
+    src, exe = os.path.join(tmp, name + ".c"), os.path.join(tmp, name)
+    main = r"""
+int main(void) {
+    for (int i = 0; i < 0x3000 / 8; i++) { double d = 0.25 * i - 7.0; memcpy(mem + 8 * i, &d, 8); }
+    for (uint32_t top = 0; top < 8; top++) {
+        g_fp_top = top; g_ecx = 3;
+        g_fp_stack[top] = 42.0; g_fp_stack[(top + 1) & 7] = -5.5;  /* the caller's caller's values */
+        sub_00000100();
+        printf("%u %u %.17g %.17g\n", top, g_fp_top, g_fp_stack[top], g_fp_stack[(top + 1) & 7]);
+    }
+    for (int i = 0x2000; i < 0x2140; i += 8) printf("%.17g\n", MEMD(i));
+    return 0;
+}
+"""
+    with open(src, "w") as f:
+        f.write(HARNESS + text + main)
+    subprocess.run([cc, "-std=gnu11", "-O2", "-w", "-o", exe, src], check=True)
+    return subprocess.run([exe], check=True, capture_output=True, text=True).stdout
+
+
+def test_balanced_calls_compute_what_the_memory_model_computes():
+    if not (shutil.which("gcc") or shutil.which("clang")):
+        pytest.skip("C compiler unavailable")
+    # the caller holds two values over the leaf and the recursion; the recursion
+    # holds its own over itself
+    caller = CALLER[:3] + [_call("sub_00003000", 0x1008)] + CALLER[3:]
+    funcs = {"sub_00001000": _fn("sub_00001000", LEAF), "sub_00003000": _fn("sub_00003000", RECURSIVE),
+             "sub_00000100": _fn("sub_00000100", caller)}
+    t = _analyse(funcs)
+    assert touched.X87_BALANCED in t["sub_00003000"]
+    protos = "".join("static void %s(void);\n" % n for n in funcs)
+    plain = protos + "\n".join("\n".join(lines) for lines in funcs.values())
+    done, kept = [], 0
+    for n, lines in funcs.items():
+        out, why = localise_x87(lines, FP_STACK_MACROS, FP_STACK_UNDEFS, x87=True, regs=True, touched=t)
+        assert why is None, (n, why)
+        kept += sum(1 for line in out if "RECOMP_ABI_CALL" in line) - sum(
+            1 for k, line in enumerate(out) if "RECOMP_ABI_CALL" in line and "_LOCALS_LOAD" in out[k + 1])
+        done.append("\n".join(out))
+    assert kept == 3  # every call site keeps the locals
+    with tempfile.TemporaryDirectory() as tmp:
+        a = _run(plain, tmp, "plain")
+        b = _run(protos + "\n".join(done), tmp, "locals")
+    assert a == b, (a, b)
+    assert re.search(r"^0 0 42 -5.5$", a, re.M), a
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_"):
+            fn()
+    print("ok")
