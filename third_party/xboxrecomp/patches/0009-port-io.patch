diff --git a/tools/recomp/test_lifter_port_io.py b/tools/recomp/test_lifter_port_io.py
new file mode 100644
index 0000000..b1f7d8c
--- /dev/null
+++ b/tools/recomp/test_lifter_port_io.py
@@ -0,0 +1,54 @@
+"""
+in/out reach RECOMP_PORT_IN / RECOMP_PORT_OUT.
+
+They were RECOMP_UNIMPL: a no-op that left the destination register as it
+was. Direct3D reads the TV encoder's field from port 0x80C0 that way, so its
+interlaced flip parity came from whatever eax held before.
+"""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import config  # noqa: E402
+from tools.recomp.translator import FunctionTranslator  # noqa: E402
+
+BASE = 0x00010000
+
+
+def _translate(image):
+    config._install(
+        [config.Section(".text", BASE, len(image), 0x0000, len(image), True)],
+        entry_point=BASE, kernel_thunk_addr=BASE, origin="port-io-test")
+    db = {BASE: {"start": f"0x{BASE:08X}", "end": BASE + len(image),
+                 "_addr": BASE, "size": len(image)}}
+    return FunctionTranslator(image, db).translate_function(BASE, db[BASE])
+
+
+def test_in_al_dx_reads_a_byte_from_the_port_in_dx():
+    # mov dx, 0x80C0; in al, dx; ret
+    code = _translate(b"\x66\xBA\xC0\x80" b"\xEC" b"\xC3")
+    assert "RECOMP_PORT_IN((uint32_t)(" in code, code
+    assert ", 1)" in code, code
+    assert "RECOMP_UNIMPL" not in code, code
+
+
+def test_in_eax_imm_reads_a_dword():
+    # in eax, 0x10; ret
+    code = _translate(b"\xE5\x10" b"\xC3")
+    assert "RECOMP_PORT_IN" in code and ", 4)" in code, code
+
+
+def test_out_dx_al_writes_a_byte():
+    # out dx, al; ret
+    code = _translate(b"\xEE" b"\xC3")
+    assert "RECOMP_PORT_OUT((uint32_t)(" in code, code
+    assert ", 1);" in code, code
+
+
+if __name__ == "__main__":
+    test_in_al_dx_reads_a_byte_from_the_port_in_dx()
+    test_in_eax_imm_reads_a_dword()
+    test_out_dx_al_writes_a_byte()
+    print("ok")
-- 
