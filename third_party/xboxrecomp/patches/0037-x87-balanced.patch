index 14cf9d7..9a19643 100644
--- a/tools/recomp/touched.py
+++ b/tools/recomp/touched.py
@@ -24,7 +24,12 @@ code it interrupts as they were (wl_xb_call_guest_preserving).
 
 import re
 
+from .x87_locals import x87_balanced
+
 X87 = "x87"  # the x87 stack (g_fp_top, g_fp_stack): a caller's x87 locals do not survive it
+# with X87: the function leaves the stack as deep as it found it and names no slot that was on
+# it (x87_locals.x87_balanced, with all it calls): a caller's x87 locals do survive it
+X87_BALANCED = "x87 balanced"
 
 _REG = re.compile(r"\b(?:g_)?(eax|ecx|edx|ebx|esp|esi|edi|xmm[0-7]|mm[0-7])\b")
 _X87_SCALAR = re.compile(r"\b(g_fp_control_word|g_fp_cmp|g_fp_cc)\b")
@@ -115,3 +120,37 @@ def analyse(functions):
             if len(t) != before:
                 changed = True
     return {n: frozenset(t) for n, t in touch.items()}
+
+
+def balanced(functions, touch):
+    """touch as analyse returns it, with X87_BALANCED added to the set of each
+    function that uses the x87 stack in a balanced way: on every path it pops
+    what it pushed and no more, and reads and writes only the slots it pushed,
+    and so does everything it calls (x87_locals.x87_balanced). A caller can
+    then keep its own x87 values in locals across a call to it: they are
+    below what the callee uses.
+
+    The answer is the greatest fixpoint: every candidate is assumed balanced
+    and the ones that are not (alone, or because of a callee that is not) are
+    dropped until none is. A function that calls itself (or a cycle of them)
+    is balanced when its body is, given that the calls are: each call that
+    returns ran a path that is balanced by the same argument one level
+    deeper, down to a call that makes no more."""
+    cand = {n for n, t in touch.items() if X87 in t and n in functions}
+    callers = {}
+    for n in cand:
+        for c in set(_FUNC.findall(_strip("\n".join(functions[n])))):
+            callers.setdefault(c, set()).add(n)
+
+    def ok(c):
+        t = touch.get(c)
+        return t is not None and (X87 not in t or c in cand)
+
+    work = sorted(cand)
+    while work:
+        n = work.pop()
+        if n in cand and not x87_balanced(functions[n], ok):
+            cand.discard(n)
+            work.extend(sorted(callers.get(n, ()) & cand))
+    return {n: (t | {X87_BALANCED} if n in cand else t) for n, t in touch.items()}
+
