+
+def _reg_written(text, start, end):
+    """Whether the register token text[start:end] may be assigned: an
+    assignment or ++/-- on it, or an argument of a macro that may assign it
+    (looked for through grouping parentheses, casts and subscripts)."""
+    if _WRITE_AFTER.match(text, end) or _WRITE_BEFORE.search(text[:start]):
+        return True
+    depth, arg, i = 0, 0, start - 1
+    while i >= 0:
+        c = text[i]
+        if c in ")]":
+            depth += 1
+        elif c in "([" and depth:
+            depth -= 1
+        elif c == "," and depth == 0:
+            arg += 1
+        elif c in "([":
+            m = re.search(r"([A-Za-z_]\w*)\s*$", text[:i]) if c == "(" else None
+            name = m.group(1) if m else None
+            if name and name not in _KEYWORDS:
+                if name in _REG_WRITERS:
+                    return arg in _REG_WRITERS[name]
+                if name in _REG_READERS or not name.isupper():
+                    return False
+                return True  # an unknown macro: it may assign its argument
+            arg = 0  # a grouping: the expression it is part of is an argument further out
+        i -= 1
+    return False
+
