diff --git a/tools/recomp/test_rep_short.py b/tools/recomp/test_rep_short.py
new file mode 100644
index 0000000..189062d
--- /dev/null
+++ b/tools/recomp/test_rep_short.py
@@ -0,0 +1,115 @@
+"""rep movs and rep stos with a zero count or one to three elements, and with the count the
+instruction before them states (`mov ecx, n`, `and ecx, n`).
+
+Each emitted block runs against an access-counting guest-memory fixture, at every element width,
+for every count the hint allows, over ordinary memory, an overlapping forward copy, the backward
+direction and the hardware aperture: the bytes, esi, edi and ecx are the instruction's, a zero count
+touches nothing, and the short forms make one guest access per element read or written (so an MMIO
+window sees each element, as the hardware's) and never reach memcpy or memset.
+"""
+from tools.recomp.lifter import Lifter, lift_basic_block
+from tools.recomp.disasm import BasicBlock, Instruction, Operand
+from tools.recomp.test_rep_movs_mmio import _build_and_run
+
+_NAMES = {("movs", 1): "rep movsb", ("movs", 2): "rep movsw", ("movs", 4): "rep movsd",
+          ("stos", 1): "rep stosb", ("stos", 2): "rep stosw", ("stos", 4): "rep stosd"}
+# (C name, hint for the lifter, counts the hint allows)
+_HINTS = [("any", None, range(0, 10)), ("max3", ("max", 3), range(0, 4)),
+          ("max1", ("max", 1), range(0, 2))] + [
+          (f"exact{n}", ("exact", n), (n,)) for n in range(0, 6)]
+
+
+def _lift(op, size, hint):
+    lifter = Lifter()
+    lifter.rep_count = hint
+    return "".join(lifter.lift_instruction(Instruction(0, 2, _NAMES[op, size], "", "")))
+
+
+def test_rep_short_forms_match_the_instruction():
+    prelude = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+uint32_t eax,esi,edi,ecx;
+int g_df;
+unsigned accesses, calls;
+uint8_t mem[131076],refmem[131076];
+unsigned slot(uint32_t a){return (a&0xffffu)+(a>=0xFD000000u?65536u:0u);}
+void* touch(uint32_t a){accesses++;return mem+slot(a);}
+#define XBOX_PTR(a) (mem+slot(a))
+#define MEM8(a) (*(volatile uint8_t*)touch(a))
+#define MEM16(a) (*(volatile uint16_t*)touch(a))
+#define MEM32(a) (*(volatile uint32_t*)touch(a))
+#define LO8(x) ((uint8_t)(x))
+#define LO16(x) ((uint16_t)(x))
+#define RECOMP_DF_STEP(s) (g_df?-(s):(s))
+static void *count_memcpy(void *d, const void *s, size_t n){calls++;return memcpy(d,s,n);}
+static void *count_memset(void *d, int v, size_t n){calls++;return memset(d,v,n);}
+#define memcpy count_memcpy
+#define memset count_memset
+typedef void (*fn)(void);
+'''
+    funcs, table = [], []
+    for op in ("movs", "stos"):
+        for size in (1, 2, 4):
+            for name, hint, counts in _HINTS:
+                f = f"{op}{size}_{name}"
+                funcs.append(f"void {f}(void){{{_lift(op, size, hint)}}}")
+                table.append(f'{{{f},"{f}",{1 if op == "movs" else 0},{size},'
+                             f'{min(counts)},{max(counts)}}}')
+    main = r'''
+#undef memcpy
+#undef memset
+struct { fn f; const char *name; int movs; unsigned z, lo, hi; } cases[] = {''' + ",".join(table) + r'''};
+int main(void){
+    for(unsigned c=0;c<sizeof cases/sizeof cases[0];c++) for(unsigned mode=0;mode<5;mode++)
+    for(unsigned n=cases[c].lo;n<=cases[c].hi;n++){
+        unsigned z=cases[c].z; int movs=cases[c].movs;
+        uint32_t s=0x100,d=0x400,v=0x9A8B7C6Du; int df=0;
+        if(mode==1)d=s+z;                    /* forward overlap: the pattern propagates */
+        if(mode==2){s+=8*z;d=s-z;df=1;}     /* backwards */
+        if(mode==3)d=0xFD000400;            /* hardware */
+        if(mode==4)s=0xFD000100;
+        for(unsigned i=0;i<sizeof mem;i++)mem[i]=refmem[i]=(uint8_t)(i*37+13);
+        uint32_t rs=s,rd=d;
+        for(unsigned i=0;i<n;i++){
+            uint8_t e[4];
+            if(movs)memcpy(e,refmem+slot(rs),z); else memcpy(e,&v,z);
+            memcpy(refmem+slot(rd),e,z);
+            rs+=df?-(int)z:z;rd+=df?-(int)z:z;
+        }
+        if(!movs)rs=s;
+        eax=v;esi=s;edi=d;ecx=n;g_df=df;accesses=0;calls=0;cases[c].f();
+        unsigned want=(movs?2:1)*n;
+        int shortform=n<4 && !df;
+        if(memcmp(mem,refmem,sizeof mem) || esi!=rs || edi!=rd || ecx!=0 || eax!=v
+           || (n==0 && (accesses||calls)) || (shortform && (accesses!=want || calls))){
+            printf("%s mode %u count %u access %u calls %u\n",cases[c].name,mode,n,accesses,calls);
+            return 1;
+        }
+    }
+    return 0;
+}
+'''
+    ran = _build_and_run(prelude + "\n".join(funcs) + main)
+    assert ran.returncode == 0, ran.stdout + ran.stderr
+
+
+def _ecx_op(mnemonic, n):
+    return Instruction(0x100, 3, mnemonic, f"ecx, {n}", "",
+                       operands=[Operand(type="reg", reg="ecx"), Operand(type="imm", imm=n)])
+
+
+def test_the_instruction_before_sets_the_hint():
+    rep = Instruction(0x103, 2, "rep movsb", "", "")
+    for before, want in ((_ecx_op("and", 3), "/* rep movsb: ecx <= 3 */"),
+                         (_ecx_op("mov", 2), "/* rep movsb: ecx = 2 */")):
+        stmts, _ = lift_basic_block(Lifter(), BasicBlock(0x100, [before, rep]))
+        text = "\n".join(stmts)
+        assert want in text, text
+        assert "memcpy" not in text, text
+    # an unrelated instruction before: the general form, memcpy included
+    other = Instruction(0x100, 2, "mov", "edx, 3", "",
+                        operands=[Operand(type="reg", reg="edx"), Operand(type="imm", imm=3)])
+    stmts, _ = lift_basic_block(Lifter(), BasicBlock(0x100, [other, rep]))
+    assert "memcpy" in "\n".join(stmts)
