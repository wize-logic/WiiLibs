From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Mon, 12 Oct 2026 18:00:00 -0400
Subject: [PATCH] recomp: lift fld m80 and fstp m80

The x87's 80-bit extended memory operands were not lifted. fld with a
10-byte operand fell through to the float case and pushed 4 of the 10
bytes read as a float. fstp to a 10-byte operand fell through to a
comment: nothing was stored, and, worse, nothing was popped, so the
stack leaked a slot and every later x87 operation in the function read
the wrong register. MSVC emits both for long double spills and in the
CRT's extended-precision temporaries.

recomp_ld80(addr) and recomp_st80(addr, v) in recomp_types.h convert
between the 10-byte format and the model's binary64 stack: a load rounds
the 64-bit significand to 53 bits to nearest even (what fstp m64 of the
loaded register gives on the CPU), keeps the sign of zero, maps infinity
and NaN (a NaN keeps the top of its payload, quiet), scales denormals
and pseudo-denormals like exponent 1, and treats an unnormal as an
invalid operand (NaN). A store widens exactly, normalising a binary64
denormal. Both access memory through MEM32/MEM16, so they follow the
runtime's byte order.

Tests: test_x87_m80.py checks the emitted forms and compiles both
helpers from the header against a Python model of the format (stores of
ordinary values, extremes, zeroes, infinities and denormals; loads below,
on and above rounding ties, a denormal, an overflow and infinity).
Conformance cases fpu_m80_roundtrip, fpu_m80_store_{lo,hi,exp} and
fpu_m80_load_* run the same on the real CPU.
---
 templates/runtime/recomp_types.h |  60 ++++++++++++++++
 tools/conformance/cases.py       |  35 +++++++++
 tools/recomp/lifter.py           |  10 +++
 tools/recomp/test_x87_m80.py     | 119 +++++++++++++++++++++++++++++++
 4 files changed, 224 insertions(+)
 create mode 100644 tools/recomp/test_x87_m80.py

diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
index 3cfc7b0..0ea59fa 100644
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -464,6 +464,66 @@ void recomp_trace_esp(const char *name, const char *tag);
 #define MEMD_SET(addr, v) ((void)(MEMD(addr) = (double)(v)))
 #endif
 
+/** x87 80-bit extended memory operands: fld m80 and fstp m80.
+ *
+ * Layout, little-endian like every guest value: bytes 0-7 the 64-bit
+ * significand with its integer bit explicit (bit 63), bytes 8-9 the sign
+ * (bit 15) and a 15-bit exponent biased by 16383. The model's stack is
+ * binary64, so a load rounds the significand to 53 bits (nearest even, as
+ * the x87's own fstp to a double would) and a store widens exactly. Both go
+ * through MEM32/MEM16, so they follow whatever byte order those use. */
+static inline double recomp_ld80(uint32_t addr) {
+    uint64_t mant = (uint64_t)MEM32(addr) | ((uint64_t)MEM32(addr + 4) << 32);
+    uint32_t se = (uint32_t)MEM16(addr + 8);
+    int exp = (int)(se & 0x7FFFu);
+    double v;
+    if (exp == 0x7FFF) {
+        if ((mant & 0x7FFFFFFFFFFFFFFFull) == 0) {
+            v = INFINITY;
+        } else {
+            /* a NaN keeps the top of its payload and comes back quiet */
+            uint64_t bits = 0x7FF8000000000000ull | ((mant >> 11) & 0x000FFFFFFFFFFFFFull);
+            memcpy(&v, &bits, sizeof v);
+        }
+    } else if (mant == 0) {
+        v = 0.0;
+    } else if (exp != 0 && !(mant >> 63)) {
+        v = NAN;          /* unnormal: an invalid operand since the 80387 */
+    } else {
+        /* exponent 0 is a denormal, or a pseudo-denormal with the integer
+         * bit set; both scale like exponent 1 */
+        v = ldexp((double)mant, (exp ? exp : 1) - 16383 - 63);
+    }
+    return (se & 0x8000u) ? -v : v;
+}
+
+static inline void recomp_st80(uint32_t addr, double v) {
+    uint64_t bits, frac, mant;
+    uint32_t se;
+    int e;
+    memcpy(&bits, &v, sizeof bits);
+    se = (uint32_t)(bits >> 48) & 0x8000u;
+    e = (int)((bits >> 52) & 0x7FF);
+    frac = bits & 0x000FFFFFFFFFFFFFull;
+    if (e == 0x7FF) {                       /* infinity or NaN */
+        se |= 0x7FFFu;
+        mant = 0x8000000000000000ull | (frac << 11);
+    } else if (e == 0 && frac == 0) {       /* signed zero */
+        mant = 0;
+    } else {
+        if (e == 0) {                       /* binary64 denormal: normalise */
+            e = 1;
+            while (!(frac & 0x0010000000000000ull)) { frac <<= 1; e--; }
+            frac &= 0x000FFFFFFFFFFFFFull;
+        }
+        se |= (uint32_t)(e - 1023 + 16383);
+        mant = 0x8000000000000000ull | (frac << 11);
+    }
+    MEM32(addr) = (uint32_t)mant;
+    MEM32(addr + 4) = (uint32_t)(mant >> 32);
+    MEM16(addr + 8) = (uint16_t)se;
+}
+
 /* ================================================================
  * SSE / XMM register state
  *
diff --git a/tools/conformance/cases.py b/tools/conformance/cases.py
index 7256008..a44947c 100644
--- a/tools/conformance/cases.py
+++ b/tools/conformance/cases.py
@@ -550,6 +550,41 @@ CASES += [
          ["cvttsd2si eax, qword ptr [eax]"], _CVT_SD, "fpu"),
 ]
 
+# 80-bit extended memory operands. A store writes the full 10 bytes (the
+# low dword, the high dword with the explicit integer bit, and sign plus
+# exponent are each read back through eax); a load rounds a 64-bit
+# significand to the model's 53 bits, so the hand-built operands sit just
+# below, on and just above a rounding tie.
+_FP_M80 = [(v, 0.0) for v in (1.0, -2.5, 3.141592653589793, 1e300, -1e-300,
+                              5e-324, 2.225073858507201e-308, 0.0, -0.0,
+                              float("inf"), -float("inf"), float("nan"))]
+CASES += [
+    Case("fpu_m80_roundtrip", "fstp m80 then fld m80 gives the double back",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "fld tbyte ptr [eax+32]"], _FP_M80, "fpu"),
+    Case("fpu_m80_store_lo", "fstp m80 writes the low significand dword",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "mov eax, dword ptr [eax+32]"], _FP_M80, "fpu"),
+    Case("fpu_m80_store_hi", "fstp m80 writes the high dword, integer bit set",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "mov eax, dword ptr [eax+36]"], _FP_M80, "fpu"),
+    Case("fpu_m80_store_exp", "fstp m80 writes sign and the 15-bit exponent",
+         ["fld qword ptr [eax]", "fstp tbyte ptr [eax+32]",
+          "movzx eax, word ptr [eax+40]"], _FP_M80, "fpu"),
+]
+for _name, _lo, _hi, _se in (
+        ("below_tie", "0FFFFFBFFh", "0FFFFFFFFh", "03FFFh"),
+        ("tie_even", "000000400h", "080000000h", "0BFFFh"),
+        ("tie_odd", "000000C00h", "080000000h", "04005h"),
+        ("all_ones", "0FFFFFFFFh", "0FFFFFFFFh", "03FFFh"),
+        ("denormal", "000000001h", "000000000h", "00000h"),
+        ("huge", "000000000h", "080000000h", "07FFEh")):
+    CASES.append(Case("fpu_m80_load_" + _name,
+        "fld m80 rounds a 64-bit significand to nearest even",
+        ["mov dword ptr [eax+32], " + _lo, "mov dword ptr [eax+36], " + _hi,
+         "mov word ptr [eax+40], " + _se, "fld tbyte ptr [eax+32]"],
+        [(0.0, 0.0)], "fpu"))
+
 CASES.append(Case("pushad_popad", "POPAD restores registers and skips saved ESP",
     ["pushad", "mov eax, 0", "mov ecx, 0", "popad", "add eax, ecx"], _PAIRS))
 
diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index 93f6f0f..e0f9fd3 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -3570,6 +3570,11 @@ class Lifter:
                         return [f"fp_push(MEMF({_fmt_mem(ops[0])})); /* fld float */"]
                     elif ops[0].mem_size == 8:
                         return [f"fp_push(MEMD({_fmt_mem(ops[0])})); /* fld double */"]
+                    elif ops[0].mem_size == 10:
+                        # fld m80: 80-bit extended, rounded to the model's
+                        # binary64. Used to fall through to the float load
+                        # below and read 4 of the 10 bytes as a float.
+                        return [f"fp_push(recomp_ld80({_fmt_mem(ops[0])})); /* fld tbyte */"]
                     return [f"fp_push(MEMF({_fmt_mem(ops[0])})); /* fld */"]
                 if ops[0].type == "reg":
                     # fld st(i) pushes a COPY of st(i). Was a no-op comment,
@@ -3597,6 +3602,11 @@ class Lifter:
                     return [f"MEMF_SET({_fmt_mem(ops[0])}, (float)fp_top());{do_pop} /* {m} */"]
                 elif ops[0].mem_size == 8:
                     return [f"MEMD_SET({_fmt_mem(ops[0])}, fp_top());{do_pop} /* {m} */"]
+                elif ops[0].mem_size == 10:
+                    # fstp m80: widened exactly to 80-bit extended. Used to
+                    # fall through to a comment -- no store, and no pop, so
+                    # the stack leaked a slot.
+                    return [f"recomp_st80({_fmt_mem(ops[0])}, fp_top());{do_pop} /* {m} tbyte */"]
             # fst/fstp st(i): copy st0 to st(i); fstp then pops. This used to be
             # a bare comment -- a no-op -- which LEAKS the FPU stack. `fstp st(0)`
             # is the common idiom for "pop the value fptan/fsincos just pushed";
diff --git a/tools/recomp/test_x87_m80.py b/tools/recomp/test_x87_m80.py
new file mode 100644
index 0000000..c1cf62e
--- /dev/null
+++ b/tools/recomp/test_x87_m80.py
@@ -0,0 +1,119 @@
+"""fld m80 and fstp m80: the x87's 80-bit extended memory operands.
+
+fld with a 10-byte operand fell through to the float load and read 4 of the
+10 bytes as a float; fstp to a 10-byte operand fell through to a comment, so
+nothing was stored and nothing popped -- the stack leaked a slot. MSVC emits
+both for long double spills and for the CRT's own extended temporaries.
+
+The emitted text is checked, and recomp_ld80/recomp_st80 are compiled from
+the runtime header and compared with a Python model of the format.
+"""
+
+import math
+import os
+import pathlib
+import shutil
+import struct
+import subprocess
+import tempfile
+import unittest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+_HEADER_DIR = pathlib.Path(__file__).resolve().parents[2] / "templates" / "runtime"
+
+
+def _lift(mnemonic):
+    insn = Instruction(0, 3, mnemonic, "", "00")
+    insn.operands = [Operand(type="mem", mem_base="esi", mem_disp=8,
+                             mem_size=10)]
+    return " ".join(Lifter().lift_instruction(insn))
+
+
+def _st80(v):
+    """The 10 bytes fstp m80 writes for a double, built from the value."""
+    sign = 0x8000 if math.copysign(1.0, v) < 0 else 0
+    if math.isnan(v):
+        frac = struct.unpack("<Q", struct.pack("<d", v))[0] & ((1 << 52) - 1)
+        return struct.pack("<QH", (1 << 63) | (frac << 11), sign | 0x7FFF)
+    if math.isinf(v):
+        return struct.pack("<QH", 1 << 63, sign | 0x7FFF)
+    if v == 0.0:
+        return struct.pack("<QH", 0, sign)
+    m, e = math.frexp(abs(v))                    # |v| = m * 2**e, m in [0.5, 1)
+    return struct.pack("<QH", int(m * 2.0**64), sign | (e - 1 + 16383))
+
+
+def _ld80(mant, se):
+    """The double fld m80 then fstp m64 gives, from the parts."""
+    exp = se & 0x7FFF
+    sign = -1.0 if se & 0x8000 else 1.0
+    if exp == 0x7FFF:
+        return sign * math.inf if (mant << 1) & ((1 << 64) - 1) == 0 else math.nan
+    if mant == 0:
+        return sign * 0.0
+    try:
+        return sign * math.ldexp(float(mant), (exp or 1) - 16383 - 63)
+    except OverflowError:
+        return sign * math.inf
+
+
+DOUBLES = (1.0, -2.5, math.pi, 1e300, -1e-300, 5e-324, 2.225073858507201e-308,
+           0.0, -0.0, math.inf, -math.inf, 123456789.125)
+EXTENDEDS = ((0xFFFFFFFFFFFFFBFF, 0x3FFF), (0x8000000000000400, 0xBFFF),
+             (0x8000000000000C00, 0x4005), (0xFFFFFFFFFFFFFFFF, 0x3FFF),
+             (0x0000000000000001, 0x0000), (0x8000000000000000, 0x7FFE),
+             (0x8000000000000000, 0x7FFF), (0xC000000000000000, 0x3C00))
+
+
+class X87M80Test(unittest.TestCase):
+    def test_emitted_forms(self):
+        self.assertIn("fp_push(recomp_ld80(esi + 8));", _lift("fld"))
+        self.assertIn("recomp_st80(esi + 8, fp_top()); fp_pop();", _lift("fstp"))
+
+    def test_helpers_match_the_format(self):
+        cc = shutil.which("clang") or shutil.which("gcc") or shutil.which("cc")
+        if not cc:
+            self.skipTest("no C compiler")
+        lines = ["#define RECOMP_GENERATED_CODE 1", '#include "recomp_types.h"',
+                 "#include <stdio.h>", "ptrdiff_t g_xbox_mem_offset;",
+                 "static unsigned char ram[64];",
+                 "int main(void) {", "    volatile double v; int i;",
+                 "    g_xbox_mem_offset = (ptrdiff_t)(uintptr_t)ram;"]
+        for d in DOUBLES:
+            lit = ("INFINITY" if d == math.inf else "-INFINITY" if d == -math.inf
+                   else repr(d))
+            lines.append(f"    v = {lit}; recomp_st80(16, v);"
+                         " for (i = 0; i < 10; i++) printf(\"%02x\", ram[16 + i]);"
+                         " printf(\"\\n\");")
+        for mant, se in EXTENDEDS:
+            lines.append(f"    MEM32(32) = 0x{mant & 0xFFFFFFFF:08X}u;"
+                         f" MEM32(36) = 0x{mant >> 32:08X}u; MEM16(40) = 0x{se:04X};"
+                         " v = recomp_ld80(32); printf(\"%.17g\\n\", v);")
+        lines += ["    return 0;", "}"]
+        with tempfile.TemporaryDirectory() as tmp:
+            c_path = os.path.join(tmp, "t.c")
+            exe = os.path.join(tmp, "t")
+            with open(c_path, "w") as f:
+                f.write("\n".join(lines) + "\n")
+            r = subprocess.run([cc, "-O2", "-w", "-I", str(_HEADER_DIR),
+                                c_path, "-o", exe, "-lm"],
+                               capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr[-3000:])
+            out = subprocess.run([exe], capture_output=True, text=True,
+                                 check=True).stdout.split()
+        stores, loads = out[:len(DOUBLES)], out[len(DOUBLES):]
+        self.assertEqual(stores, [_st80(d).hex() for d in DOUBLES])
+        for (mant, se), got in zip(EXTENDEDS, loads):
+            want = _ld80(mant, se)
+            g = float(got)
+            if math.isnan(want):
+                self.assertTrue(math.isnan(g), (hex(mant), hex(se), got))
+            else:
+                self.assertEqual(struct.pack("<d", g), struct.pack("<d", want),
+                                 (hex(mant), hex(se), got, want))
+
+
+if __name__ == "__main__":
+    unittest.main()
