-            return f"({slhs} > 0)", desc
+        # The signed conditions are SF != OF (with ZF for jle/jg): the sign
+        # of the sum taken exactly, which is what they read when it
+        # overflows. SF alone answered `add eax, 1; jl` with "less" at
+        # 0x7FFFFFFF + 1. The original destination is result - source.
+        if rhs is not None and jcc in _SIGNED_ORDER:
+            st = _sf_cast
+            exact = (f"((int64_t){st}(uint32_t)((uint32_t){lhs} - (uint32_t){rhs})"
+                     f" + (int64_t){st}(uint32_t){rhs})")
+            return f"({exact} {_SIGNED_ORDER[jcc]} 0)", desc
         return None
 
     # ── adc/sbb: result-based (like add/sub but with carry) ──
@@ -938,14 +957,12 @@ def _make_condition(jcc, flag_setter, flag_ops):
             return f"({slhs} < 0)", desc
         if jcc == "jns":
             return f"({slhs} >= 0)", desc
-        if jcc in ("jg", "jnle"):
-            return f"({slhs} > 0)", desc
-        if jcc in ("jge", "jnl"):
-            return f"({slhs} >= 0)", desc
