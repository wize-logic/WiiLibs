diff --git a/tools/recomp/test_stack_reach.py b/tools/recomp/test_stack_reach.py
new file mode 100644
index 0000000..1e15421
--- /dev/null
+++ b/tools/recomp/test_stack_reach.py
@@ -0,0 +1,230 @@
+"""
+--stack-deltas and --stack-reach for --stack-locals (stack_locals.py).
+
+ret_deltas(exact=True) gives a function that moves esp by constants its
+effect on its caller's esp; the carry `sub esp, K` computes is no frame
+address. arg_windows gives each function the walk follows how far above its
+entry esp it may reach; a call that hands its callee no frame address then
+writes back and reloads only the slots below that reach. These checks lift
+small x86 functions (test_preserve's harness), look at the windows and at the
+text, and compile and run each case both ways (test_stack_locals' harness).
+"""
+
+import os
+import re
+import shutil
+import struct
+import sys
+import tempfile
+
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import preserve  # noqa: E402
+from tools.recomp.stack_locals import localise_stack, ret_deltas, arg_windows  # noqa: E402
+from tools.recomp.test_preserve import _lift  # noqa: E402
+from tools.recomp.test_stack_locals import _compile_run  # noqa: E402
+
+
+def _h(s):
+    return bytes.fromhex(s.replace(" ", ""))
+
+
+RET = _h("C3")
+RET_4 = _h("C20400")           # ret 4
+SUB_ESP_10 = _h("83EC10")      # sub esp, 0x10
+ADD_ESP_10 = _h("83C410")      # add esp, 0x10
+ADD_ESP_4 = _h("83C404")       # add esp, 4
+JB_NEXT = _h("7200")           # jb $+2 (reads the carry of what came before)
+ST_0_EAX = _h("890424")        # mov [esp], eax
+LD_EDX_0 = _h("8B1424")        # mov edx, [esp]
+ST_4_EAX = _h("89442404")      # mov [esp+4], eax
+LD_EDX_4 = _h("8B542404")      # mov edx, [esp+4]
+ADD_4_EAX = _h("01442404")     # add [esp+4], eax
+ST_8_ECX = _h("894C2408")      # mov [esp+8], ecx
+LD_EAX_8 = _h("8B442408")      # mov eax, [esp+8]
+ADD_8_EDX = _h("01542408")     # add [esp+8], edx
+LEA_ECX_8 = _h("8D4C2408")     # lea ecx, [esp+8]
+LEA_EAX_4 = _h("8D442404")     # lea eax, [esp+4]
+PUSH_EAX, PUSH_ECX = _h("50"), _h("51")
+# leaves
+READS_ARG = [_h("8B442404"), RET]                                   # mov eax, [esp+4]
+WRITES_ARG = [_h("8B442404"), _h("89542404"), _h("8B4C2404"), RET]  # its argument read, rewritten, read
+WRITES_2ND = [_h("8B442408"), _h("01542408"), RET]                  # mov eax, [esp+8]; add [esp+8], edx
+WRITES_PTR = [_h("8B442404"), _h("C700AA000000"), RET]              # *(arg) = 0xAA
+NO_ARGS = [_h("B807000000"), RET]                                   # mov eax, 7
+
+
+def _call(i):
+    return ("call", i)
+
+
+def _names_lines(funcs):
+    t, pend, names = _lift(funcs)
+    return t, pend, names, {names[i]: p.lines for i, p in pend.items()}
+
+
+def _run_pass(funcs, reach=True, exact=True):
+    t, pend, names, lines = _names_lines(funcs)
+    s = preserve.analyse(lines)
+    kept = preserve.preserved_by_name(s)
+    deltas = ret_deltas(lines, exact=exact)
+    windows = arg_windows(lines, s, kept, deltas, carry=exact) if reach else None
+    out = {n: localise_stack(pend[i].lines, s, kept, deltas, windows=windows, carry=exact)
+           for i, n in enumerate(names)}
+    return pend, names, out, windows
+
+
+def _windows(funcs):
+    return _run_pass(funcs)[3]
+
+
+def _body(lines):
+    return "\n".join(lines)
+
+
+# ------------------------------------------------------------ ret_deltas
+
+def test_a_frame_moved_by_constants_has_a_delta_only_when_exact():
+    # sub esp,0x10; add esp,0x10; ret 4: esp after the return is entry + 8
+    _, _, names, lines = _names_lines([[SUB_ESP_10, ADD_ESP_10, RET_4]])
+    assert ret_deltas(lines, exact=True) == {names[0]: 8}
+    assert names[0] not in ret_deltas(lines)  # 0038's test let `esp = esp - 0x10` count as a foreign set
+
+
+def test_esp_set_from_elsewhere_has_no_delta_even_when_exact():
+    # mov esp, eax; ret: the caller's esp is not known
+    _, _, names, lines = _names_lines([[_h("8BE0"), RET]])
+    assert names[0] not in ret_deltas(lines, exact=True)
+
+
+def test_the_carry_of_sub_esp_is_no_frame_address():
+    # sub esp,0x10; jb +0; the slot at entry - 0xc spilled and read twice
+    f = [SUB_ESP_10, JB_NEXT, ST_4_EAX, LD_EDX_4, LD_EDX_4, ADD_ESP_10, RET]
+    _, _, out, _ = _run_pass([f], reach=False, exact=False)
+    assert out[_lift([f])[2][0]][1] == "a frame address in a temporary"
+    _, names, out, _ = _run_pass([f], reach=False, exact=True)
+    assert out[names[0]][1] is None, out[names[0]][1]
+
+
+# ------------------------------------------------------------ arg_windows
+
+def test_a_leaf_reaches_its_return_address_and_its_arguments():
+    w = _windows([READS_ARG, NO_ARGS, WRITES_2ND])
+    assert sorted(w.values()) == [4, 8, 12]
+
+
+def test_a_tail_jump_has_no_window():
+    # mov eax,[esp+8]; jmp f0: f0 runs on this function's frame
+    jmp = b"\xE9" + struct.pack("<i", 0 - (len(_h("8B442404")) + 1 + 4 + 5))
+    funcs = [READS_ARG, [LD_EAX_8, jmp]]
+    _, _, names, _ = _names_lines(funcs)
+    w = _windows(funcs)
+    assert names[0] in w and names[1] not in w, w
+
+
+def test_an_argument_address_passed_on_has_no_window():
+    # lea eax,[esp+4]; push eax; call f1; add esp,4; ret: f1 may reach the caller's frame through it
+    funcs = [[LEA_EAX_4, PUSH_EAX, _call(1), ADD_ESP_4, RET], READS_ARG]
+    _, _, names, _ = _names_lines(funcs)
+    w = _windows(funcs)
+    assert names[0] not in w and w.get(names[1]) == 8, w
+
+
+def test_an_inherited_frame_has_no_window():
+    # mov eax,[ebp+8]; ret: ebp is the caller's, whatever it points at
+    funcs = [[_h("8B4508"), RET]]
+    _, _, names, _ = _names_lines(funcs)
+    assert names[0] not in _windows(funcs)
+
+
+# ------------------------------------------------------------ the calls
+
+def test_a_slot_out_of_the_callees_reach_stays_in_its_local():
+    # sub esp,0x10; mov [esp+8],ecx; call f1 (no arguments); mov eax,[esp+8]; add [esp+8],edx...
+    caller = [SUB_ESP_10, ST_8_ECX, _call(1), LD_EAX_8, ADD_8_EDX, LD_EAX_8, ADD_ESP_10, RET]
+    pend, names, out, _ = _run_pass([caller, NO_ARGS])
+    lines, why, n_slots, _ = out[names[0]]
+    assert why is None and n_slots == 1, why
+    text = _body(lines)
+    assert "to memory */" not in text and "/* and back */" not in text, text
+    # without --stack-reach the slot goes to memory and back
+    _, _, out, _ = _run_pass([caller, NO_ARGS], reach=False)
+    text = _body(out[names[0]][0])
+    assert "MEM32(esp + 0x8) = _sl_m8; /* the slots written since, to memory */" in text, text
+    assert "_sl_m8 = MEM32(esp + 0x8); /* and back */" in text, text
+
+
+def test_a_slot_in_the_callees_arguments_still_goes_to_memory_and_back():
+    # sub esp,0x10; mov [esp],eax; mov [esp+8],ecx; call f1 (reads [esp+4] = the caller's [esp]):
+    # the slot at entry - 0x10 is f1's argument, the one at entry - 8 is out of its reach
+    caller = [SUB_ESP_10, ST_0_EAX, ST_8_ECX, _call(1), LD_EAX_8, LD_EDX_0, LD_EAX_8, LD_EDX_0, ADD_ESP_10, RET]
+    _, names, out, w = _run_pass([caller, READS_ARG])
+    assert w[names[1]] == 8
+    lines, why, n_slots, _ = out[names[0]]
+    assert why is None and n_slots == 2, why
+    text = _body(lines)
+    assert "MEM32(esp + 0x0) = _sl_m10; /* the slots written since, to memory */" in text, text
+    assert "_sl_m10 = MEM32(esp + 0x0); /* and back */" in text, text
+    assert not re.search(r"MEM32\(esp \+ 0x8\) = _sl_m8|_sl_m8 = MEM32\(esp \+ 0x8\);", text), text
+
+
+def test_a_callee_given_a_frame_address_reaches_every_slot():
+    # lea ecx,[esp+8]; push ecx; call f1: f1 writes through it, whatever its window
+    caller = [SUB_ESP_10, ST_8_ECX, ST_4_EAX, LEA_ECX_8, PUSH_ECX, _call(1), ADD_ESP_4, LD_EAX_8, LD_EDX_4,
+              LD_EAX_8, LD_EDX_4, ADD_ESP_10, RET]
+    _, names, out, w = _run_pass([caller, WRITES_PTR])
+    assert w[names[1]] == 8
+    lines, why, _, _ = out[names[0]]
+    assert why is None, why
+    text = _body(lines)
+    i_call = text.index("RECOMP_ABI_CALL")
+    assert "_sl_m8" in text[i_call:text.index("/* and back */", i_call)], text
+
+
+# ------------------------------------------------------------ run both ways
+
+CASES = [
+    # one slot the callee's argument (it rewrites it), one out of its reach
+    [[SUB_ESP_10, ST_0_EAX, ST_8_ECX, _call(1), LD_EAX_8, ADD_8_EDX, LD_EDX_0, LD_EAX_8, ADD_ESP_10, RET],
+     WRITES_ARG],
+    # the callee's second argument is the caller's [esp+4] at the call: on the edge of its reach
+    [[SUB_ESP_10, ST_4_EAX, ST_8_ECX, _call(1), LD_EDX_4, ADD_4_EAX, LD_EAX_8, ADD_8_EDX, LD_EDX_4, LD_EAX_8,
+      ADD_ESP_10, RET],
+     WRITES_2ND],
+    # two calls with a slot changed between them, out of reach of both
+    [[SUB_ESP_10, ST_8_ECX, ST_4_EAX, _call(1), ADD_8_EDX, LD_EAX_8, _call(1), ADD_8_EDX, LD_EAX_8, LD_EDX_4,
+      ADD_ESP_10, RET],
+     NO_ARGS],
+    # the callee is given the slot's address and writes it
+    [[SUB_ESP_10, ST_8_ECX, LEA_ECX_8, PUSH_ECX, _call(1), ADD_ESP_4, LD_EAX_8, LD_EAX_8, ADD_ESP_10, RET],
+     WRITES_PTR],
+    # the callee passes its own argument's address on: no window, every slot synced
+    [[SUB_ESP_10, ST_0_EAX, ST_8_ECX, _call(1), LD_EAX_8, ADD_8_EDX, LD_EDX_0, LD_EAX_8, ADD_ESP_10, RET],
+     [LEA_EAX_4, PUSH_EAX, _call(2), ADD_ESP_4, RET], WRITES_PTR],
+]
+
+
+@pytest.mark.parametrize("funcs", CASES)
+def test_the_reach_computes_what_the_memory_model_computes(funcs):
+    if not (shutil.which("gcc") or shutil.which("clang")):
+        pytest.skip("C compiler unavailable")
+    pend, names, out, _ = _run_pass(funcs)
+    assert out[names[0]][1] is None, out[names[0]][1]
+    protos = "".join("static void %s(void);\n" % n for n in names)
+    plain = protos + "\n".join(_body(p.lines) for p in pend.values())
+    done = protos + "\n".join(_body(out[n][0]) for n in names)
+    with tempfile.TemporaryDirectory() as tmp:
+        a = _compile_run(plain, names[0], tmp, "plain")
+        b = _compile_run(done, names[0], tmp, "reach")
+    assert a == b, (a, b)
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_") and name != "test_the_reach_computes_what_the_memory_model_computes":
+            fn()
+    for c in CASES:
+        test_the_reach_computes_what_the_memory_model_computes(c)
+    print("ok")
