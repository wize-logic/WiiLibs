From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Mon, 19 Oct 2026 11:19:06 -0400
Subject: [PATCH] disasm: BINKDATA is data

BINKDATA (RAD's Bink, linked into many titles) is marked executable but
holds Bink's tables. Analysed as code, its pointers were never scanned
(_pass_data_ptr_targets reads data sections only) and the blitters reached
only through them were never found; disassembled, its bytes became garbage
functions (four in Halo retail). It joins DATA_SECTION_NAMES (loader.py
and config.py).

Upstream's callback recovery (probes_as_callback_body, bounded by the gap
and not by an instruction count) now finds long bodies taken as immediates,
such as Bink's bitstream callback, whose first ret is about 317
instructions in.

Tests: test_binkdata_section.py.
---
 tools/disasm/config.py                | 1 +
 tools/disasm/loader.py                | 8 ++++++--
 tools/disasm/test_binkdata_section.py | 8 ++++++++
 3 files changed, 15 insertions(+), 2 deletions(-)
 create mode 100644 tools/disasm/test_binkdata_section.py

diff --git a/tools/disasm/config.py b/tools/disasm/config.py
index 07f74bb..b782c93 100644
--- a/tools/disasm/config.py
+++ b/tools/disasm/config.py
@@ -60,6 +60,7 @@ ALL_SECTIONS = {
 # executable flag (matches tools/disasm/loader.py's DATA_SECTION_NAMES).
 _DATA_SECTION_NAMES = frozenset({
     ".data", ".data1", ".rdata", ".idata", ".edata", ".reloc", ".tls",
+    "BINKDATA",
 })
 
 _configured_from = None
diff --git a/tools/disasm/loader.py b/tools/disasm/loader.py
index 6c09e10..03832df 100644
--- a/tools/disasm/loader.py
+++ b/tools/disasm/loader.py
@@ -14,12 +14,16 @@ from typing import Dict, List, Optional, Tuple
 # Sections that hold data even when the XBE marks them executable. Excluded
 # from disassembly by name; --extra-sections overrides this per title.
 #
-# Only the conventional PE data sections are listed. XDK library sections are
+# The conventional PE data sections, and BINKDATA. XDK library sections are
 # NOT excluded even when their name suggests data (DSOUND_RD, D3D_RD, XON_RD):
 # the linker maps class those as CODE, and they are exactly the sections we
-# want disassembled.
+# want disassembled. BINKDATA (RAD's Bink, linked into many titles) is marked
+# executable but holds Bink's tables: analysed as code, its pointers were
+# never scanned (_pass_data_ptr_targets reads data sections only), and the
+# blitters reached only through them -- 89 in Halo -- were never translated.
 DATA_SECTION_NAMES = frozenset({
     ".data", ".data1", ".rdata", ".idata", ".edata", ".reloc", ".tls",
+    "BINKDATA",
 })
 
 
diff --git a/tools/disasm/test_binkdata_section.py b/tools/disasm/test_binkdata_section.py
new file mode 100644
index 0000000..d707ebd
--- /dev/null
+++ b/tools/disasm/test_binkdata_section.py
@@ -0,0 +1,8 @@
+"""BINKDATA (RAD's Bink tables) is data, though its section is marked executable."""
+from tools.disasm.loader import DATA_SECTION_NAMES
+from tools.disasm import config
+
+
+def test_binkdata_is_a_data_section():
+    assert "BINKDATA" in DATA_SECTION_NAMES
+    assert "BINKDATA" in config._DATA_SECTION_NAMES
