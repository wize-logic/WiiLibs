+def test_kept_locals_survive_a_join_only_when_both_paths_keep_them():
+    # f0: mov ebx, 7; mov eax, [0x2008]; test eax, eax; jz other; call f1; jmp join;
+    #     other: call f2; join: mov [0x2000], ebx; ret
+    # f1 preserves ebx, f2 does not: ebx is loaded again at the join
+    sums, t, pend, names = _summaries([
+        [MOV_EBX_7, LOAD_EAX, b"\x85\xC0\x74\x07", _call(1), b"\xEB\x05", _call(2), STORE_EBX, RET],
+        [RET],
+        [MOV_EBX_7, RET],
+    ])
+    text = _finish(t, pend, names, sums, 0)
+    tail = text[text.rindex("RECOMP_ABI_CALL"):]
+    assert re.search(r"_r_ebx = g_ebx|_LOCALS_LOAD\(\);", tail), text
+
+
+def test_a_binary_and_with_a_register_is_not_its_address():
+    assert not preserve._address_taken("eax = eax & ebx")
+    assert not preserve._address_taken("_fa = (uint32_t)(ecx) & (g_esi)")
+    assert preserve._address_taken("f(&ebx)")
+    assert preserve._address_taken("p = & (g_edi)")
