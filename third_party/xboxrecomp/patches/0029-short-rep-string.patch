+
+    def _rep_short(self, m, size, big, back, element, regs):
+        """The rep store or copy around its general form `big`: up to three
+        elements (none included) go through `back`, the element loop alone,
+        one guest access an element and no call; `element(k)` is element k
+        forwards, for a count the instruction before states.
+
+        rep_count, set by lift_basic_block from the instruction before this
+        one in its block, says what ecx holds: ("exact", n) after `mov ecx,
+        n`, ("max", n) after `and ecx, n`. An exact count of 1..4 is moved
+        without a test (the element loop for DF=1), and a count of at most
+        3 is the element loop alone.
+        """
+        hint = getattr(self, "rep_count", None)
+        kind, n = hint if hint else (None, None)
+        step = lambda c: " ".join(f"{r} += {c};" for r in regs)
+        if kind == "exact" and n == 0:
+            return [f"/* {m}: ecx is 0, nothing moves */"]
+        if kind == "exact" and n <= 4:
+            moves = " ".join(element(k) for k in range(n))
+            return ([f"if (!g_df) {{ {moves} {step(f'{n * size}u')} ecx = 0; }} /* {m}: ecx = {n} */",
+                     "else {"] + back + ["ecx = 0; }"])
+        if kind == "max" and n <= 3:
+            return [f"{{ /* {m}: ecx <= {n} */"] + back + ["ecx = 0; }"]
+        # the long run first: it pays one test for the element loop
+        return ([f"if (ecx > 3u) {{ /* {m} */"] + big + ["} else"] + back + ["ecx = 0;"])
 
     def _lift_rep_string(self, insn, m):
