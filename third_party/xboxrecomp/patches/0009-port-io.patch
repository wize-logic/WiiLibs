From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wize-logic <wizelogic@proton.me>
Date: Mon, 12 Oct 2026 22:02:28 -0400
Subject: [PATCH] recomp: lift in/out through RECOMP_PORT_IN and
 RECOMP_PORT_OUT

The XDK's own code still uses a few x86 I/O ports. Halo 2276's statically
linked Direct3D reads port 0x80C0 for the TV encoder's field (bit 5) when it
flips an interlaced display, and writes another in its interrupt path. Both
were RECOMP_UNIMPL, which leaves the destination register as it was, so the
field parity came from whatever eax happened to hold.

`in` now writes RECOMP_PORT_IN(port, size) into its destination and `out`
calls RECOMP_PORT_OUT(port, value, size), with the port masked to 16 bits and
the size (1, 2 or 4) taken from the register operand. The template's defaults
read 0 and drop the write; a runtime that models the console's ports defines
them before including the header.
---
 templates/runtime/recomp_types.h    |  9 +++++
 tools/recomp/lifter.py              | 21 +++++++++++
 tools/recomp/test_lifter_port_io.py | 54 +++++++++++++++++++++++++++++
 3 files changed, 84 insertions(+)
 create mode 100644 tools/recomp/test_lifter_port_io.py

diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
index 1fad7de..34eee54 100644
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -429,6 +429,15 @@ void recomp_trace_esp(const char *name, const char *tag);
 #define RECOMP_BACKEDGE() ((void)0)
 #endif
 
+/** x86 port I/O (in/out): a runtime that models the console's ports defines these before this
+ *  header. port is 16-bit, size 1, 2 or 4 bytes. By default a read gives 0 and a write is dropped. */
+#ifndef RECOMP_PORT_IN
+#define RECOMP_PORT_IN(port, size) ((void)(port), (void)(size), 0u)
+#endif
+#ifndef RECOMP_PORT_OUT
+#define RECOMP_PORT_OUT(port, value, size) ((void)(port), (void)(value), (void)(size))
+#endif
+
 /* ================================================================
  * Memory access helpers
  * ================================================================ */
diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index 09ff6f8..c5114c7 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -1754,6 +1754,27 @@ class Lifter:
                 "  /* rdtsc */",
             ]
 
+        # ── Port I/O ──
+        # The XDK's own code still talks to a few x86 I/O ports: Direct3D reads
+        # port 0x80C0 for the TV encoder's field (bit 5) when it flips an
+        # interlaced display, and the SMBus and PIC are reached the same way.
+        # These were RECOMP_UNIMPL, which leaves the destination as it was:
+        # the field came from whatever eax held. They go to RECOMP_PORT_IN and
+        # RECOMP_PORT_OUT now, which a runtime defines (port numbers are 16-bit,
+        # sizes 1, 2 or 4); the template's defaults read 0 and drop the write.
+        if m in ("in", "out") and len(ops) == 2:
+            if m == "in":
+                port = _fmt_operand_read(ops[1])
+                size = _operand_width(ops[0]) or 4
+                return [_fmt_operand_write(
+                    ops[0], f"(uint32_t)RECOMP_PORT_IN((uint32_t)({port}) & 0xFFFFu, {size})")
+                    + f"; /* {m} */"]
+            port = _fmt_operand_read(ops[0])
+            value = _fmt_operand_read(ops[1])
+            size = _operand_width(ops[1]) or 4
+            return [f"RECOMP_PORT_OUT((uint32_t)({port}) & 0xFFFFu, (uint32_t)({value}), {size});"
+                    f" /* {m} */"]
+
         # ── Bit scan ──
         # Index of the lowest (bsf) or highest (bsr) set bit. When the source
         # is zero the destination is left untouched and ZF is set; that is the
diff --git a/tools/recomp/test_lifter_port_io.py b/tools/recomp/test_lifter_port_io.py
new file mode 100644
index 0000000..b1f7d8c
--- /dev/null
+++ b/tools/recomp/test_lifter_port_io.py
@@ -0,0 +1,54 @@
+"""
+in/out reach RECOMP_PORT_IN / RECOMP_PORT_OUT.
+
+They were RECOMP_UNIMPL: a no-op that left the destination register as it
+was. Direct3D reads the TV encoder's field from port 0x80C0 that way, so its
+interlaced flip parity came from whatever eax held before.
+"""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import config  # noqa: E402
+from tools.recomp.translator import FunctionTranslator  # noqa: E402
+
+BASE = 0x00010000
+
+
+def _translate(image):
+    config._install(
+        [config.Section(".text", BASE, len(image), 0x0000, len(image), True)],
+        entry_point=BASE, kernel_thunk_addr=BASE, origin="port-io-test")
+    db = {BASE: {"start": f"0x{BASE:08X}", "end": BASE + len(image),
+                 "_addr": BASE, "size": len(image)}}
+    return FunctionTranslator(image, db).translate_function(BASE, db[BASE])
+
+
+def test_in_al_dx_reads_a_byte_from_the_port_in_dx():
+    # mov dx, 0x80C0; in al, dx; ret
+    code = _translate(b"\x66\xBA\xC0\x80" b"\xEC" b"\xC3")
+    assert "RECOMP_PORT_IN((uint32_t)(" in code, code
+    assert ", 1)" in code, code
+    assert "RECOMP_UNIMPL" not in code, code
+
+
+def test_in_eax_imm_reads_a_dword():
+    # in eax, 0x10; ret
+    code = _translate(b"\xE5\x10" b"\xC3")
+    assert "RECOMP_PORT_IN" in code and ", 4)" in code, code
+
+
+def test_out_dx_al_writes_a_byte():
+    # out dx, al; ret
+    code = _translate(b"\xEE" b"\xC3")
+    assert "RECOMP_PORT_OUT((uint32_t)(" in code, code
+    assert ", 1);" in code, code
+
+
+if __name__ == "__main__":
+    test_in_al_dx_reads_a_byte_from_the_port_in_dx()
+    test_in_eax_imm_reads_a_dword()
+    test_out_dx_al_writes_a_byte()
+    print("ok")
