 tools/recomp/config.py          | 25 ++++++++-
 tools/recomp/const_load.py      | 56 ++++++++++++++++++++
 tools/recomp/test_const_load.py | 93 +++++++++++++++++++++++++++++++++
 tools/recomp/translator.py      |  9 ++++
 5 files changed, 187 insertions(+), 1 deletion(-)
 create mode 100644 tools/recomp/const_load.py
 create mode 100644 tools/recomp/test_const_load.py

