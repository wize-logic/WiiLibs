index ab19551..83949a0 100644
--- a/tools/recomp/translator.py
+++ b/tools/recomp/translator.py
@@ -437,6 +437,16 @@ def load_label_db(labels_json_path):
             label_db[int(lbl["address"], 16)] = lbl["name"]
     return label_db
 
+class _AnyOf:
+    """Membership in any of several containers, without merging them."""
+
+    def __init__(self, *containers):
+        self.containers = containers
+
+    def __contains__(self, item):
+        return any(item in container for container in self.containers)
+
+
 class FunctionTranslator:
     """Translates individual x86 functions to C source code."""
 
@@ -1621,6 +1631,244 @@ class FunctionTranslator:
                     cfg_targets.update(targets)
                 return instructions, jump_tables, cfg_targets
 
+    # ── Code a function reaches outside its own range ──────────────────
+    #
+    # A function is lifted from its range [start, end), and a direct jump out
+    # of that range is a tail call to the function that starts at the target.
+    # That is right for a real tail call. It is wrong when the target is not a
+    # function start: the middle of another body, the rest of this function
+    # past a false function start (an immediate the disassembler took for an
+    # address), or bytes no function covers. There was nothing to call there,
+    # so the translator emitted a stub that popped a return address and
+    # returned, and the rest of the jumping function never ran -- with esp off
+    # by four, since a jump pushes nothing.
+    #
+    # Instead, the code a jump reaches is lifted into the jumping function's
+    # own body: every direct jump, conditional jump, fall-through and switch
+    # arm that leaves the range for an address no function starts at is
+    # decoded from there, as far as it goes, and becomes labels and gotos.
+    # That is exactly the x86's behaviour (same stack, same frame, same
+    # flags), it keeps a loop that crosses a false start a loop rather than a
+    # chain of host calls, and it never splits or shrinks another function.
+    # Decoding stops at the start of a function, which stays a tail call.
+    #
+    # Only code the function can reach is followed: its entry, its switch
+    # arms and the continuations it loads as immediates, then fall-through
+    # and direct edges. A range also holds bytes nothing reaches (a jump
+    # table decoded as instructions), and their "jumps" are not followed.
+    #
+    # Upper bound on the instructions one function gains from outside its
+    # range. The real reach is the rest of one function; the cap only stops a
+    # jump decoded from data from lifting a section's worth of garbage.
+    ABSORB_LIMIT = 4096
+
+    _LEAVES = frozenset(("ret", "retn", "retf", "jmp", "iret", "iretd",
+                         "ud2"))
+
+    def _entry_set(self):
+        """Addresses a direct transfer reaches as a function: every function
+        start the translator lifts (not the weak starts a CFG owner took)."""
+        entries = getattr(self, "_entries", None)
+        if entries is not None:
+            return entries
+        key = (len(self.func_db), len(self.owned_function_starts))
+        cached = getattr(self, "_entry_cache", None)
+        if cached is None or cached[0] != key:
+            cached = self._entry_cache = (key, frozenset(
+                addr for addr in self.func_db
+                if addr not in self.owned_function_starts))
+        return cached[1]
+
+    def _code_limit(self, va):
+        """End of the backed bytes of the code section holding va, or None."""
+        for section in _config._SECTIONS:
+            if (section.is_code and section.va <= va
+                    < section.va + min(section.va_size, section.raw_size)):
+                return section.va + min(section.va_size, section.raw_size)
+        return None
+
+    def _is_padding_at(self, va):
+        """Whether va holds an int3 or a nop (alignment padding)."""
+        offset = va_to_file_offset(va)
+        return (offset is not None and offset < len(self.xbe_data)
+                and self.xbe_data[offset] in (0xCC, 0x90))
+
+    def _decode_stream(self, va, stop, budget):
+        """Decode straight-line code from va until it leaves or joins.
+
+        Stops after a ret, jmp, iret or ud2; before an address in
+        `stop` (a function start, or an instruction already decoded), before
+        an int3 that is not an int 0x2d's slide byte, at undecodable bytes,
+        at the end of the section and after `budget` instructions."""
+        limit = self._code_limit(va)
+        out = []
+        if limit is None:
+            return out
+        pos = va
+        previous = None
+        while pos < limit and len(out) < budget:
+            offset = va_to_file_offset(pos)
+            if offset is None:
+                break
+            chunk = self.xbe_data[offset:offset + min(0x400, limit - pos)]
+            progressed = False
+            for cs_insn in self.disasm._cs.disasm(chunk, pos):
+                if cs_insn.address != va and cs_insn.address in stop:
+                    return out
+                insn = self.disasm._decode_instruction(cs_insn)
+                if insn.mnemonic == "int3" and not (
+                        previous is not None and previous.mnemonic == "int"
+                        and previous.operands
+                        and previous.operands[0].type == "imm"
+                        and previous.operands[0].imm == 0x2D):
+                    return out
+                out.append(insn)
+                previous = insn
+                pos = insn.end_address
+                progressed = True
+                if insn.mnemonic in self._LEAVES or len(out) >= budget:
+                    return out
+            if not progressed:
+                break
+        return out
+
+    # Detection methods that mark where a function really begins. The others
+    # (an immediate, a data word, a jump or a seed that landed somewhere) can
+    # sit inside a body, so they do not bound the switch a body dispatches.
+    REGION_STARTS = frozenset((
+        None, "entry_point", "call_target", "prologue", "prologue_alt",
+        "gap_prologue", "cc_boundary", "indirect_call_slot",
+        "external_coalescence"))
+
+    def _switch_region(self, va):
+        """[lower, upper): the function body va belongs to, for bounding a
+        switch's arms, from the function starts with structural evidence
+        around it (REGION_STARTS) and the code section's bytes."""
+        strong = getattr(self, "_region_starts", None)
+        if strong is None or self._region_count != len(self.func_db):
+            strong = self._region_starts = sorted(
+                start for start, info in self.func_db.items()
+                if info.get("detection_method") in self.REGION_STARTS)
+            self._region_count = len(self.func_db)
+        section = next((sec for sec in _config._SECTIONS
+                        if sec.is_code and sec.va <= va
+                        < sec.va + min(sec.va_size, sec.raw_size)), None)
+        if section is None:
+            return None
+        lower = section.va
+        upper = section.va + min(section.va_size, section.raw_size)
+        index = bisect.bisect_right(strong, va)
+        if index:
+            lower = max(lower, strong[index - 1])
+        if index < len(strong):
+            upper = min(upper, strong[index])
+        return lower, upper
+
+    def _table_arms(self, insn):
+        """The arms of `jmp [index*4 + table]`, read with bounds, or None.
+
+        The arms must lie in the body the jump belongs to (_switch_region),
+        before the table when the table follows the jump inside it (where
+        MSVC puts it); read as the contiguous run of such pointers around
+        the table address, as a recovered CFG reads them."""
+        if (insn.mnemonic != "jmp" or insn.jump_target is not None
+                or not insn.operands or insn.operands[0].type != "mem"):
+            return None
+        operand = insn.operands[0]
+        if (operand.mem_seg == "fs" or operand.mem_base or not operand.mem_index
+                or operand.mem_scale != 4 or not operand.mem_disp):
+            return None
+        table = operand.mem_disp & 0xFFFFFFFF
+        region = self._switch_region(insn.address)
+        if region is None or va_to_file_offset(table) is None:
+            return None
+        lower, upper = region
+        if insn.address < table < upper:
+            upper = table
+        # A table right after its jump must not take the jump's own
+        # displacement for an arm when it scans backward.
+        arms = self._read_local_jump_table(
+            table, lower, upper,
+            min_entry_va=insn.end_address if insn.address < table else None)
+        return (table, arms) if arms else None
+
+    def _absorb(self, start, base, leaders, edges):
+        """The code `base` reaches outside itself; see the comment above.
+
+        base: the function's own instructions; leaders: addresses inside it
+        that are entered other than by fall-through or a direct jump (switch
+        arms, immediates it jumps through); edges: computed jump edges.
+        Returns (instructions, tables, calls): the decoded instructions
+        outside base, the switch tables (VA -> arms) whose arms were followed
+        out of base, and the direct call targets of reachable code."""
+        entries = self._entry_set()
+        have = {insn.address: insn for insn in base}
+        absorbed = {}
+        tables = {}
+        calls = set()
+        # A switch the function's recovered CFG already validated (or
+        # deliberately did not) is not read again.
+        census = (self.lifter.jump_table_targets
