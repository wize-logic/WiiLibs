     # range. The real reach is the rest of one function; the cap only stops a
     # jump decoded from data from lifting a section's worth of garbage.
@@ -1512,9 +1516,83 @@ class FunctionTranslator:
                 work.append(following)
         return ([absorbed[addr] for addr in sorted(absorbed)], tables, calls)
 
+    def discover_interior_entries(self):
+        """Give every address reachable code calls a function to call.
+
+        A call to an address inside lifted code that no function starts at
+        (an alternate entry into a body, a helper the disassembler kept
+        inside its caller) had only a stub that popped the return address and
+        returned. The address gets a function of its own: its straight-line
+        code from there, plus whatever that code reaches (_absorb), exactly
+        what the x86 runs when called there. A weak start a CFG owner took is
+        made a function again when something calls it.
+
+        Run last: it fixes the set of functions, then works out and caches
+        what each one reaches outside its range. Returns the new entries."""
+        self._entries = None
+        self._absorb_cache = None
+        entries = self._entry_set()
+        self._entries = entries
+        self._absorb_cache = {}
+        created = set()
+        pending = sorted(entries)
+        while pending:
+            wanted = {}
+            for start in pending:
+                info = self.func_db[start]
+                end = info.get("end", start)
+                if end <= start and start not in self._recovered_cfg:
+                    continue
+                self.decode_function(start, end)
+                _, _, calls = self._absorb_cache.get(start, ((), {}, set()))
+                for target in calls:
+                    if (target in entries or target in created
+                            or self._code_limit(target) is None
+                            or self._is_padding_at(target)):
+                        continue
+                    wanted.setdefault(target, set()).add(start)
+            pending = []
+            for target, callers in sorted(wanted.items()):
+                stream = self._decode_stream(target, entries, 0x10000)
+                if not stream:
+                    continue
+                info = self.func_db.get(target)
+                if info is None:
+                    section = next((sec.name for sec in _config._SECTIONS
+                                    if sec.va <= target < sec.va + sec.va_size),
+                                   "")
+                    info = self.func_db[target] = {
+                        "_addr": target,
+                        "start": f"0x{target:08X}",
+                        "name": self.label_db.get(target, f"sub_{target:08X}"),
+                        "section": section,
+                        "confidence": 0.9,
+                        "detection_method": "interior_entry",
+                        "has_prologue": self._func_has_prologue(stream),
+                        "calls_to": [],
+                    }
+                else:
+                    self.owned_function_starts.discard(target)
+                end = max(insn.end_address for insn in stream)
+                if (target not in self._recovered_cfg
+                        and info.get("end", target) <= target):
+                    info["end"] = end
+                    info["size"] = end - target
+                    info["num_instructions"] = len(stream)
+                info["called_by"] = sorted(
+                    set(info.get("called_by") or [])
+                    | {f"0x{caller:08X}" for caller in callers})
+                created.add(target)
+                pending.append(target)
+        self.interior_entry_starts = created
+        if created:
+            print(f"Gave {len(created)} called addresses inside lifted code "
+                  f"a function of their own", file=sys.stderr)
+        return created
+
     def _absorbed_for(self, start, base, leaders, edges):
         """(instructions, tables) _absorb finds for this function, cached
-        when a pass has fixed the set of functions (self._absorb_cache)."""
+        once discover_interior_entries has fixed the set of functions."""
         cache = getattr(self, "_absorb_cache", None)
         if cache is not None and start in cache:
             return cache[start][:2]
@@ -3143,6 +3221,7 @@ class BatchTranslator:
             self.translator.discover_static_indirect_targets()
         self.translator.discover_cfg_ownership()
         self.translator.discover_jump_table_entries()
+        self.translator.discover_interior_entries()
 
