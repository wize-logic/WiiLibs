+def test_a_loop_that_moves_ebp_makes_its_stores_unknown():
+    lines = ["void f(void)", "{", "    uint32_t ebp = 0;", "    PUSH32(esp, ebx);",
+             "    ebp = esp;", "    while (eax) { ebp = ebp - 4; MEM32(ebp + 4) = 0; eax--; }",
+             "    POP32(esp, ebx);", "    esp += 4; return;", "}"]
+    s = preserve.analyse({"f": lines})["f"]
+    assert s.wild and "ebx" not in s.preserved
+
+
+def test_the_seh_frame_bridge_is_followed():
+    # a frameless function reading its frame from g_seh_ebp, and storing at -4 from it
+    lines = ["void f(void)", "{", "    uint32_t ebp = 0;", "    ebp = g_seh_ebp;",
+             "    MEM32(ebp - 4) = eax;", "    esp += 4; return;", "}"]
+    s = preserve.analyse({"f": lines})["f"]
+    assert s.isw == {-4} and not s.iw and not s.wild and s.delta == 4
