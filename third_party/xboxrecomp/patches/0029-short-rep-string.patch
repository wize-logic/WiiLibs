diff --git a/tools/recomp/test_rep_compare_short.py b/tools/recomp/test_rep_compare_short.py
new file mode 100644
index 0000000..b63c6b9
--- /dev/null
+++ b/tools/recomp/test_rep_compare_short.py
@@ -0,0 +1,79 @@
+"""repe/repne cmps and scas after `mov ecx, n` (n = 1..4): the unrolled forward compare gives what
+the element loop gives -- ZF, CF, esi, edi and ecx -- for a mismatch at every position and none,
+both directions, at every element width, with and without CF, and reads each element once.
+"""
+from tools.recomp.lifter import Lifter
+from tools.recomp.disasm import Instruction
+from tools.recomp.test_rep_movs_mmio import _build_and_run
+
+_OPS = ["repe cmpsb", "repe cmpsw", "repe cmpsd", "repne cmpsb", "repne cmpsd",
+        "repe scasb", "repne scasb", "repe scasd", "repne scasw"]
+
+
+def _lift(m, hint, cf):
+    lifter = Lifter()
+    lifter.needs_cf = cf
+    lifter.rep_count = hint
+    return "".join(lifter.lift_instruction(Instruction(0, 2, m, "", "")))
+
+
+def test_unrolled_compare_matches_the_loop():
+    prelude = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+uint32_t eax,esi,edi,ecx;
+int g_df, _flags, _cf;
+unsigned accesses;
+uint8_t mem[65536];
+void* touch(uint32_t a){accesses++;return mem+(a&0xffffu);}
+#define MEM8(a) (*(volatile uint8_t*)touch(a))
+#define MEM16(a) (*(volatile uint16_t*)touch(a))
+#define MEM32(a) (*(volatile uint32_t*)touch(a))
+#define LO8(x) ((uint8_t)(x))
+#define LO16(x) ((uint16_t)(x))
+#define RECOMP_DF_STEP(s) (g_df?-(s):(s))
+typedef void (*fn)(void);
+'''
+    funcs, table = [], []
+    for k, m in enumerate(_OPS):
+        for cf in (0, 1):
+            for n in range(1, 5):
+                for form, hint in (("u", ("exact", n)), ("l", None)):
+                    funcs.append(f"void f{k}_{cf}_{n}_{form}(void){{{_lift(m, hint, bool(cf))}}}")
+                table.append(f'{{f{k}_{cf}_{n}_u,f{k}_{cf}_{n}_l,"{m}",{cf},{n}}}')
+    main = r'''
+struct { fn u, l; const char *name; int cf; unsigned n; } cases[] = {''' + ",".join(table) + r'''};
+int main(void){
+    for(unsigned c=0;c<sizeof cases/sizeof cases[0];c++) for(int df=0;df<2;df++)
+    for(unsigned miss=0;miss<=cases[c].n;miss++) for(unsigned lower=0;lower<2;lower++){
+        uint32_t r[2][6]; unsigned acc[2];
+        for(int v=0;v<2;v++){
+            for(unsigned i=0;i<sizeof mem;i++)mem[i]=(uint8_t)(i>=0x800?i-0x800:i)*7;
+            /* elements of the second range equal the first's but the one at index miss */
+            uint32_t s=df?0x40C:0x400, d=s+0x800, z=4;
+            if(miss<cases[c].n){uint32_t at=d+(df?-(int)(miss*z):(int)(miss*z));
+                for(unsigned b=0;b<4;b++) mem[(at+b)&0xffff]+=lower?1:-1;}
+            eax=*(uint32_t*)(mem+0x400+(df?0x0C:0)); /* scas: the first element */
+            esi=s;edi=d;ecx=cases[c].n;g_df=df;_flags=7;_cf=7;accesses=0;
+            (v?cases[c].l:cases[c].u)();
+            r[v][0]=esi;r[v][1]=edi;r[v][2]=ecx;r[v][3]=_flags;r[v][4]=cases[c].cf?_cf:0;r[v][5]=eax;acc[v]=accesses;
+        }
+        if(memcmp(r[0],r[1],sizeof r[0]) || acc[0]>acc[1]){
+            printf("%s cf %d n %u df %d miss %u: esi %x/%x edi %x/%x ecx %u/%u zf %u/%u cf %u/%u acc %u/%u\n",
+                cases[c].name,cases[c].cf,cases[c].n,df,miss,r[0][0],r[1][0],r[0][1],r[1][1],r[0][2],r[1][2],
+                r[0][3],r[1][3],r[0][4],r[1][4],acc[0],acc[1]);
+            return 1;
+        }
+    }
+    return 0;
+}
+'''
+    ran = _build_and_run(prelude + "\n".join(funcs) + main)
+    assert ran.returncode == 0, ran.stdout + ran.stderr
+
+
+def test_with_cf_each_element_is_read_once():
+    text = _lift("repe cmpsd", None, True)
+    assert text.count("MEM32(esi)") == 1 and text.count("MEM32(edi)") == 1, text
+    assert "/* repe cmpsd: ecx = 4 */" in _lift("repe cmpsd", ("exact", 4), False)
