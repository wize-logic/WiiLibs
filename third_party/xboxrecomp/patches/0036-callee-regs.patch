diff --git a/tools/recomp/test_touched.py b/tools/recomp/test_touched.py
new file mode 100644
index 0000000..f5cf7d4
--- /dev/null
+++ b/tools/recomp/test_touched.py
@@ -0,0 +1,96 @@
+"""
+--callee-regs: around a direct call, only the registers the callee may touch
+go to memory and back (touched.py, x87_locals.py).
+"""
+
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from tools.recomp import touched  # noqa: E402
+from tools.recomp.translator import FP_STACK_MACROS, FP_STACK_UNDEFS  # noqa: E402
+from tools.recomp.x87_locals import localise_x87  # noqa: E402
+
+
+def _fn(name, body):
+    return ["void %s(void)" % name, "{"] + body + ["}", ""]
+
+
+def test_a_function_touches_what_it_and_its_callees_name():
+    funcs = {
+        "sub_00001000": _fn("sub_00001000", ["    eax = MEM32(ecx + 4); /* mov eax, [ebx] */",
+                                             "    PUSH32(esp, 0x00001008u); RECOMP_ABI_CALL(0x00002000u, sub_00002000);",
+                                             "    return;"]),
+        "sub_00002000": _fn("sub_00002000", ["    edx = memcpy(0, 0, 0) ? 1 : 0;", "    return;"]),
+        "sub_00003000": _fn("sub_00003000", ["    RECOMP_ICALL_SAFE_AT(0x3004u, eax);", "    return;"]),
+        "sub_00004000": _fn("sub_00004000", ["    PUSH32(esp, 0x00004008u); RECOMP_ABI_CALL(0x00003000u, sub_00003000);",
+                                             "    return;"]),
+        "sub_00005000": _fn("sub_00005000", ["    sub_00009000();", "    return;"]),  # not generated
+        "sub_00006000": _fn("sub_00006000", FP_STACK_MACROS + ["    fp_push(1.0);", "    fp_pop();", "    return;"]
+                            + FP_STACK_UNDEFS),
+        "sub_00007000": _fn("sub_00007000", ["    eax = RECOMP_FP_PC(eax);", "    return;"]),
+    }
+    t = touched.analyse(funcs)
+    # the comment's ebx is not a use; the callee's edx is
+    assert t["sub_00001000"] == {"g_eax", "g_ecx", "g_esp", "g_edx"}, t
+    assert t["sub_00002000"] == {"g_edx"}, t
+    # an indirect call, a caller of one, a call to code that is not generated: anything
+    assert "sub_00003000" not in t and "sub_00004000" not in t and "sub_00005000" not in t, t
+    assert touched.X87 in t["sub_00006000"], t
+    assert t["sub_00007000"] == {"g_eax", "g_fp_control_word"}, t
+
+
+def test_recursion_settles():
+    funcs = {
+        "sub_00001000": _fn("sub_00001000", ["    eax = 1;",
+                                             "    PUSH32(esp, 0x00001008u); RECOMP_ABI_CALL(0x00002000u, sub_00002000);",
+                                             "    return;"]),
+        "sub_00002000": _fn("sub_00002000", ["    ecx = 2;",
+                                             "    PUSH32(esp, 0x00002008u); RECOMP_ABI_CALL(0x00001000u, sub_00001000);",
+                                             "    return;"]),
+    }
+    t = touched.analyse(funcs)
+    assert t["sub_00001000"] == t["sub_00002000"] == {"g_eax", "g_ecx", "g_esp"}, t
+
+
+_CALLER = ["    eax = MEM32(0x2000);", "    ebx = MEM32(0x2004);", "    ecx = eax + ebx;",
+           "    PUSH32(esp, 0x00001010u); RECOMP_ABI_CALL(0x00002000u, sub_00002000); /* call 0x00002000 */",
+           "    MEM32(0x2008) = ebx + ecx + eax;", "    return;"]
+
+
+def _around(out):
+    i = [k for k, line in enumerate(out) if "RECOMP_ABI_CALL" in line][0]
+    return out[i - 1], out[i + 1]
+
+
+def test_only_what_the_callee_touches_goes_to_memory_and_back():
+    out, why = localise_x87(_fn("f", _CALLER), FP_STACK_MACROS, FP_STACK_UNDEFS, x87=True, regs=True,
+                            touched={"sub_00002000": frozenset({"g_eax"})})
+    assert why is None, why
+    text = "\n".join(out)
+    line_before, line_after = _around(out)
+    assert "g_eax = _r_eax;" in line_before and "g_ebx" not in line_before and "g_ecx" not in line_before, text
+    assert "_r_eax = g_eax;" in line_after and "g_ebx" not in line_after and "g_ecx" not in line_after, text
+    assert "MEM32(0x2008) = _r_ebx + _r_ecx + _r_eax;" in text, text
+    # the rest is written back where the function returns
+    assert re.search(r"g_ebx = _r_ebx;[^\n]*\n\s*return;", text), text
+
+
+def test_a_callee_that_may_touch_anything_or_the_x87_stack_syncs_everything():
+    for t in ({}, {"sub_00002000": frozenset({"g_eax", touched.X87})}):
+        out, why = localise_x87(_fn("f", _CALLER), FP_STACK_MACROS, FP_STACK_UNDEFS, x87=True, regs=True,
+                                touched=t)
+        assert why is None, why
+        text = "\n".join(out)
+        line_before, line_after = _around(out)
+        assert all("g_%s = _r_%s;" % (r, r) in line_before for r in ("eax", "ebx", "ecx")), text
+        assert "state to memory" in line_before and line_after.strip() == "_LOCALS_LOAD();", text
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_"):
+            fn()
+    print("ok")
diff --git a/tools/recomp/touched.py b/tools/recomp/touched.py
new file mode 100644
index 0000000..13860bc
--- /dev/null
+++ b/tools/recomp/touched.py
@@ -0,0 +1,117 @@
+"""
+Which guest registers a generated function may read or write, with all it calls.
+
+With --reg-locals a function keeps the guest registers in C locals and, before
+a call, writes back every one it changed; after the call it loads again every
+one it uses, since the callee may read or change any of them. A callee that
+never names a register, and calls nothing that does, neither reads nor writes
+its global: the caller's local stays the truth across the call, with no store
+before it and no load after.
+
+This pass finds, for each generated function, the register globals (g_eax ..
+g_edi, g_esp, g_xmm0.., g_mm0.., the x87 control word, compare result and
+condition codes) its body names, and whether it names the x87 stack, joined
+over every function it calls by name. It reads the C text translate_function
+produces. A function is unknown (it may touch everything) when it calls
+anything that is not a generated function by name: an indirect call, a call
+by address (RECOMP_ITAIL), a hand-written function, port I/O, a trace hook, a
+runtime service that may run guest code, an unimplemented instruction. The
+header's helpers that take their operands by value (the SIMD helpers, the
+memory accessors, fist, the libm functions) touch no register. A safe point
+(RECOMP_BACKEDGE) may run other guest code, which leaves the registers of the
+code it interrupts as they were (wl_xb_call_guest_preserving).
+"""
+
+import re
+
+X87 = "x87"  # the x87 stack (g_fp_top, g_fp_stack): a caller's x87 locals do not survive it
+
+_REG = re.compile(r"\b(?:g_)?(eax|ecx|edx|ebx|esp|esi|edi|xmm[0-7]|mm[0-7])\b")
+_X87_SCALAR = re.compile(r"\b(g_fp_control_word|g_fp_cmp|g_fp_cc)\b")
+_X87_STACK = re.compile(r"\b(g_fp_top|g_fp_stack|fp_push|fp_pop|fp_top|fp_st|fp_st1)\b")
+_FP_PC = re.compile(r"\bRECOMP_FP_PC\s*\(")  # reads g_fp_control_word
+_FUNC = re.compile(r"\b(sub_[0-9A-Fa-f]{8}\w*)\b")
+_CALLISH = re.compile(r"(?<![\w.])([A-Za-z_]\w*)\s*\(")
+_COMMENT = re.compile(r"/\*.*?\*/", re.S)
+_STRING = re.compile(r'"(?:[^"\\\n]|\\.)*"')
+
+# Names in generated code that only compute from their operands and guest memory.
+_PURE = frozenset("""
+    if for while switch return sizeof fp_push fp_pop fp_top fp_st fp_st1
+    MEM8 MEM16 MEM32 MEM64 SMEM8 SMEM16 SMEM32 SMEM64 MEMF MEMD MEMF_SET MEMD_SET XBOX_PTR
+    LO8 HI8 LO16 SET_LO8 SET_HI8 SET_LO16 SX8 SX16 ZX8 ZX16 PUSH32 POP32
+    CMP_EQ CMP_NE CMP_L CMP_LE CMP_G CMP_GE CMP_B CMP_BE CMP_A CMP_AE TEST_Z TEST_NZ TEST_S
+    RECOMP_PARITY8 RECOMP_DF_STEP RECOMP_FCMP RECOMP_FCMP_CC RECOMP_FP_PC RECOMP_FP_PC_CW RECOMP_BACKEDGE
+    RECOMP_ATOMIC_CAS32 RECOMP_ATOMIC_ADD32 ROL8 ROL16 ROL32 ROR8 ROR16 ROR32 RC_ROT
+    RECOMP_ABI_CALL
+    memcpy memset memmove fabs fabsf sqrt sqrtf sin cos tan atan atan2 log log2 log10 exp exp2
+    floor ceil fmod ldexp frexp trunc round rint nearbyint
+    recomp_fist recomp_frndint recomp_ld80 recomp_st80 recomp_fxam recomp_fprem_cc recomp_cvt_si32
+""".split())
+_PURE_PREFIX = ("XMM_", "MMX_")
+
+
+def _strip(text):
+    return _STRING.sub('""', _COMMENT.sub(" ", text))
+
+
+def _of(text, names):
+    """(the registers the text names, the generated functions it calls, unknown)"""
+    regs = set(m.group(1) and "g_" + m.group(1) for m in _REG.finditer(text))
+    regs |= set(_X87_SCALAR.findall(text))
+    if _FP_PC.search(text):
+        regs.add("g_fp_control_word")
+    if _X87_STACK.search(text):
+        regs.add(X87)
+    calls, unknown = set(), False
+    for m in _FUNC.finditer(text):  # a call, or its address passed on
+        if m.group(1) in names:
+            calls.add(m.group(1))
+        else:
+            unknown = True
+    for m in _CALLISH.finditer(text):
+        name = m.group(1)
+        if name in names:
+            calls.add(name)
+        elif not (name in _PURE or name.startswith(_PURE_PREFIX)
+                  or re.fullmatch(r"(S?MEM(8|16|32|64|F|D)|MEM[FD]_SET)_(D|SP)", name)):
+            unknown = True
+    return regs, calls, unknown
+
+
+def analyse(functions):
+    """functions: {C name: lines of the function as translate_function makes
+    them}. Returns {C name: frozenset of the register globals (and X87) it and
+    its callees may touch} for the functions whose callees are all known; the
+    others are left out (they may touch everything)."""
+    names = set(functions)
+    own, calls, unknown = {}, {}, set()
+    for name, lines in functions.items():
+        text = _strip("\n".join(lines))
+        r, c, u = _of(text, names)
+        own[name], calls[name] = r, c - {name}
+        if u:
+            unknown.add(name)
+    # unknown spreads to callers; the rest is a union over callees to a fixpoint
+    callers = {}
+    for n, cs in calls.items():
+        for c in cs:
+            callers.setdefault(c, set()).add(n)
+    work = list(unknown)
+    while work:
+        n = work.pop()
+        for c in callers.get(n, ()):
+            if c not in unknown:
+                unknown.add(c)
+                work.append(c)
+    touch = {n: set(own[n]) for n in names if n not in unknown}
+    changed = True
+    while changed:
+        changed = False
+        for n, t in touch.items():
+            before = len(t)
+            for c in calls[n]:
+                t |= touch[c]
+            if len(t) != before:
+                changed = True
+    return {n: frozenset(t) for n, t in touch.items()}
